// VERSIONINFO for treadlehost.dll. The host has its own version, independent of the editor's:
// 1.0.0.0 was the first Treadle host build; 1.1.0.0 adds the quiet window (th_set_window_quiet, th_window_quiet)
// and, before any release, the Treadle names (th_ prefix, treadlehost) and the window icon (SDL_SetWindowIcon; the DLL's
// icon resource below).
// The C interface is host contract 1 (FORK-NOTES.md,
// "Native host"). Bump the version here when the host changes. The company and copyright come from
// the generated treadleversion.h (Native\build_windows.ps1 writes it from NOTICE).
#include "treadleversion.h"

#define TH_HOST_VERSION      1,1,0,0
#define TH_HOST_VERSION_STR  "1.1.0.0"

// The Treadle icon (packaging/treadle-icon/Treadle.ico; build_windows.ps1 passes that folder with -I).
1 ICON "Treadle.ico"

1 VERSIONINFO
 FILEVERSION     TH_HOST_VERSION
 PRODUCTVERSION  TH_HOST_VERSION
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x2L
 FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "Comments",         "Host contract 1"
      VALUE "CompanyName",      TH_COMPANY
      VALUE "FileDescription",  "Treadle host (SDL2 + Dear ImGui)"
      VALUE "FileVersion",      TH_HOST_VERSION_STR
      VALUE "InternalName",     "treadlehost"
      VALUE "LegalCopyright",   TH_COPYRIGHT
      VALUE "OriginalFilename", "treadlehost.dll"
      VALUE "ProductName",      "Treadle host"
      VALUE "ProductVersion",   TH_HOST_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
