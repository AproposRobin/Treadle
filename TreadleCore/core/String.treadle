wire nh.Length ni.b
wire ni.result nj.a
wire ne.done nk.in
wire nb.object nk.receiver
wire na.a nk.text

function s001c FormatNext
	access private
	returns int
	doc "Appends `format` from `start` up to what comes next and gives it: a placeholder's argument number (its alignment in `width`, its spec in `spec`), -2 after {{ or }} (one brace appended), -1 at the end of the format. `next` is the position after it."
param format StringView
param start int
out next int
out width int
out spec StringView
local litEnd int64
local after int64
local align int64
local specStart int64
local specLength int64
sheet body
node x01 Entry
node x02 Break StringView
node x03 Get local:litEnd
node x04 Get local:after
node x05 Get local:align
node x06 Get local:specStart
node x07 Get local:specLength
node x08 Call C.crt.rt_format_scan
node x09 Get local:litEnd
node x10 Operator -
node x11 Call StringView.Substring
node x12 Call this.Append(StringView)
node x13 Get local:specStart
node x14 Get local:specLength
node x15 Call StringView.Substring
node x16 Get local:after
node x17 Get local:align
node x18 Return
wire x01.format x02.value
wire x01.then x08.in
wire x03.value x08.litEnd
wire x02.Length x08.n
wire x04.value x08.next
wire x02.Ptr x08.p
wire x01.start x08.pos
wire x07.value x08.specLen
wire x06.value x08.specStart
wire x05.value x08.width
wire x09.value x10.a
wire x01.start x10.b
wire x10.result x11.length
wire x01.format x11.receiver
wire x01.start x11.start
wire x08.then x12.in
wire x11.result x12.text
wire x14.value x15.length
wire x01.format x15.receiver
wire x13.value x15.start
wire x12.then x18.in
wire x16.value x18.next
wire x15.result x18.spec
wire x08.result x18.value
wire x17.value x18.width

