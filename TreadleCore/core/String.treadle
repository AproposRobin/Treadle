param into List<StringView>
param skipEmpty bool
	default false
sheet body
node la Entry
node lb Call this.View
node lc Call StringView.Split
node ld Return
wire la.then lc.in
wire la.into lc.into
wire lb.result lc.receiver
wire la.separator lc.separator
wire la.skipEmpty lc.skipEmpty
wire lc.then ld.in

