# treadle 1
type String class
	namespace Core
	implements IHashable
	sealed
	doc "A heap string of UTF-8 code units that can grow; it owns its buffer and keeps it zero-terminated. Read it through View() (or wire it where a StringView is taken); numbers, bools and characters become text through the Append overloads."

field mPtr char8*
	access private

field mLength int
	access private

field mCapacity int
	access private

field mInline char8[24]
	access private
	doc "The first buffer: a String of up to 23 code units keeps its text here (mPtr points at it) and needs no heap block."

ctor s0001
	doc "An empty String (no buffer until something is appended)."
sheet body
node a1 Entry
node a2 Return
wire a1.then a2.in

ctor s0002
	doc "A String holding a copy of the text."
param text StringView
sheet body
node n1 Entry
node n2 Call this.Append(StringView)
node n3 Return
wire n1.then n2.in
wire n1.text n2.text
wire n2.then n3.in

dtor s0003
	doc "Frees the buffer (a heap block; the inline buffer is part of the object)."
sheet body
node o1 Entry
node o2 Scope
	unsafe
node o3 Get this.mPtr
node o4 Call Memory.Resize
	in count 0
node o5 Return
node o6 This
node o7 Call String.InlineBuffer
node o8 Operator !=
node o9 Operator !=
	in b null
node p1 Operator &&
node p2 Branch
wire o1.then o2.in
wire p2.true o4.in
wire o3.value o4.ptr
wire o2.done o5.in
wire o6.value o7.s
wire o3.value o8.a
wire o7.result o8.b
wire o3.value o9.a
wire o8.result p1.a
wire o9.result p1.b
wire p1.result p2.condition
wire o2.body p2.in

function s0004 Reserve
	unsafe
	access private
	doc "Makes room for at least `need` code units (the terminating zero included). The first room is the inline buffer (24 code units, no heap block); past it the String moves to a heap block and grows it to twice its capacity (at least `need`) each time."
param need int
local cap int
local old char8*
local none char8*
sheet body
node b1 Entry
node b2 Get this.mCapacity
node b3 Operator <=
node b4 Branch
node b5 Return
node b6 Operator *
	in b 2
node b7 Call Math.Max
node b8 Call Math.Max
	in b 16
node b9 Set local:cap
node c1 Get local:cap
node c2 Get local:old
node c3 Call Memory.Resize
node c4 Set this.mPtr
node c5 Set this.mCapacity
node c6 Return
node c7 Get this.mPtr
node c8 Operator ==
	in b null
node c9 Operator <=
	in b 24
node rd1 Operator &&
node rd2 Branch
node rd3 This
node rd4 Call String.InlineBuffer
node rd5 Set this.mPtr
node rd6 Set this.mCapacity
	in value 24
node rd7 Call Pointer.Store
	in value 0
node rd8 Return
node rd9 Set local:old
node re1 Operator ==
node re2 Get local:none
node re3 Select
node re4 Branch
node re5 Call Memory.Copy
node re6 Get this.mPtr
node re7 Get this.mLength
node re8 Operator +
	in b 1
node re9 Return
wire b1.need b3.a
wire b2.value b3.b
wire b3.result b4.condition
wire b1.then b4.in
wire b4.true b5.in
wire b2.value b6.a
wire b6.result b7.a
wire b1.need b7.b
wire b7.result b8.a
wire rd9.then b9.in
wire b8.result b9.value
wire c1.value c3.count
wire b9.then c3.in
wire re3.result c3.ptr
wire c3.then c4.in
wire c3.result c4.value
wire c4.then c5.in
wire c1.value c5.value
wire re4.false c6.in
wire c7.value c8.a
wire b1.need c9.a
wire c8.result rd1.a
wire c9.result rd1.b
wire rd1.result rd2.condition
wire b4.false rd2.in
wire rd3.value rd4.s
wire rd2.true rd5.in
wire rd4.result rd5.value
wire rd5.then rd6.in
wire rd6.then rd7.in
wire rd4.result rd7.ptr
wire rd7.then rd8.in
wire rd2.false rd9.in
wire c7.value rd9.value
wire c2.value re1.a
wire rd4.result re1.b
wire re1.result re3.condition
wire c2.value re3.false
wire re2.value re3.true
wire re1.result re4.condition
wire c5.then re4.in
wire re6.value re5.dest
wire re4.true re5.in
wire re8.result re5.size
wire c2.value re5.src
wire re7.value re8.a
wire re5.then re9.in

function s0038 InlineBuffer
	static
	pure
	unsafe
	access private
	returns char8*
	attr Intrinsic String.InlineBuffer
	doc "The address of the String's inline buffer (mInline)."
param s String

function s0005 Append
	doc "Appends a copy of the text."
param text StringView
sheet body
node d0 Scope
	unsafe
node d1 Entry
node d2 Break StringView
node d3 Get this.mLength
node d4 Operator +
node d5 Operator +
	in b 1
node d6 Call this.Reserve
node d7 Get this.mPtr
node d8 Call Pointer.Add
node d9 Call Memory.Copy
node e1 Set this.mLength
	set op +=
node e2 Get this.mLength
node e3 Call Pointer.Add
node e4 Call Pointer.Store
	in value 0
node e5 Return
wire d1.then d0.in
