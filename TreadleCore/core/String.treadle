function s0034 Append
	doc "Appends the code point as UTF-8 (1 to 4 bytes); a surrogate or a value past U+10FFFF appends U+FFFD."
param value char32
sheet body
node ua01 Scope
	unsafe
node ua02 Entry
node ua03 Get this.mLength
node ua04 Get this.mPtr
node ua05 Operator +
	in b 5
node ua06 Call this.Reserve
node ua07 Cast int32
node ua08 Call Pointer.Add
node ua09 Call C.crt.rt_utf8_encode
node ua10 Set this.mLength
	set op +=
node ua11 Get this.mLength
node ua12 Call Pointer.Add
node ua13 Call Pointer.Store
	in value 0
node ua14 Return
wire ua02.then ua01.in
wire ua03.value ua05.a
