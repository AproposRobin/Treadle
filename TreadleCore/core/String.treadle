function s0021 AppendF
	generic A0
	doc "Appends `format` with {0} replaced by the argument ({{ and }} give a brace; a placeholder past the arguments appends nothing). A placeholder is {index[,width][:spec]}: a positive width right-aligns in that many characters, a negative one left-aligns; the spec formats a number (F2, E3, G, N0, D4, X8, B; Core-Library.md): {0,8:F2}. Arguments: numbers (any integer type, float, double), bool, char8, char32, String and StringView, each without a spec as its own Append writes it."
param format StringView
param arg0 A0
local pos int
local n int
sheet body
node ab01 Entry
node ab02 Get local:n
node ab03 Operator !=
	in b -1
node ab04 While
node ab05 Get local:pos
node ab06 Call this.FormatNext
node ab07 Set local:n
node ab08 Set local:pos
node ab09 Operator ==
	in b 0
node ab10 Branch
node ab11 Call this.AppendSlot
node ab12 Return
wire ab02.value ab03.a
wire ab03.result ab04.condition
wire ab01.then ab04.in
wire ab01.format ab06.format
wire ab04.body ab06.in
wire ab05.value ab06.start
wire ab06.then ab07.in
wire ab06.result ab07.value
wire ab07.then ab08.in
wire ab06.next ab08.value
wire ab02.value ab09.a
wire ab09.result ab10.condition
wire ab08.then ab10.in
wire ab10.true ab11.in
wire ab06.spec ab11.spec
wire ab01.arg0 ab11.value
wire ab06.width ab11.width
wire ab04.done ab12.in

