node na08 Break StringView
node na09 Call C.crt.rt_format_number
	in cap 512
	in kind 0
	in d 0.0
node na10 Set this.mLength
	set op +=
node na11 Return
node na12 Operator ==
	in b 0
node na13 Branch
node na14 Call this.Append(int)
node na15 Return
