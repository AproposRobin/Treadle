wire f0.body f4.in
wire f3.result f4.need
wire f2.value f6.count
wire f5.value f6.ptr
wire f6.result f7.buf
wire f4.then f7.in
wire f1.value f7.v
wire f7.then f9.in
wire f7.result f9.value
wire f0.done g1.in

function s0009 Append
	doc "Appends the number (up to 15 significant digits, no trailing zeros: 0.1, 2.5, 1e+20)."
param value double
sheet body
node w0 Scope
	unsafe
node w1 Entry
node w2 Get this.mLength
node w3 Operator +
	in b 32
node w4 Call this.Reserve
node w5 Get this.mPtr
node w6 Call Pointer.Add
node w7 Call C.crt.snprintf
	in count 32
	in format "%.15g"
node w8 Cast int
node w9 Set this.mLength
	set op +=
node x0 Return
wire w1.then w0.in
wire w2.value w3.a
wire w0.body w4.in
wire w3.result w4.need
wire w2.value w6.count
wire w5.value w6.ptr
wire w6.result w7.buffer
wire w4.then w7.in
wire w1.value w7.va0
wire w7.result w8.value
wire w7.then w9.in
wire w8.result w9.value
wire w0.done x0.in

