wire d3.value d4.a
wire d2.Length d4.b
wire d4.result d5.a
wire d0.body d6.in
wire d5.result d6.need
wire d3.value d8.count
wire d7.value d8.ptr
wire d8.result d9.dest
wire d6.then d9.in
wire d2.Length d9.size
wire d2.Ptr d9.src
wire d9.then e1.in
wire d2.Length e1.value
wire e2.value e3.count
wire d7.value e3.ptr
wire e1.then e4.in
wire e3.result e4.ptr
wire d0.done e5.in

