function y0005 Resize
	static
	unsafe
	returns T*
	generic T
	doc "A block of `count` elements with the contents of `ptr` (null: a new block): the C runtime's realloc. A count of 0 frees the block and gives null. The caller owns the block."
param ptr T*
param count int
