# treadle 1
type File class
	namespace Core
	static
	doc "Whole-file reads and writes through the C runtime (fopen, fread, fwrite, fclose). Paths are UTF-8 text, relative to the program's working folder unless absolute; both separators work. Text is bytes: no line-break conversion, no byte order mark handling."

function f0001 Exists
	static
	returns bool
	doc "True when a file (not a directory) is there."
param path StringView
sheet body
node a1 Entry
node a2 Local String
	set ctor (StringView)
node a3 Call String.CStr
node a4 Call C.crt.rt_file_exists
node a5 Operator !=
	in b 0
node a6 Return
wire a1.then a2.in
wire a1.path a2.text
wire a2.object a3.receiver
wire a2.then a4.in
wire a3.result a4.path
wire a4.result a5.a
wire a4.then a6.in
wire a5.result a6.value

function f0002 Delete
	static
	returns bool
	doc "Deletes the file; false when it could not be deleted (or was not there)."
param path StringView
sheet body
node b1 Entry
node b2 Local String
	set ctor (StringView)
node b3 Call String.CStr
node b4 Call C.crt.rt_remove
node b5 Operator ==
	in b 0
node b6 Return
wire b1.then b2.in
wire b1.path b2.text
wire b2.object b3.receiver
wire b2.then b4.in
wire b3.result b4.path
wire b4.result b5.a
wire b4.then b6.in
wire b5.result b6.value

