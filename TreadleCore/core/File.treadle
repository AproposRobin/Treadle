node e1 Operator >
	in b 0
node e2 While
node e3 Make StringView
node e4 Call String.Append(StringView)
node e5 Call C.crt.fread
	in size 1
	in count 4096
node e6 Cast int
node e7 Set local:n
node e8 Call Memory.Resize
	in count 0
node e9 Call C.crt.fclose
node f1 Return
	in value true
node zz1 Return
	in value false
wire c1.then c2.in
wire c1.path c2.text
wire c2.then c3.in
wire c2.object c4.receiver
wire c3.body c5.in
wire c4.result c5.path
wire c5.then c6.in
wire c5.result c6.value
wire c7.value c8.a
wire c8.result c9.condition
wire c6.then c9.in
wire c9.true d1.in
wire c9.false d3.in
wire d2.value d3.ptr
wire d3.then d4.in
wire d3.result d4.value
wire d5.value d6.buffer
wire d4.then d6.in
wire c7.value d6.stream
wire d6.result d7.value
wire d6.then d8.in
wire d7.result d8.value
wire d9.value e1.a
wire e1.result e2.condition
wire d8.then e2.in
wire d9.value e3.Length
wire d5.value e3.Ptr
wire e2.body e4.in
