function t004 Inverse
	pure
	returns Transform
	doc "The transform that undoes this one (exact for a uniform scale; a non-uniform scale with a rotation loses its shear). A zero scale component stays zero."
sheet body
node n00400 Entry
node n00401 This
node n00402 Break Core.Transform
node n00403 Math
	set expr "s.X != 0.0f ? 1.0f / s.X : 0.0f"
node n00404 Math
	set expr "s.Y != 0.0f ? 1.0f / s.Y : 0.0f"
node n00405 Math
	set expr "s.Z != 0.0f ? 1.0f / s.Z : 0.0f"
node n00406 Make Vec3
node n00407 Call Core.Quat.Inverse
node n00408 Operator *
node n00409 Call Core.Quat.Rotate
node n0040a Operator neg
node n0040b Make Transform
node n0040c Return
wire n00401.value n00402.value
wire n00402.Scale n00403.s
wire n00402.Scale n00404.s
wire n00402.Scale n00405.s
wire n00403.result n00406.X
wire n00404.result n00406.Y
wire n00405.result n00406.Z
wire n00402.Rotation n00407.receiver
wire n00406.value n00408.a
wire n00402.Translation n00408.b
wire n00407.result n00409.receiver
wire n00408.result n00409.v
wire n00409.result n0040a.a
wire n00407.result n0040b.Rotation
wire n00406.value n0040b.Scale
wire n0040a.result n0040b.Translation
wire n00400.then n0040c.in
wire n0040b.value n0040c.value

