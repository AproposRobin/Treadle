# treadle 1
type Transform struct
	namespace Core
	attr CRepr
	doc "A position, rotation and scale (40 bytes): scale first, then rotate, then move. parent * child places a child in its parent's space. Every function is Pure."

field Translation Vec3

field Rotation Quat

field Scale Vec3

property t000 Identity Transform
	static
	doc "No move, no rotation, scale 1."
sheet get
node n00000 Entry
node n00001 Get Core.Vec3.Zero
node n00002 Get Core.Quat.Identity
node n00003 Get Core.Vec3.One
node n00004 Make Transform
node n00005 Return
wire n00002.value n00004.Rotation
wire n00003.value n00004.Scale
wire n00001.value n00004.Translation
wire n00000.then n00005.in
wire n00004.value n00005.value

function t001 ToMat4
	pure
	returns Mat4
	doc "The same transform as a matrix (Translation * Rotation * Scale)."
sheet body
node n00100 Entry
node n00101 This
node n00102 Break Core.Transform
node n00103 Call Core.Mat4.FromTRS
node n00104 Return
wire n00101.value n00102.value
wire n00102.Rotation n00103.rotation
wire n00102.Scale n00103.scale
wire n00102.Translation n00103.translation
wire n00100.then n00104.in
wire n00103.result n00104.value

