function t008 ApproxEquals
	pure
	returns bool
	doc "True when translation, rotation (q and -q alike) and scale are each within `epsilon` (absolute)."
param other Transform
param epsilon float
	default 0.00001f
sheet body
node n00800 Entry
node n00801 This
