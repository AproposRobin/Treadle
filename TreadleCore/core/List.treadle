node y1 Entry
node y2 Get this.mCount
node y3 Operator /
	in b 2
node y4 For
	in start 0
node y5 Get this.mItems
node y6 Operator -
node y7 Operator -
	in b 1
node y8 Index
node y9 Index
node z0 Set local:tmp
node z1 Call Arrays.Set
node z2 Call Arrays.Set
node z3 Return
node z4 Get local:tmp
wire y2.value y3.a
wire y3.result y4.count
wire y1.then y4.in
wire y2.value y6.a
wire y4.index y6.b
wire y6.result y7.a
wire y5.value y8.collection
wire y4.index y8.index
wire y5.value y9.collection
wire y7.result y9.index
wire y4.body z0.in
wire y8.value z0.value
wire y5.value z1.array
wire z0.then z1.in
wire y4.index z1.index
wire y9.value z1.value
wire y5.value z2.array
wire z1.then z2.in
wire y7.result z2.index
wire z4.value z2.value
wire y4.done z3.in

function l0012 Remove
	returns bool
	doc "Removes the first element equal to `value` (Hash.Equal), as RemoveAt does; false when there is none."
param value T
sheet body
node a7 Return
	in value true
node ac Entry
node ad Call this.IndexOf
node ae Operator <
	in b 0
node af Branch
node ag Return
	in value false
node ah Call this.RemoveAt
wire ah.then a7.in
wire ac.value ad.value
wire ad.result ae.a
wire ae.result af.condition
wire ac.then af.in
wire af.true ag.in
wire af.false ah.in
wire ad.result ah.index

function l0013 AddRange
	doc "Adds the elements of `other` at the end, in order (`other` may be this list). The elements are copied bit for bit: for a struct that has a destructor both lists would destroy them, so move such elements one by one."
param other List<T>
sheet body
node ai Entry
node aj Get List<T>.Count
node ak For
	in start 0
node al Index
node am Call this.Add
node an Return
wire ai.other aj.receiver
wire aj.value ak.count
wire ai.then ak.in
wire ai.other al.collection
wire ak.index al.index
wire ak.body am.in
wire al.value am.value
wire ak.done an.in

function l0014 FindIndex
	returns int
	doc "The position of the first element `match` returns true for, or -1."
param match delegate:bool(T)
sheet body
node a8 Return
node a9 Return
	in value -1
node ao Entry
node ap Get this.mCount
node aq For
	in start 0
node ar Get this.mItems
node as Index
node at Invoke
node au Branch
wire au.true a8.in
wire aq.index a8.value
wire aq.done a9.in
wire ap.value aq.count
wire ao.then aq.in
wire ar.value as.collection
wire aq.index as.index
wire as.value at.arg0
wire ao.match at.delegate
wire aq.body at.in
wire at.result au.condition
wire at.then au.in

function l0015 Find
	returns bool
	doc "True with the first element `match` returns true for in `item` (a copy the list still owns); false (item is default) when there is none."
param match delegate:bool(T)
out item T
sheet body
node a0 Get this.mItems
node av Entry
node aw Call this.FindIndex
node ax Operator <
	in b 0
node ay Branch
node az Return
	in value false
	in item default
node ba Index
node bb Return
	in value true
wire av.then aw.in
wire av.match aw.match
wire aw.result ax.a
wire ax.result ay.condition
wire aw.then ay.in
wire ay.true az.in
wire a0.value ba.collection
wire aw.result ba.index
wire ay.false bb.in
wire ba.value bb.item

