wire c12.true c14.in
wire c13.value c14.value
wire c15.value c16.array
wire c01.length c16.length
wire c01.start c16.start
wire c12.false c18.in
wire c16.result c18.value

function l0018 StorageSpan
	static
	pure
	access private
	returns Span<T>
	attr Intrinsic Arrays.Slice
	doc "A Span over `length` elements of `array` from `start` (the back end's array.span; null and the range are checked in Debug)."
param array T[]
param start int
param length int

function l0019 Sort
	generic T operator<
	doc "Sorts the elements in ascending order with T's operator < (numbers, characters, a type with an operator <): the same sort as Sort(comparer) with no delegate call per comparison."
sheet body
node t1 Entry
node t2 Call Sorting.Sort
node t3 Call this.Slice
	in start 0
node t4 Get this.mCount
node t5 Return
wire t1.then t2.in
wire t3.result t2.items
wire t4.value t3.length
wire t2.then t5.in
