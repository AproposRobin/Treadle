function l0017 Slice
	pure
	returns Span<T>
	doc "A Span over `length` elements from `start` (no copy: valid until the list grows, shrinks or is deleted). A range outside [0, Count) is a fatal error."
param start int
param length int
sheet body
node c01 Entry
node c02 Operator <
	in b 0
node c03 Operator <
	in b 0
node c04 Operator ||
node c05 Operator +
node c06 Get this.mCount
node c07 Operator >
node c08 Operator ||
node c09 Branch
node c10 Fatal
	in message "List.Slice: the range is out of range"
node c11 Operator ==
	in b 0
node c12 Branch
node c13 Make Span<T>
node c14 Return
node c15 Get this.mItems
node c16 Call List<T>.StorageSpan
node c18 Return
