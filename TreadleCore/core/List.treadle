wire c01.length c03.a
wire c02.result c04.a
wire c03.result c04.b
wire c01.start c05.a
wire c01.length c05.b
wire c05.result c07.a
wire c06.value c07.b
wire c04.result c08.a
wire c07.result c08.b
wire c08.result c09.condition
wire c01.then c09.in
wire c09.true c10.in
wire c01.length c11.a
wire c11.result c12.condition
