# treadle 1
type Vec4d struct
	namespace Core
	attr CRepr
	doc "A 4D vector of doubles (X, Y, Z, W; 32 bytes, laid out as in C): a position, a direction, a size. Every function is Pure."

field X double

field Y double

field Z double

field W double

property v000 Zero Vec4d
	static
	doc "All components 0."
sheet get
node n00000 Entry
node n00001 Make Vec4d
	in X 0.0
	in Y 0.0
	in Z 0.0
	in W 0.0
node n00002 Return
wire n00000.then n00002.in
wire n00001.value n00002.value

