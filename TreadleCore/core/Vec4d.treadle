node n01000 Entry
node n01001 This
node n01002 Math
	set expr "Abs(v.X - o.X) <= e && Abs(v.Y - o.Y) <= e && Abs(v.Z - o.Z) <= e && Abs(v.W - o.W) <= e"
node n01003 Return
wire n01000.epsilon n01002.e
wire n01000.other n01002.o
wire n01001.value n01002.v
wire n01000.then n01003.in
