function v00y AngleTo
	pure
	returns double
	doc "The angle to `b` in radians, 0 to PI; 0 when either is zero."
param b Vec4d
sheet body
node n00y00 Entry
node n00y01 This
node n00y02 Math
	set expr "Sqrt((Dot(double4(v.X, v.Y, v.Z, v.W), double4(v.X, v.Y, v.Z, v.W))) * (Dot(double4(b.X, b.Y, b.Z, b.W), double4(b.X, b.Y, b.Z, b.W))))"
node n00y03 Math
	set expr "d > 0.0 ? Acos(Clamp((Dot(double4(v.X, v.Y, v.Z, v.W), double4(b.X, b.Y, b.Z, b.W))) / d, -1.0, 1.0)) : 0.0"
node n00y04 Return
wire n00y00.b n00y02.b
wire n00y01.value n00y02.v
wire n00y00.b n00y03.b
wire n00y02.result n00y03.d
wire n00y01.value n00y03.v
wire n00y00.then n00y04.in
wire n00y03.result n00y04.value

function v00z IsFinite
	pure
	returns bool
	doc "True when no component is infinite or NaN."
sheet body
node n00z00 Entry
node n00z01 This
node n00z02 Math
	set expr "v.X - v.X == 0.0 && v.Y - v.Y == 0.0 && v.Z - v.Z == 0.0 && v.W - v.W == 0.0"
node n00z03 Return
wire n00z01.value n00z02.v
wire n00z00.then n00z03.in
wire n00z02.result n00z03.value

function v010 ApproxEquals
	pure
	returns bool
	doc "True when every component is within `epsilon` of the other's (absolute)."
