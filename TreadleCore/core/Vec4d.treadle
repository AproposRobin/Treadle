function v00w Reflect
	pure
	returns Vec4d
	doc "The vector mirrored off a surface with this unit `normal`: v - 2 Dot(v, n) n."
param normal Vec4d
sheet body
node n00w00 Entry
node n00w01 This
node n00w02 Math
	set expr "2.0 * (Dot(double4(v.X, v.Y, v.Z, v.W), double4(n.X, n.Y, n.Z, n.W)))"
node n00w03 Math
	set expr "double4(v.X, v.Y, v.Z, v.W) - double4(n.X, n.Y, n.Z, n.W) * k"
node n00w04 Break double4
node n00w05 Make Vec4d
node n00w06 Return
wire n00w00.normal n00w02.n
wire n00w01.value n00w02.v
wire n00w02.result n00w03.k
wire n00w00.normal n00w03.n
wire n00w01.value n00w03.v
wire n00w03.result n00w04.value
wire n00w04.w n00w05.W
wire n00w04.x n00w05.X
wire n00w04.y n00w05.Y
wire n00w04.z n00w05.Z
wire n00w00.then n00w06.in
wire n00w05.value n00w06.value

function v00x ProjectOnto
	pure
	returns Vec4d
	doc "The part of this vector along `b`; a zero `b` gives zero."
param b Vec4d
sheet body
node n00x00 Entry
node n00x01 This
node n00x02 Math
	set expr "Dot(double4(b.X, b.Y, b.Z, b.W), double4(b.X, b.Y, b.Z, b.W))"
node n00x03 Math
	set expr "bb > 0.0 ? (Dot(double4(v.X, v.Y, v.Z, v.W), double4(b.X, b.Y, b.Z, b.W))) / bb : 0.0"
node n00x04 Math
	set expr "double4(b.X, b.Y, b.Z, b.W) * k"
node n00x05 Break double4
node n00x06 Make Vec4d
node n00x07 Return
wire n00x00.b n00x02.b
wire n00x00.b n00x03.b
wire n00x02.result n00x03.bb
wire n00x01.value n00x03.v
wire n00x00.b n00x04.b
wire n00x03.result n00x04.k
