function v00n Normalized
	pure
	returns Vec4d
	doc "The vector scaled to length 1; a zero vector gives zero."
sheet body
node n00n00 Entry
node n00n01 This
node n00n02 Math
	set expr "Sqrt(Dot(double4(v.X, v.Y, v.Z, v.W), double4(v.X, v.Y, v.Z, v.W)))"
node n00n03 Math
	set expr "l > 0.0 ? 1.0 / l : 0.0"
node n00n04 Math
	set expr "double4(v.X, v.Y, v.Z, v.W) * k"
node n00n05 Break double4
node n00n06 Make Vec4d
node n00n07 Return
wire n00n01.value n00n02.v
wire n00n02.result n00n03.l
wire n00n03.result n00n04.k
wire n00n01.value n00n04.v
wire n00n04.result n00n05.value
wire n00n05.w n00n06.W
wire n00n05.x n00n06.X
wire n00n05.y n00n06.Y
wire n00n05.z n00n06.Z
wire n00n00.then n00n07.in
wire n00n06.value n00n07.value

function v00o Lerp
	pure
	returns Vec4d
	doc "The point `t` of the way to `to`: this at 0, `to` at 1 (t is not clamped)."
param to Vec4d
param t double
sheet body
node n00o00 Entry
node n00o01 This
node n00o02 Math
	set expr "double4(v.X, v.Y, v.Z, v.W) + (double4(b.X, b.Y, b.Z, b.W) - double4(v.X, v.Y, v.Z, v.W)) * t"
node n00o03 Break double4
node n00o04 Make Vec4d
node n00o05 Return
wire n00o00.to n00o02.b
wire n00o00.t n00o02.t
wire n00o01.value n00o02.v
wire n00o02.result n00o03.value
wire n00o03.w n00o04.W
wire n00o03.x n00o04.X
wire n00o03.y n00o04.Y
wire n00o03.z n00o04.Z
wire n00o00.then n00o05.in
wire n00o04.value n00o05.value

