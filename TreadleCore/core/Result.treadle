# treadle 1
type Result enum
	namespace Core
	generic T
	generic E
	doc "A value or an error: Ok(value) or Err(error). Result<T> is Result<T,void>. Result: match, Try and Switch read it; IsOk, Unwrap, UnwrapOr and Map are the short ways."

case Ok
	payload value T

case Err
	payload error E

function r0001 IsOk
	pure
	returns bool
	doc "True when it holds a value."
sheet body
node a1 Entry
node a2 This
node a3 IsCase Result<T,E>.Ok
node a4 Return
wire a2.value a3.value
wire a1.then a4.in
wire a3.result a4.value

function r0002 IsErr
	pure
	returns bool
	doc "True when it holds an error."
sheet body
node b1 Entry
node b2 This
node b3 IsCase Result<T,E>.Err
node b4 Return
wire b2.value b3.value
wire b1.then b4.in
wire b3.result b4.value

function r0003 Unwrap
	returns T
	doc "The value; an error is a fatal error."
sheet body
node c1 Entry
node c2 This
node c3 IsCase Result<T,E>.Ok
node c4 Branch
node c5 Return
node c6 Fatal
	in message "Result.Unwrap: it holds an error (Err)"
wire c2.value c3.value
wire c3.result c4.condition
wire c1.then c4.in
wire c4.true c5.in
wire c3.value c5.value
wire c4.false c6.in

function r0004 UnwrapOr
	pure
	returns T
	doc "The value, or `fallback` when it holds an error."
param fallback T
sheet body
node d1 Entry
node d2 This
node d3 IsCase Result<T,E>.Ok
node d4 Branch
node d5 Return
node d6 Return
wire d2.value d3.value
wire d3.result d4.condition
wire d1.then d4.in
wire d4.true d5.in
wire d3.value d5.value
wire d4.false d6.in
wire d1.fallback d6.value

function r0005 Map
	returns Result<U,E>
	generic U
	doc "Ok(mapper(value)) for a value, the same error for an error."
param mapper delegate:U(T)
sheet body
node e1 Entry
node e2 This
node e3 IsCase Result<T,E>.Ok
node e4 Branch
node e5 Invoke
node e6 MakeCase Result<U,E>.Ok
node e7 Return
node e8 IsCase Result<T,E>.Err
node e9 MakeCase Result<U,E>.Err
node f1 Return
wire e2.value e3.value
wire e3.result e4.condition
wire e1.then e4.in
wire e3.value e5.arg0
wire e1.mapper e5.delegate
wire e4.true e5.in
wire e5.result e6.value
wire e5.then e7.in
wire e6.value e7.value
wire e2.value e8.value
wire e8.error e9.error
wire e4.false f1.in
wire e9.value f1.value
