function v000b GetHashCode
	pure
	returns int
	doc "A hash of the text (FNV-1a over the bytes): equal texts give equal hashes."
local h int
	init -3750763034362895579
sheet body
node p1 Entry
node p2 Get this.Length
node p3 For
	in start 0
node p4 Make StringView
node p5 Get this.Ptr
node p6 Index
node p7 Cast int
node p8 Get local:h
node p9 Operator ^
node q1 Operator *
	in b 1099511628211
node q2 Set local:h
node q3 Return
wire p2.value p3.count
wire p1.then p3.in
wire p2.value p4.Length
wire p5.value p4.Ptr
wire p4.value p6.collection
wire p3.index p6.index
wire p6.value p7.value
wire p8.value p9.a
wire p7.result p9.b
wire p9.result q1.a
wire p3.body q2.in
wire q1.result q2.value
wire p3.done q3.in
wire p8.value q3.value

function v000c Split
	doc "Adds the pieces between the separators to `into` (views of this text). With `skipEmpty` the empty pieces (two separators in a row, one at an end) are left out."
param separator char8
param into List<StringView>
param skipEmpty bool
	default false
local start int
sheet body
node r1 Entry
node r2 Get this.Length
node r3 For
	in start 0
node r4 Make StringView
node r5 Get this.Ptr
node r6 Index
node r7 Operator ==
node r8 Branch
node r9 Get local:start
node s1 Operator -
node s2 Call this.AddPiece
node s3 Operator +
	in b 1
node s4 Set local:start
node s5 Operator -
node s6 Call this.AddPiece
node s7 Return
wire r2.value r3.count
wire r1.then r3.in
wire r2.value r4.Length
wire r5.value r4.Ptr
wire r4.value r6.collection
wire r3.index r6.index
wire r6.value r7.a
wire r1.separator r7.b
wire r7.result r8.condition
wire r3.body r8.in
wire r3.index s1.a
wire r9.value s1.b
wire r8.true s2.in
wire r1.into s2.into
wire s1.result s2.length
wire r1.skipEmpty s2.skipEmpty
wire r9.value s2.start
wire r3.index s3.a
wire s2.then s4.in
wire s3.result s4.value
wire r2.value s5.a
wire r9.value s5.b
wire r3.done s6.in
wire r1.into s6.into
wire s5.result s6.length
wire r1.skipEmpty s6.skipEmpty
wire r9.value s6.start
wire s6.then s7.in

function v000d AddPiece
	access private
	doc "Split's step: adds the piece unless it is empty and empties are skipped."
param start int
param length int
param into List<StringView>
param skipEmpty bool
sheet body
node t1 Entry
node t2 Operator >
	in b 0
node t3 Operator !
node t4 Operator ||
node t5 Branch
node t6 Call this.Substring
node t7 Call List<StringView>.Add
node t8 Return
node t9 Return
wire t1.length t2.a
wire t1.skipEmpty t3.a
wire t2.result t4.a
wire t3.result t4.b
wire t4.result t5.condition
wire t1.then t5.in
wire t1.length t6.length
wire t1.start t6.start
wire t5.true t7.in
wire t1.into t7.receiver
wire t6.result t7.value
wire t7.then t8.in
wire t5.false t9.in

