# treadle 1
type StringView struct
	namespace Core
	implements IHashable
	attr CRepr
	doc "A pointer and a length: a view of UTF-8 text someone else owns (a String, a literal, a C buffer). Copying a view copies the pointer, not the text."

field Ptr char8*

field Length int

function v0001 IsEmpty
	pure
	returns bool
	doc "True when the view has no characters."
sheet body
node a1 Entry
node a2 Get this.Length
node a3 Operator ==
	in b 0
node a4 Return
wire a2.value a3.a
wire a1.then a4.in
wire a3.result a4.value

function v0002 MatchesAt
	pure
	access internal
	returns bool
	doc "True when `text` appears at position `pos` (false when it would not fit): one memcmp of its bytes."
param pos int
param text StringView
sheet body
node b1 Entry
node b2 Break StringView
node b3 Get this.Length
node b4 Operator <
	in b 0
node b5 Operator +
node b6 Operator >
node b7 Operator ||
node b8 Branch
node b9 Return
	in value false
node c1 Return
node c2 Call this.Substring
node c3 Break StringView
node c4 Call C.crt.memcmp
node c5 Operator ==
	in b 0
node c6 Cast uint
wire b1.text b2.value
wire b1.pos b4.a
wire b1.pos b5.a
wire b2.Length b5.b
wire b5.result b6.a
wire b3.value b6.b
wire b4.result b7.a
wire b6.result b7.b
wire b7.result b8.condition
wire b1.then b8.in
wire b8.true b9.in
wire b8.false c1.in
wire c5.result c1.value
wire b2.Length c2.length
wire b1.pos c2.start
wire c2.result c3.value
wire c3.Ptr c4.a
wire b2.Ptr c4.b
wire c6.result c4.n
wire c4.result c5.a
wire b2.Length c6.value

function v0003 Equals
	pure
	returns bool
	doc "True when both views hold the same text (byte for byte)."
param other StringView
sheet body
node e1 Entry
node e2 Get this.Length
node e3 Break StringView
node e4 Operator ==
node e5 Call this.MatchesAt
	in pos 0
node e6 Operator &&
node e7 Return
wire e1.other e3.value
wire e2.value e4.a
wire e3.Length e4.b
wire e1.other e5.text
wire e4.result e6.a
wire e5.result e6.b
wire e1.then e7.in
wire e6.result e7.value

function v0004 StartsWith
	pure
	returns bool
	doc "True when the view begins with `text`."
param text StringView
sheet body
node f1 Entry
node f2 Call this.MatchesAt
	in pos 0
node f3 Return
wire f1.text f2.text
wire f1.then f3.in
wire f2.result f3.value

function v0005 EndsWith
	pure
	returns bool
	doc "True when the view ends with `text`."
param text StringView
sheet body
node g1 Entry
node g2 Get this.Length
node g3 Break StringView
node g4 Operator -
node g5 Call this.MatchesAt
node g6 Return
wire g1.text g3.value
wire g2.value g4.a
wire g3.Length g4.b
wire g4.result g5.pos
wire g1.text g5.text
wire g1.then g6.in
wire g5.result g6.value

function v0006 IndexOf
	pure
	returns int
	doc "The position of the first `c`, or -1."
param c char8
sheet body
node h1 Entry
node h2 Get this.Length
node h3 For
	in start 0
node h4 Make StringView
node h5 Get this.Ptr
node h6 Index
node h7 Operator ==
node h8 Branch
node h9 Return
node i1 Return
	in value -1
wire h2.value h3.count
wire h1.then h3.in
wire h2.value h4.Length
wire h5.value h4.Ptr
wire h4.value h6.collection
wire h3.index h6.index
wire h6.value h7.a
wire h1.c h7.b
wire h7.result h8.condition
wire h3.body h8.in
wire h8.true h9.in
wire h3.index h9.value
wire h3.done i1.in

function v0007 IndexOf
	pure
	returns int
	doc "The position of the first occurrence of `text`, or -1 (an empty text is found at 0)."
param text StringView
sheet body
node j1 Entry
node j2 Get this.Length
node j3 Break StringView
node j4 Operator -
node j5 Operator +
	in b 1
node j6 For
	in start 0
node j7 Call this.MatchesAt
node j8 Branch
node j9 Return
node k1 Return
	in value -1
wire j1.text j3.value
wire j2.value j4.a
wire j3.Length j4.b
wire j4.result j5.a
wire j5.result j6.count
wire j1.then j6.in
wire j6.index j7.pos
wire j1.text j7.text
wire j7.result j8.condition
wire j6.body j8.in
wire j8.true j9.in
wire j6.index j9.value
wire j6.done k1.in

function v0008 Contains
	pure
	returns bool
	doc "True when `text` appears in the view."
param text StringView
sheet body
node l1 Entry
node l2 Call this.IndexOf(StringView)
node l3 Operator >=
	in b 0
node l4 Return
wire l1.text l2.text
wire l2.result l3.a
wire l1.then l4.in
wire l3.result l4.value

function v0009 Substring
	pure
	returns StringView
	attr Intrinsic StringView.Substring
	doc "The `length` characters from position `start` (a view of the same text; the range is not checked)."
param start int
param length int

