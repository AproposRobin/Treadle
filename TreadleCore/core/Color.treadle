# treadle 1
type Color struct
	namespace Core
	attr CRepr
	doc "A colour of four floats R, G, B, A (linear light; 0 to 1 is the usual range, more is allowed for bright lights; 16 bytes). Color32 holds it as four bytes in sRGB. Every function is Pure."

field R float

field G float

field B float

field A float

property c000 White Color
	static
	doc "White (1, 1, 1, 1)."
sheet get
node n00000 Entry
node n00001 Make Color
	in R 1.0f
	in G 1.0f
	in B 1.0f
	in A 1.0f
node n00002 Return
wire n00000.then n00002.in
wire n00001.value n00002.value

property c001 Black Color
	static
	doc "Black (0, 0, 0, 1)."
sheet get
node n00100 Entry
node n00101 Make Color
	in R 0.0f
	in G 0.0f
	in B 0.0f
	in A 1.0f
node n00102 Return
wire n00100.then n00102.in
wire n00101.value n00102.value

