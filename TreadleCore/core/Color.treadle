operator c00m ==
	static
	pure
	returns bool
	doc "True when every component is equal (exact)."
param a Color
param b Color
sheet body
node n00m00 Entry
node n00m01 Math
	set expr "a.R == b.R && a.G == b.G && a.B == b.B && a.A == b.A"
node n00m02 Return
wire n00m00.a n00m01.a
wire n00m00.b n00m01.b
wire n00m00.then n00m02.in
wire n00m01.result n00m02.value

function c00n ApproxEquals
	pure
	returns bool
	doc "True when every component is within `epsilon` of the other's (absolute)."
param other Color
param epsilon float
	default 0.00001f
sheet body
node n00n00 Entry
node n00n01 This
node n00n02 Math
	set expr "Abs(v.R - o.R) <= e && Abs(v.G - o.G) <= e && Abs(v.B - o.B) <= e && Abs(v.A - o.A) <= e"
node n00n03 Return
wire n00n00.epsilon n00n02.e
wire n00n00.other n00n02.o
wire n00n01.value n00n02.v
wire n00n00.then n00n03.in
wire n00n02.result n00n03.value
