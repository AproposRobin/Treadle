wire n00k00.b n00k02.b
wire n00k00.a n00k03.a
wire n00k00.b n00k03.b
wire n00k00.a n00k04.a
wire n00k00.b n00k04.b
wire n00k04.result n00k05.A
wire n00k03.result n00k05.B
wire n00k02.result n00k05.G
wire n00k01.result n00k05.R
wire n00k00.then n00k06.in
wire n00k05.value n00k06.value

operator c00l *
	static
	pure
	returns Color
	doc "Every component times `k`."
param a Color
param k float
sheet body
node n00l00 Entry
node n00l01 Math
	set expr "a.R * k"
node n00l02 Math
	set expr "a.G * k"
node n00l03 Math
	set expr "a.B * k"
node n00l04 Math
	set expr "a.A * k"
