# treadle 1
type MathFormat extension
	namespace Core
	extends Core.String
	doc "String.Append for the math types: vectors, quaternions and colours as (1, 2, 3), matrices as their rows [(..), (..)], each number as Append writes it. AppendF uses these for its arguments."

function m000 Append
	doc "Appends the vector as (X, Y)."
param value Vec2
sheet body
node n00000 Entry
node n00001 Break Core.Vec2
node n00002 Call this.Append(StringView)
	in text "("
node n00003 Call this.Append(float)
node n00004 Call this.Append(StringView)
	in text ", "
node n00005 Call this.Append(float)
node n00006 Call this.Append(StringView)
	in text ")"
node n00007 Return
wire n00000.value n00001.value
wire n00000.then n00002.in
wire n00002.then n00003.in
wire n00001.X n00003.value
wire n00003.then n00004.in
wire n00004.then n00005.in
wire n00001.Y n00005.value
wire n00005.then n00006.in
wire n00006.then n00007.in

