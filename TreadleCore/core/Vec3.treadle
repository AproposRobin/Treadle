# treadle 1
type Vec3 struct
	namespace Core
	attr CRepr
	doc "A 3D vector of floats (X, Y, Z; 12 bytes, laid out as in C): a position, a direction, a size. Every function is Pure."

field X float

field Y float

field Z float

property v000 Zero Vec3
	static
	doc "All components 0."
sheet get
node n00000 Entry
node n00001 Make Vec3
	in X 0.0f
	in Y 0.0f
	in Z 0.0f
node n00002 Return
wire n00000.then n00002.in
wire n00001.value n00002.value

