function v00m Normalized
	pure
	returns Vec3
	doc "The vector scaled to length 1; a zero vector gives zero."
sheet body
node n00m00 Entry
node n00m01 This
node n00m02 Math
	set expr "Sqrt(v.X * v.X + v.Y * v.Y + v.Z * v.Z)"
node n00m03 Math
	set expr "l > 0.0f ? 1.0f / l : 0.0f"
node n00m04 Math
	set expr "v.X * k"
node n00m05 Math
	set expr "v.Y * k"
node n00m06 Math
	set expr "v.Z * k"
node n00m07 Make Vec3
node n00m08 Return
