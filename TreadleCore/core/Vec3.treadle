function v00n Lerp
	pure
	returns Vec3
	doc "The point `t` of the way to `to`: this at 0, `to` at 1 (t is not clamped)."
param to Vec3
param t float
sheet body
node n00n00 Entry
node n00n01 This
node n00n02 Math
	set expr "v.X + (b.X - v.X) * t"
node n00n03 Math
	set expr "v.Y + (b.Y - v.Y) * t"
node n00n04 Math
	set expr "v.Z + (b.Z - v.Z) * t"
node n00n05 Make Vec3
node n00n06 Return
wire n00n00.to n00n02.b
wire n00n00.t n00n02.t
wire n00n01.value n00n02.v
wire n00n00.to n00n03.b
wire n00n00.t n00n03.t
wire n00n01.value n00n03.v
wire n00n00.to n00n04.b
wire n00n00.t n00n04.t
wire n00n01.value n00n04.v
wire n00n02.result n00n05.X
wire n00n03.result n00n05.Y
wire n00n04.result n00n05.Z
wire n00n00.then n00n06.in
wire n00n05.value n00n06.value

