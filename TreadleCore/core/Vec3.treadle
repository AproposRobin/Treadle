function v00v Reflect
	pure
	returns Vec3
	doc "The vector mirrored off a surface with this unit `normal`: v - 2 Dot(v, n) n."
param normal Vec3
sheet body
node n00v00 Entry
node n00v01 This
node n00v02 Math
	set expr "2.0f * (v.X * n.X + v.Y * n.Y + v.Z * n.Z)"
node n00v03 Math
	set expr "v.X - n.X * k"
node n00v04 Math
	set expr "v.Y - n.Y * k"
node n00v05 Math
	set expr "v.Z - n.Z * k"
node n00v06 Make Vec3
node n00v07 Return
wire n00v00.normal n00v02.n
wire n00v01.value n00v02.v
wire n00v02.result n00v03.k
wire n00v00.normal n00v03.n
wire n00v01.value n00v03.v
wire n00v02.result n00v04.k
wire n00v00.normal n00v04.n
wire n00v01.value n00v04.v
wire n00v02.result n00v05.k
wire n00v00.normal n00v05.n
wire n00v01.value n00v05.v
wire n00v03.result n00v06.X
wire n00v04.result n00v06.Y
wire n00v05.result n00v06.Z
wire n00v00.then n00v07.in
wire n00v06.value n00v07.value

function v00w ProjectOnto
	pure
	returns Vec3
	doc "The part of this vector along `b`; a zero `b` gives zero."
param b Vec3
sheet body
node n00w00 Entry
node n00w01 This
node n00w02 Math
	set expr "b.X * b.X + b.Y * b.Y + b.Z * b.Z"
node n00w03 Math
	set expr "bb > 0.0f ? (v.X * b.X + v.Y * b.Y + v.Z * b.Z) / bb : 0.0f"
node n00w04 Math
	set expr "b.X * k"
node n00w05 Math
	set expr "b.Y * k"
node n00w06 Math
	set expr "b.Z * k"
node n00w07 Make Vec3
node n00w08 Return
wire n00w00.b n00w02.b
wire n00w00.b n00w03.b
wire n00w02.result n00w03.bb
wire n00w01.value n00w03.v
wire n00w00.b n00w04.b
wire n00w03.result n00w04.k
wire n00w00.b n00w05.b
wire n00w03.result n00w05.k
wire n00w00.b n00w06.b
wire n00w03.result n00w06.k
wire n00w04.result n00w07.X
wire n00w05.result n00w07.Y
wire n00w06.result n00w07.Z
wire n00w00.then n00w08.in
wire n00w07.value n00w08.value

function v00x AngleTo
	pure
	returns float
	doc "The angle to `b` in radians, 0 to PI; 0 when either is zero."
param b Vec3
sheet body
node n00x00 Entry
node n00x01 This
node n00x02 Math
	set expr "Sqrt((v.X * v.X + v.Y * v.Y + v.Z * v.Z) * (b.X * b.X + b.Y * b.Y + b.Z * b.Z))"
node n00x03 Math
	set expr "d > 0.0f ? Acos(Clamp((v.X * b.X + v.Y * b.Y + v.Z * b.Z) / d, -1.0f, 1.0f)) : 0.0f"
node n00x04 Return
wire n00x00.b n00x02.b
wire n00x01.value n00x02.v
wire n00x00.b n00x03.b
wire n00x02.result n00x03.d
wire n00x01.value n00x03.v
wire n00x00.then n00x04.in
wire n00x03.result n00x04.value

