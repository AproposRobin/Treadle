node n00y00 Entry
node n00y01 This
node n00y02 Math
	set expr "v.X - v.X == 0.0f && v.Y - v.Y == 0.0f && v.Z - v.Z == 0.0f"
node n00y03 Return
wire n00y01.value n00y02.v
wire n00y00.then n00y03.in
wire n00y02.result n00y03.value

function v00z ApproxEquals
	pure
	returns bool
	doc "True when every component is within `epsilon` of the other's (absolute)."
param other Vec3
param epsilon float
	default 0.00001f
sheet body
node n00z00 Entry
node n00z01 This
node n00z02 Math
	set expr "Abs(v.X - o.X) <= e && Abs(v.Y - o.Y) <= e && Abs(v.Z - o.Z) <= e"
node n00z03 Return
wire n00z00.epsilon n00z02.e
wire n00z00.other n00z02.o
wire n00z01.value n00z02.v
wire n00z00.then n00z03.in
wire n00z02.result n00z03.value

function v010 Cross
	pure
	returns Vec3
	doc "The cross product (right-handed): perpendicular to both."
