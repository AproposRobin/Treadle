node c5 Return
	in value false
node c6 Get List<T>.Count
node c7 For
	in start 0
node c8 Index
node c9 Operator ==
node d1 Branch
node d2 Delete
node d3 Call List<T>.RemoveAt
node d4 Return
	in value true
node d5 Return
	in value false
wire c2.value c3.a
wire c3.result c4.condition
wire c1.then c4.in
wire c4.true c5.in
wire c2.value c6.receiver
wire c6.value c7.count
wire c4.false c7.in
wire c2.value c8.collection
wire c7.index c8.index
wire c8.value c9.a
wire c1.handler c9.b
wire c9.result d1.condition
wire c7.body d1.in
