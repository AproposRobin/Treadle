# treadle 1
type Event struct
	namespace Core
	generic T class
	doc "The storage of an event (Language.md 4, Event): the handlers (delegates) in the order they were added. The event owns them: Remove and Clear delete them, and so does the destructor, which runs with the object that has the event. A field marked Event holds one of these; its Add, Remove, Invoke, Clear and Count nodes reach it (Invoke is compiled into a loop over the handlers)."

field mHandlers List<T>
	access internal

dtor e0001
	doc "Deletes every handler, then the list."
sheet body
node a1 Entry
node a2 Get this.mHandlers
node a3 Operator ==
	in b null
node a4 Branch
node a5 Call List<T>.DeleteAll
node a6 Delete
node a7 Return
wire a2.value a3.a
wire a3.result a4.condition
wire a1.then a4.in
wire a4.false a5.in
wire a2.value a5.receiver
wire a5.then a6.in
wire a2.value a6.object
wire a4.true a7.in
wire a6.then a7.in

function e0002 Add
	mutating
	doc "Adds a handler at the end; the event owns it from now on."
param handler T
sheet body
node b1 Entry
node b2 Get this.mHandlers
node b3 Operator ==
	in b null
node b4 Branch
node b5 Construct List<T>
node b6 Set this.mHandlers
node b7 Get this.mHandlers
node b8 Call List<T>.Add
node b9 Return
wire b2.value b3.a
wire b3.result b4.condition
wire b1.then b4.in
wire b4.true b5.in
wire b5.then b6.in
wire b5.object b6.value
wire b4.false b8.in
wire b6.then b8.in
wire b7.value b8.receiver
wire b1.handler b8.value
wire b8.then b9.in

function e0003 Remove
	mutating
	returns bool
	doc "Removes the handler that is `handler` (the same delegate object) and deletes it; false when the event does not hold it."
param handler T
