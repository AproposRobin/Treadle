wire d2.then d3.in
wire c7.index d3.index
wire c2.value d3.receiver
wire d3.then d4.in
wire c7.done d5.in

function e0004 Clear
	mutating
	doc "Deletes every handler (the event is empty afterwards)."
sheet body
node f1 Entry
node f2 Get this.mHandlers
node f3 Operator ==
	in b null
node f4 Branch
node f5 Call List<T>.DeleteAll
node f6 Return
