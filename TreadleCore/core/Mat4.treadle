function m00g Inverted
	pure
	returns Mat4
	doc "The inverse (general, by cofactors); a singular matrix (determinant 0) gives all zeros."
sheet body
node n00g00 Entry
node n00g01 This
node n00g02 Math
	set expr "m.C0.X * m.C1.Y - m.C1.X * m.C0.Y"
