# treadle 1
type Mat4 struct
	namespace Core
	attr CRepr
	doc "A 4x4 matrix of floats in columns C0..C3 (column-major, 64 bytes, as GLSL and Vulkan lay it out): M * v transforms a column vector. Every function is Pure."

field C0 Vec4
	doc "Column 0."

field C1 Vec4
	doc "Column 1."

field C2 Vec4
	doc "Column 2."

field C3 Vec4
	doc "Column 3."

property m000 Identity Mat4
	static
	doc "Ones on the diagonal, zeros elsewhere."
sheet get
node n00000 Entry
node n00001 Make Vec4
	in X 1.0f
	in Y 0.0f
	in Z 0.0f
	in W 0.0f
node n00002 Make Vec4
	in X 0.0f
	in Y 1.0f
	in Z 0.0f
	in W 0.0f
node n00003 Make Vec4
	in X 0.0f
	in Y 0.0f
	in Z 1.0f
	in W 0.0f
node n00004 Make Vec4
	in X 0.0f
	in Y 0.0f
	in Z 0.0f
	in W 1.0f
node n00005 Make Mat4
node n00006 Return
wire n00001.value n00005.C0
wire n00002.value n00005.C1
wire n00003.value n00005.C2
wire n00004.value n00005.C3
wire n00000.then n00006.in
wire n00005.value n00006.value

