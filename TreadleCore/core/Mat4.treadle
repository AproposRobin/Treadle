function m00f Determinant
	pure
	returns float
	doc "The determinant (0 for a matrix that has no inverse)."
sheet body
node n00f00 Entry
node n00f01 This
node n00f02 Math
	set expr "m.C0.X * m.C1.Y - m.C1.X * m.C0.Y"
node n00f03 Math
	set expr "m.C0.X * m.C1.Z - m.C1.X * m.C0.Z"
node n00f04 Math
	set expr "m.C0.X * m.C1.W - m.C1.X * m.C0.W"
node n00f05 Math
	set expr "m.C0.Y * m.C1.Z - m.C1.Y * m.C0.Z"
node n00f06 Math
	set expr "m.C0.Y * m.C1.W - m.C1.Y * m.C0.W"
node n00f07 Math
	set expr "m.C0.Z * m.C1.W - m.C1.Z * m.C0.W"
node n00f08 Math
	set expr "m.C2.Z * m.C3.W - m.C3.Z * m.C2.W"
node n00f09 Math
	set expr "m.C2.Y * m.C3.W - m.C3.Y * m.C2.W"
node n00f0a Math
	set expr "m.C2.Y * m.C3.Z - m.C3.Y * m.C2.Z"
node n00f0b Math
	set expr "m.C2.X * m.C3.W - m.C3.X * m.C2.W"
node n00f0c Math
	set expr "m.C2.X * m.C3.Z - m.C3.X * m.C2.Z"
node n00f0d Math
	set expr "m.C2.X * m.C3.Y - m.C3.X * m.C2.Y"
node n00f0e Math
	set expr "s0 * c5 - s1 * c4 + s2 * c3 + s3 * c2 - s4 * c1 + s5 * c0"
node n00f0f Math
	set expr "d != 0.0f ? 1.0f / d : 0.0f"
node n00f0g Math
	set expr "(m.C1.Y * c5 - m.C1.Z * c4 + m.C1.W * c3) * k"
node n00f0h Math
	set expr "(-m.C0.Y * c5 + m.C0.Z * c4 - m.C0.W * c3) * k"
node n00f0i Math
	set expr "(m.C3.Y * s5 - m.C3.Z * s4 + m.C3.W * s3) * k"
node n00f0j Math
	set expr "(-m.C2.Y * s5 + m.C2.Z * s4 - m.C2.W * s3) * k"
node n00f0k Make Vec4
node n00f0l Math
	set expr "(-m.C1.X * c5 + m.C1.Z * c2 - m.C1.W * c1) * k"
node n00f0m Math
	set expr "(m.C0.X * c5 - m.C0.Z * c2 + m.C0.W * c1) * k"
node n00f0n Math
	set expr "(-m.C3.X * s5 + m.C3.Z * s2 - m.C3.W * s1) * k"
node n00f0o Math
	set expr "(m.C2.X * s5 - m.C2.Z * s2 + m.C2.W * s1) * k"
node n00f0p Make Vec4
node n00f0q Math
	set expr "(m.C1.X * c4 - m.C1.Y * c2 + m.C1.W * c0) * k"
node n00f0r Math
	set expr "(-m.C0.X * c4 + m.C0.Y * c2 - m.C0.W * c0) * k"
node n00f0s Math
	set expr "(m.C3.X * s4 - m.C3.Y * s2 + m.C3.W * s0) * k"
node n00f0t Math
	set expr "(-m.C2.X * s4 + m.C2.Y * s2 - m.C2.W * s0) * k"
node n00f0u Make Vec4
node n00f0v Math
	set expr "(-m.C1.X * c3 + m.C1.Y * c1 - m.C1.Z * c0) * k"
node n00f0w Math
	set expr "(m.C0.X * c3 - m.C0.Y * c1 + m.C0.Z * c0) * k"
node n00f0x Math
	set expr "(-m.C3.X * s3 + m.C3.Y * s1 - m.C3.Z * s0) * k"
node n00f0y Math
	set expr "(m.C2.X * s3 - m.C2.Y * s1 + m.C2.Z * s0) * k"
node n00f0z Make Vec4
node n00f10 Make Mat4
node n00f11 Return
