function m00j ApproxEquals
	pure
	returns bool
	doc "True when every element is within `epsilon` of the other's (absolute)."
param other Mat4
param epsilon float
	default 0.00001f
sheet body
node n00j00 Entry
node n00j01 This
node n00j02 Math
	set expr "Abs(m.C0.X - o.C0.X) <= e && Abs(m.C0.Y - o.C0.Y) <= e && Abs(m.C0.Z - o.C0.Z) <= e && Abs(m.C0.W - o.C0.W) <= e && Abs(m.C1.X - o.C1.X) <= e && Abs(m.C1.Y - o.C1.Y) <= e && Abs(m.C1.Z - o.C1.Z) <= e && Abs(m.C1.W - o.C1.W) <= e && Abs(m.C2.X - o.C2.X) <= e && Abs(m.C2.Y - o.C2.Y) <= e && Abs(m.C2.Z - o.C2.Z) <= e && Abs(m.C2.W - o.C2.W) <= e && Abs(m.C3.X - o.C3.X) <= e && Abs(m.C3.Y - o.C3.Y) <= e && Abs(m.C3.Z - o.C3.Z) <= e && Abs(m.C3.W - o.C3.W) <= e"
node n00j03 Return
wire n00j00.epsilon n00j02.e
wire n00j01.value n00j02.m
wire n00j00.other n00j02.o
wire n00j00.then n00j03.in
wire n00j02.result n00j03.value

