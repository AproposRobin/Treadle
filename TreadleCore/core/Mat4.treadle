operator m008 ==
	static
	pure
	returns bool
	doc "True when every element is equal (exact)."
param a Mat4
param b Mat4
sheet body
node n00800 Entry
node n00801 Math
	set expr "a.C0.X == b.C0.X && a.C0.Y == b.C0.Y && a.C0.Z == b.C0.Z && a.C0.W == b.C0.W && a.C1.X == b.C1.X && a.C1.Y == b.C1.Y && a.C1.Z == b.C1.Z && a.C1.W == b.C1.W && a.C2.X == b.C2.X && a.C2.Y == b.C2.Y && a.C2.Z == b.C2.Z && a.C2.W == b.C2.W && a.C3.X == b.C3.X && a.C3.Y == b.C3.Y && a.C3.Z == b.C3.Z && a.C3.W == b.C3.W"
node n00802 Return
wire n00800.a n00801.a
wire n00800.b n00801.b
wire n00800.then n00802.in
wire n00801.result n00802.value

operator m009 *
	static
	pure
	returns Vec4
	doc "The column vector `v` transformed: m * v."
param m Mat4
param v Vec4
sheet body
node n00900 Entry
node n00901 Math
	set expr "m.C0.X * v.X + m.C1.X * v.Y + m.C2.X * v.Z + m.C3.X * v.W"
node n00902 Math
	set expr "m.C0.Y * v.X + m.C1.Y * v.Y + m.C2.Y * v.Z + m.C3.Y * v.W"
node n00903 Math
	set expr "m.C0.Z * v.X + m.C1.Z * v.Y + m.C2.Z * v.Z + m.C3.Z * v.W"
node n00904 Math
	set expr "m.C0.W * v.X + m.C1.W * v.Y + m.C2.W * v.Z + m.C3.W * v.W"
node n00905 Make Vec4
node n00906 Return
