function m00c Transform
	pure
	returns Vec4
	doc "The column vector `v` transformed: M * v (the operator `*` with a vector)."
param v Vec4
sheet body
node n00c00 Entry
node n00c01 This
node n00c02 Math
	set expr "m.C0.X * v.X + m.C1.X * v.Y + m.C2.X * v.Z + m.C3.X * v.W"
node n00c03 Math
	set expr "m.C0.Y * v.X + m.C1.Y * v.Y + m.C2.Y * v.Z + m.C3.Y * v.W"
node n00c04 Math
	set expr "m.C0.Z * v.X + m.C1.Z * v.Y + m.C2.Z * v.Z + m.C3.Z * v.W"
node n00c05 Math
	set expr "m.C0.W * v.X + m.C1.W * v.Y + m.C2.W * v.Z + m.C3.W * v.W"
node n00c06 Make Vec4
node n00c07 Return
