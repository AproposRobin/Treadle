function m00b Multiply
	pure
	returns Mat4
	doc "This matrix times `b` (the operator `*`): `b` is applied first."
param b Mat4
sheet body
node n00b00 Entry
node n00b01 This
node n00b02 Math
	set expr "a.C0.X * b.C0.X + a.C1.X * b.C0.Y + a.C2.X * b.C0.Z + a.C3.X * b.C0.W"
node n00b03 Math
	set expr "a.C0.Y * b.C0.X + a.C1.Y * b.C0.Y + a.C2.Y * b.C0.Z + a.C3.Y * b.C0.W"
node n00b04 Math
	set expr "a.C0.Z * b.C0.X + a.C1.Z * b.C0.Y + a.C2.Z * b.C0.Z + a.C3.Z * b.C0.W"
node n00b05 Math
	set expr "a.C0.W * b.C0.X + a.C1.W * b.C0.Y + a.C2.W * b.C0.Z + a.C3.W * b.C0.W"
node n00b06 Make Vec4
node n00b07 Math
	set expr "a.C0.X * b.C1.X + a.C1.X * b.C1.Y + a.C2.X * b.C1.Z + a.C3.X * b.C1.W"
node n00b08 Math
	set expr "a.C0.Y * b.C1.X + a.C1.Y * b.C1.Y + a.C2.Y * b.C1.Z + a.C3.Y * b.C1.W"
node n00b09 Math
	set expr "a.C0.Z * b.C1.X + a.C1.Z * b.C1.Y + a.C2.Z * b.C1.Z + a.C3.Z * b.C1.W"
node n00b0a Math
	set expr "a.C0.W * b.C1.X + a.C1.W * b.C1.Y + a.C2.W * b.C1.Z + a.C3.W * b.C1.W"
node n00b0b Make Vec4
node n00b0c Math
	set expr "a.C0.X * b.C2.X + a.C1.X * b.C2.Y + a.C2.X * b.C2.Z + a.C3.X * b.C2.W"
node n00b0d Math
	set expr "a.C0.Y * b.C2.X + a.C1.Y * b.C2.Y + a.C2.Y * b.C2.Z + a.C3.Y * b.C2.W"
node n00b0e Math
	set expr "a.C0.Z * b.C2.X + a.C1.Z * b.C2.Y + a.C2.Z * b.C2.Z + a.C3.Z * b.C2.W"
node n00b0f Math
	set expr "a.C0.W * b.C2.X + a.C1.W * b.C2.Y + a.C2.W * b.C2.Z + a.C3.W * b.C2.W"
node n00b0g Make Vec4
node n00b0h Math
	set expr "a.C0.X * b.C3.X + a.C1.X * b.C3.Y + a.C2.X * b.C3.Z + a.C3.X * b.C3.W"
node n00b0i Math
	set expr "a.C0.Y * b.C3.X + a.C1.Y * b.C3.Y + a.C2.Y * b.C3.Z + a.C3.Y * b.C3.W"
node n00b0j Math
	set expr "a.C0.Z * b.C3.X + a.C1.Z * b.C3.Y + a.C2.Z * b.C3.Z + a.C3.Z * b.C3.W"
node n00b0k Math
	set expr "a.C0.W * b.C3.X + a.C1.W * b.C3.Y + a.C2.W * b.C3.Z + a.C3.W * b.C3.W"
