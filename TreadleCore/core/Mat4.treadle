function m002 Get
	pure
	returns float
	doc "The element at `row`, `col` (0-based; an index out of range gives the last one)."
param row int
param col int
sheet body
node n00200 Entry
node n00201 This
node n00202 Math
	set expr "c == 0 ? (r == 0 ? m.C0.X : r == 1 ? m.C0.Y : r == 2 ? m.C0.Z : m.C0.W) : c == 1 ? (r == 0 ? m.C1.X : r == 1 ? m.C1.Y : r == 2 ? m.C1.Z : m.C1.W) : c == 2 ? (r == 0 ? m.C2.X : r == 1 ? m.C2.Y : r == 2 ? m.C2.Z : m.C2.W) : (r == 0 ? m.C3.X : r == 1 ? m.C3.Y : r == 2 ? m.C3.Z : m.C3.W)"
node n00203 Return
wire n00200.col n00202.c
wire n00201.value n00202.m
wire n00200.row n00202.r
wire n00200.then n00203.in
wire n00202.result n00203.value

function m003 Column
