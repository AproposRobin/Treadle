function m00w TransformPoint
	pure
	returns Vec3
	doc "The point transformed (W = 1; no divide by W)."
param point Vec3
sheet body
node n00w00 Entry
node n00w01 This
node n00w02 Math
	set expr "m.C0.X * p.X + m.C1.X * p.Y + m.C2.X * p.Z + m.C3.X"
node n00w03 Math
	set expr "m.C0.Y * p.X + m.C1.Y * p.Y + m.C2.Y * p.Z + m.C3.Y"
node n00w04 Math
	set expr "m.C0.Z * p.X + m.C1.Z * p.Y + m.C2.Z * p.Z + m.C3.Z"
node n00w05 Make Vec3
node n00w06 Return
