	set expr "i == 0 ? m.C0.X : i == 1 ? m.C1.X : i == 2 ? m.C2.X : m.C3.X"
node n00303 Math
	set expr "i == 0 ? m.C0.Y : i == 1 ? m.C1.Y : i == 2 ? m.C2.Y : m.C3.Y"
node n00304 Math
	set expr "i == 0 ? m.C0.Z : i == 1 ? m.C1.Z : i == 2 ? m.C2.Z : m.C3.Z"
node n00305 Math
	set expr "i == 0 ? m.C0.W : i == 1 ? m.C1.W : i == 2 ? m.C2.W : m.C3.W"
node n00306 Make Vec4
node n00307 Return
wire n00300.index n00302.i
wire n00301.value n00302.m
wire n00300.index n00303.i
wire n00301.value n00303.m
wire n00300.index n00304.i
wire n00301.value n00304.m
wire n00300.index n00305.i
