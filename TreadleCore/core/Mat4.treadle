function m00y TransformPerspective
	pure
	returns Vec3
	doc "The point transformed with W = 1, then divided by the resulting W (a projection)."
param point Vec3
sheet body
node n00y00 Entry
node n00y01 This
node n00y02 Math
	set expr "m.C0.W * p.X + m.C1.W * p.Y + m.C2.W * p.Z + m.C3.W"
node n00y03 Math
	set expr "(m.C0.X * p.X + m.C1.X * p.Y + m.C2.X * p.Z + m.C3.X) / w"
node n00y04 Math
	set expr "(m.C0.Y * p.X + m.C1.Y * p.Y + m.C2.Y * p.Z + m.C3.Y) / w"
node n00y05 Math
	set expr "(m.C0.Z * p.X + m.C1.Z * p.Y + m.C2.Z * p.Z + m.C3.Z) / w"
node n00y06 Make Vec3
node n00y07 Return
