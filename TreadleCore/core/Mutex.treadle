	static
	access private
	attr Import treadle_rt rt_mutex_free
param mutex void*

function x0022 rt_mutex_lock
	static
	access private
	attr Import treadle_rt rt_mutex_lock
param mutex void*

function x0023 rt_mutex_unlock
	static
	access private
	attr Import treadle_rt rt_mutex_unlock
param mutex void*

function x0024 rt_mutex_trylock
	static
	access private
	returns int32
	attr Import treadle_rt rt_mutex_trylock
