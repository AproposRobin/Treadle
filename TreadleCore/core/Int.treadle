# treadle 1
type Int class
	namespace Core
	static
	doc "Integers from text and to text: Parse and TryParse (int, which is also int64: the same 64 bits), ToString with a format."

function i0001 Parse
	static
	returns Result<int,ParseError>
	doc "The integer the text holds: an optional - or +, an optional 0x (hex) or 0b (binary) prefix, digits (a ' after a digit is skipped: 1'000). No white space (Trim first). Err: NoValue (empty, no digits), Overflow (outside int's 64 bits; hex and binary too), InvalidChar(position)."
param text StringView
local value int64
local pos int64
sheet body
node a01 Entry
node a02 Break StringView
node a03 Get local:value
node a04 Get local:pos
node a05 Call C.crt.rt_parse_int
node a06 Switch
	case 0
	case 1
	case 2
node a07 Get local:value
node a08 MakeCase Result<int,ParseError>.Ok
node a09 Return
node a10 MakeCase ParseError.NoValue
node a11 MakeCase Result<int,ParseError>.Err
node a12 Return
node a13 MakeCase ParseError.Overflow
node a14 MakeCase Result<int,ParseError>.Err
node a15 Return
node a16 Get local:pos
node a17 MakeCase ParseError.InvalidChar
node a18 MakeCase Result<int,ParseError>.Err
node a19 Return
wire a01.text a02.value
wire a01.then a05.in
wire a02.Length a05.n
wire a03.value a05.out
wire a02.Ptr a05.p
wire a04.value a05.pos
wire a05.then a06.in
wire a05.result a06.value
wire a07.value a08.value
wire a06.case:0 a09.in
wire a08.value a09.value
wire a10.value a11.error
wire a06.case:1 a12.in
wire a11.value a12.value
wire a13.value a14.error
wire a06.case:2 a15.in
wire a14.value a15.value
wire a16.value a17.position
wire a17.value a18.error
wire a06.done a19.in
wire a18.value a19.value

function i0002 TryParse
	static
	returns bool
	doc "True and the number in `parsed` when Parse succeeds; false and 0 otherwise."
param text StringView
out parsed int
sheet body
node b01 Entry
node b02 Call Int.Parse
node b03 Call Result<int,ParseError>.IsOk
node b04 Call Result<int,ParseError>.UnwrapOr
	in fallback 0
node b05 Return
wire b01.then b02.in
wire b01.text b02.text
wire b02.result b03.receiver
wire b02.result b04.receiver
wire b02.then b05.in
wire b04.result b05.parsed
wire b03.result b05.value

function i0003 ToString
	static
	doc "Appends the integer to `into` as `format` says (empty: plain decimal). Specs: F fixed (2 decimals by default: F2), E or e scientific (6), G general (significant digits: 15, a float 7), N fixed with , between thousands (2 decimals, an integer 0), D decimal with at least that many digits, X or x hex and B binary with at least that many digits (D, X and B round a float to an integer; X and B of a negative integer give its 64-bit two's complement); an empty or unknown spec writes the plain form."
param value int
param into String
param format StringView
	default ""
sheet body
node c01 Entry
node c02 Call String.AppendNumber(int,StringView)
node c03 Return
wire c01.format c02.format
wire c01.then c02.in
wire c01.into c02.receiver
wire c01.value c02.value
wire c02.then c03.in
