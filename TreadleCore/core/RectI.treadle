# treadle 1
type RectI struct
	namespace Core
	attr CRepr
	doc "A rectangle of whole numbers X, Y, Width, Height (int32; 16 bytes, the layout of an SDL_Rect): pixels on a screen. It holds the points from X up to but not including X + Width (the same for Y). Every function is Pure."

field X int32

field Y int32

field Width int32

field Height int32

function r000 FromMinMax
	static
	pure
	returns RectI
	doc "The rectangle from (minX, minY) up to (maxX, maxY) (not included)."
param minX int32
param minY int32
param maxX int32
param maxY int32
sheet body
node n00000 Entry
node n00001 Math
	set expr "c - a"
node n00002 Math
	set expr "d - b"
node n00003 Make RectI
node n00004 Return
wire n00000.minX n00001.a
wire n00000.maxX n00001.c
wire n00000.minY n00002.b
wire n00000.maxY n00002.d
wire n00002.result n00003.Height
wire n00001.result n00003.Width
wire n00000.minX n00003.X
wire n00000.minY n00003.Y
wire n00000.then n00004.in
wire n00003.value n00004.value

function r001 Contains
	pure
	returns bool
	doc "True when the pixel (x, y) is inside."
param x int32
param y int32
sheet body
node n00100 Entry
node n00101 This
node n00102 Math
	set expr "x >= r.X && x < r.X + r.Width && y >= r.Y && y < r.Y + r.Height"
node n00103 Return
wire n00101.value n00102.r
wire n00100.x n00102.x
wire n00100.y n00102.y
wire n00100.then n00103.in
wire n00102.result n00103.value

function r002 ContainsPoint
	pure
	returns bool
	doc "True when the point is inside."
param point Vec2
sheet body
node n00200 Entry
node n00201 This
node n00202 Math
	set expr "p.X >= r.X && p.X < r.X + r.Width && p.Y >= r.Y && p.Y < r.Y + r.Height"
node n00203 Return
wire n00200.point n00202.p
wire n00201.value n00202.r
wire n00200.then n00203.in
wire n00202.result n00203.value

function r003 Expanded
	pure
	returns RectI
	doc "Grown by `amount` on every side (a negative amount shrinks it)."
param amount int32
sheet body
node n00300 Entry
node n00301 This
node n00302 Math
	set expr "r.X - d"
node n00303 Math
	set expr "r.Y - d"
node n00304 Math
	set expr "r.Width + d * 2"
node n00305 Math
	set expr "r.Height + d * 2"
node n00306 Make RectI
node n00307 Return
wire n00300.amount n00302.d
wire n00301.value n00302.r
wire n00300.amount n00303.d
wire n00301.value n00303.r
wire n00300.amount n00304.d
wire n00301.value n00304.r
wire n00300.amount n00305.d
wire n00301.value n00305.r
wire n00305.result n00306.Height
wire n00304.result n00306.Width
wire n00302.result n00306.X
wire n00303.result n00306.Y
wire n00300.then n00307.in
wire n00306.value n00307.value

function r004 Translated
	pure
	returns RectI
	doc "Moved by (dx, dy)."
param dx int32
param dy int32
