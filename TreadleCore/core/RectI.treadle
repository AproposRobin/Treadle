function r005 Center
	pure
	returns Vec2
	doc "The middle point (it may fall between pixels)."
sheet body
node n00500 Entry
node n00501 This
node n00502 Math
	set expr "r.X"
node n00503 Cast float
node n00504 Math
	set expr "r.Width"
node n00505 Cast float
node n00506 Math
	set expr "x + w / 2.0f"
