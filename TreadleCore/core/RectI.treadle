function r007 FromRect
	static
	pure
	returns RectI
	doc "The smallest whole-number rectangle that covers `rect` (its edges rounded outwards)."
param rect Rect
sheet body
node n00700 Entry
node n00701 Math
	set expr "Floor(r.X)"
node n00702 Cast int32
node n00703 Math
	set expr "Floor(r.Y)"
node n00704 Cast int32
node n00705 Math
	set expr "Ceil(r.X + r.Width)"
node n00706 Cast int32
node n00707 Math
	set expr "Ceil(r.Y + r.Height)"
node n00708 Cast int32
node n00709 Math
	set expr "b - a"
node n0070a Math
	set expr "b - a"
node n0070b Make RectI
node n0070c Return
wire n00700.rect n00701.r
wire n00701.result n00702.value
wire n00700.rect n00703.r
wire n00703.result n00704.value
wire n00700.rect n00705.r
wire n00705.result n00706.value
wire n00700.rect n00707.r
wire n00707.result n00708.value
wire n00702.result n00709.a
wire n00706.result n00709.b
wire n00704.result n0070a.a
wire n00708.result n0070a.b
wire n0070a.result n0070b.Height
wire n00709.result n0070b.Width
wire n00702.result n0070b.X
wire n00704.result n0070b.Y
wire n00700.then n0070c.in
wire n0070b.value n0070c.value

function r008 Overlaps
	pure
	returns bool
	doc "True when the two share some area (touching edges do not count)."
param other RectI
sheet body
node n00800 Entry
node n00801 This
node n00802 Math
	set expr "a.X < b.X + b.Width && b.X < a.X + a.Width && a.Y < b.Y + b.Height && b.Y < a.Y + a.Height"
node n00803 Return
wire n00801.value n00802.a
wire n00800.other n00802.b
wire n00800.then n00803.in
wire n00802.result n00803.value

function r009 Intersection
	pure
	returns RectI
	doc "The area both cover; when they do not overlap, a rectangle of zero size."
param other RectI
sheet body
node n00900 Entry
node n00901 This
node n00902 Math
	set expr "Max(a.X, b.X)"
node n00903 Math
	set expr "Max(a.Y, b.Y)"
node n00904 Math
	set expr "Min(a.X + a.Width, b.X + b.Width)"
node n00905 Math
	set expr "Min(a.Y + a.Height, b.Y + b.Height)"
node n00906 Math
	set expr "x1 <= x0 || y1 <= y0"
node n00907 Math
	set expr "e ? 0 : x1 - x0"
node n00908 Math
	set expr "e ? 0 : y1 - y0"
node n00909 Make RectI
node n0090a Return
wire n00901.value n00902.a
wire n00900.other n00902.b
wire n00901.value n00903.a
wire n00900.other n00903.b
wire n00901.value n00904.a
wire n00900.other n00904.b
wire n00901.value n00905.a
wire n00900.other n00905.b
wire n00902.result n00906.x0
wire n00904.result n00906.x1
wire n00903.result n00906.y0
wire n00905.result n00906.y1
wire n00906.result n00907.e
wire n00902.result n00907.x0
wire n00904.result n00907.x1
wire n00906.result n00908.e
wire n00903.result n00908.y0
wire n00905.result n00908.y1
wire n00908.result n00909.Height
wire n00907.result n00909.Width
wire n00902.result n00909.X
wire n00903.result n00909.Y
wire n00900.then n0090a.in
wire n00909.value n0090a.value

function r00a Union
	pure
	returns RectI
	doc "The smallest rectangle that covers both."
param other RectI
sheet body
node n00a00 Entry
node n00a01 This
node n00a02 Math
	set expr "Min(a.X, b.X)"
node n00a03 Math
	set expr "Min(a.Y, b.Y)"
node n00a04 Math
	set expr "Max(a.X + a.Width, b.X + b.Width)"
node n00a05 Math
	set expr "Max(a.Y + a.Height, b.Y + b.Height)"
node n00a06 Math
	set expr "x1 - x0"
node n00a07 Math
	set expr "y1 - y0"
node n00a08 Make RectI
node n00a09 Return
wire n00a01.value n00a02.a
wire n00a00.other n00a02.b
wire n00a01.value n00a03.a
wire n00a00.other n00a03.b
wire n00a01.value n00a04.a
wire n00a00.other n00a04.b
wire n00a01.value n00a05.a
wire n00a00.other n00a05.b
wire n00a02.result n00a06.x0
wire n00a04.result n00a06.x1
wire n00a03.result n00a07.y0
wire n00a05.result n00a07.y1
wire n00a07.result n00a08.Height
wire n00a06.result n00a08.Width
wire n00a02.result n00a08.X
wire n00a03.result n00a08.Y
wire n00a00.then n00a09.in
wire n00a08.value n00a09.value

function r00b IsEmpty
	pure
	returns bool
	doc "True when the width or the height is zero or less."
sheet body
node n00b00 Entry
node n00b01 This
node n00b02 Math
	set expr "r.Width <= 0 || r.Height <= 0"
node n00b03 Return
wire n00b01.value n00b02.r
wire n00b00.then n00b03.in
wire n00b02.result n00b03.value

operator r00c ==
	static
	pure
	returns bool
	doc "True when position and size are equal."
param a RectI
param b RectI
sheet body
node n00c00 Entry
node n00c01 Math
	set expr "a.X == b.X && a.Y == b.Y && a.Width == b.Width && a.Height == b.Height"
node n00c02 Return
wire n00c00.a n00c01.a
wire n00c00.b n00c01.b
wire n00c00.then n00c02.in
wire n00c01.result n00c02.value
