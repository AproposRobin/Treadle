# treadle 1
type ProcessHandle class
	namespace Core
	sealed
	doc "A program Process.Start started: Wait for it, read its exit code and captured stdout, or Kill it. The caller owns the handle (Delete it); deleting it does not end the program."

field mHandle void*
	access private

ctor q0001
	access internal
	doc "Takes over the runtime's handle (Process.Start makes it)."
param handle void*
sheet body
node a01 Entry
node a02 Set this.mHandle
node a03 Return
wire a01.then a02.in
wire a01.handle a02.value
wire a02.then a03.in

dtor q0002
	doc "Frees the handle; a program still running keeps running."
sheet body
node b01 Entry
node b02 Get this.mHandle
node b03 Call C.crt.rt_proc_close
node b04 Return
wire b02.value b03.handle
wire b01.then b03.in
wire b03.then b04.in

function q0003 Wait
	returns int
	doc "Waits for the program to end and gives its exit code (Linux: 128 + the signal when a signal ended it). With captured output, reads it to the end first (GetOutput then has all of it)."
sheet body
node c01 Entry
node c02 Get this.mHandle
node c03 Call C.crt.rt_proc_wait
node c04 Cast int
node c05 Return
wire c02.value c03.handle
wire c01.then c03.in
wire c03.result c04.value
wire c03.then c05.in
wire c04.result c05.value

function q0004 HasExited
	returns bool
	doc "True when the program has ended (it does not wait)."
sheet body
node d01 Entry
node d02 Get this.mHandle
node d03 Call C.crt.rt_proc_exited
node d04 Operator !=
	in b 0
node d05 Return
wire d02.value d03.handle
wire d01.then d03.in
wire d03.result d04.a
wire d03.then d05.in
wire d04.result d05.value

function q0005 Kill
	returns bool
	doc "Ends the program at once (Windows: exit code 1; Linux: SIGKILL, 137 from Wait); true when it was running. Wait for it afterwards."
sheet body
node e01 Entry
node e02 Get this.mHandle
node e03 Call C.crt.rt_proc_kill
node e04 Operator !=
	in b 0
node e05 Return
wire e02.value e03.handle
wire e01.then e03.in
wire e03.result e04.a
wire e03.then e05.in
wire e04.result e05.value

function q0006 ExitCode
	returns int
	doc "The exit code (waits for the program first, as Wait does)."
sheet body
node g01 Entry
node g02 Get this.mHandle
node g03 Call C.crt.rt_proc_wait
node g04 Cast int
node g05 Return
wire g02.value g03.handle
wire g01.then g03.in
wire g03.result g04.value
wire g03.then g05.in
wire g04.result g05.value

function q0007 GetOutput
	doc "Appends what the program wrote to its stdout (after waiting for it to end; nothing when Start did not capture the output). Bytes as they came: on Windows lines usually end in \\r\\n."
param into String
local length int64
sheet body
node h01 Entry
node h02 Get this.mHandle
node h03 Call C.crt.rt_proc_wait
node h04 Get local:length
node h05 Call C.crt.rt_proc_output
node h06 Get local:length
node h07 Make StringView
node h08 Call String.Append(StringView)
node h09 Return
wire h02.value h03.handle
wire h01.then h03.in
wire h02.value h05.handle
wire h03.then h05.in
wire h04.value h05.length
wire h06.value h07.Length
wire h05.result h07.Ptr
wire h05.then h08.in
wire h01.into h08.receiver
wire h07.value h08.text
wire h08.then h09.in
