	static
	pure
	returns float
	attr Intrinsic Math.Tan
	doc "The tangent of an angle in radians."
param x float

function q00b Asin
	static
	pure
	returns float
	attr Intrinsic Math.Asin
	doc "The arc sine in radians, -PI/2 to PI/2 (NaN outside -1 to 1)."
param x float

function q00c Acos
	static
	pure
	returns float
	attr Intrinsic Math.Acos
	doc "The arc cosine in radians, 0 to PI (NaN outside -1 to 1)."
param x float

function q00d Atan
	static
	pure
	returns float
	attr Intrinsic Math.Atan
	doc "The arc tangent in radians, -PI/2 to PI/2."
param x float

function q00e Atan2
	static
	pure
	returns float
	attr Intrinsic Math.Atan2
	doc "The angle of the point (x, y) from +X in radians, -PI to PI."
param y float
param x float

