	static
	pure
	returns float
	attr Intrinsic Math.CopySign
	doc "The size of `x` with the sign of `sign`."
param x float
param sign float

function q00h Radians
	static
	pure
	returns float
	doc "Degrees converted to radians."
param degrees float
sheet body
node n00h00 Entry
node n00h01 Math
	set expr "d * 0.0174532925f"
node n00h02 Return
wire n00h00.degrees n00h01.d
wire n00h00.then n00h02.in
wire n00h01.result n00h02.value

function q00i Degrees
	static
	pure
	returns float
	doc "Radians converted to degrees."
param radians float
sheet body
node n00i00 Entry
node n00i01 Math
	set expr "r * 57.2957795f"
node n00i02 Return
wire n00i00.radians n00i01.r
wire n00i00.then n00i02.in
wire n00i01.result n00i02.value

function q00j SmoothStep
	static
	pure
	returns float
	doc "A smooth step from 0 (x at or below e0) to 1 (x at or above e1): t * t * (3 - 2 t) with t clamped."
param e0 float
param e1 float
param x float
sheet body
node n00j00 Entry
node n00j01 Math
	set expr "Clamp((x - a) / (b - a), 0.0f, 1.0f)"
node n00j02 Math
	set expr "t * t * (3.0f - 2.0f * t)"
node n00j03 Return
wire n00j00.e0 n00j01.a
wire n00j00.e1 n00j01.b
wire n00j00.x n00j01.x
wire n00j01.result n00j02.t
wire n00j00.then n00j03.in
wire n00j02.result n00j03.value
