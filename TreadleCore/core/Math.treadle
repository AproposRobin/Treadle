function m0020 Sign
	static
	pure
	returns int
	doc "-1 for a negative number, 0 for zero (and NaN), 1 for a positive one."
param x float
sheet body
node f1 Entry
node f2 Operator >
	in b 0.0f
node f3 Operator <
	in b 0.0f
node f4 Select
	in true -1
	in false 0
node f5 Select
	in true 1
node f6 Return
wire f1.x f2.a
wire f1.x f3.a
wire f3.result f4.condition
wire f2.result f5.condition
wire f4.result f5.false
wire f1.then f6.in
wire f5.result f6.value

function m0021 IsNaN
	static
	pure
	returns bool
	doc "True when the number is NaN (not a number: 0.0f / 0.0f, the square root of a negative number)."
param x float
sheet body
node g1 Entry
node g2 Operator !=
node g3 Return
wire g1.x g2.a
wire g1.x g2.b
wire g1.then g3.in
wire g2.result g3.value

field Tau double
	static
	const
	init 6.283185307179586
	doc "A full turn in radians: 2 PI."

function q000 Tan
	static
	pure
	returns double
	attr Intrinsic Math.Tan
	doc "The tangent of an angle in radians."
param x double

function q001 Asin
	static
	pure
	returns double
	attr Intrinsic Math.Asin
	doc "The arc sine in radians, -PI/2 to PI/2 (NaN outside -1 to 1)."
param x double

function q002 Acos
	static
	pure
	returns double
	attr Intrinsic Math.Acos
	doc "The arc cosine in radians, 0 to PI (NaN outside -1 to 1)."
param x double

function q003 Atan
	static
	pure
	returns double
	attr Intrinsic Math.Atan
	doc "The arc tangent in radians, -PI/2 to PI/2."
param x double

function q004 Atan2
	static
	pure
	returns double
	attr Intrinsic Math.Atan2
	doc "The angle of the point (x, y) from +X in radians, -PI to PI."
param y double
param x double

function q005 Fma
	static
	pure
	returns double
	attr Intrinsic Math.Fma
	doc "a * b + c with one rounding (fused multiply-add)."
param a double
param b double
param c double

function q006 CopySign
	static
	pure
	returns double
	attr Intrinsic Math.CopySign
	doc "The size of `x` with the sign of `sign`."
param x double
param sign double

function q007 Radians
	static
	pure
	returns double
	doc "Degrees converted to radians."
param degrees double
sheet body
node n00700 Entry
node n00701 Math
	set expr "d * 0.017453292519943295"
node n00702 Return
wire n00700.degrees n00701.d
wire n00700.then n00702.in
wire n00701.result n00702.value

function q008 Degrees
	static
	pure
	returns double
	doc "Radians converted to degrees."
param radians double
sheet body
node n00800 Entry
node n00801 Math
	set expr "r * 57.29577951308232"
node n00802 Return
wire n00800.radians n00801.r
wire n00800.then n00802.in
wire n00801.result n00802.value

function q009 SmoothStep
	static
	pure
	returns double
	doc "A smooth step from 0 (x at or below e0) to 1 (x at or above e1): t * t * (3 - 2 t) with t clamped."
param e0 double
param e1 double
param x double
sheet body
node n00900 Entry
node n00901 Math
	set expr "Clamp((x - a) / (b - a), 0.0, 1.0)"
node n00902 Math
	set expr "t * t * (3.0 - 2.0 * t)"
node n00903 Return
wire n00900.e0 n00901.a
wire n00900.e1 n00901.b
wire n00900.x n00901.x
wire n00901.result n00902.t
wire n00900.then n00903.in
wire n00902.result n00903.value

