# treadle 1
type Span struct
	namespace Core
	generic T
	attr CRepr
	doc "A pointer and a length: a view of elements someone else owns."

field Ptr T*

field Length int

function a0001 Slice
	returns Span<T>
	doc "A view of `length` elements from `start` (no copy: valid while the storage lives and is not moved). A range outside the span is a fatal error."
param start int
param length int
local view Span<T>
sheet body
node a01 Entry
node a02 Get this.Length
node a03 Operator <
	in b 0
node a04 Operator <
	in b 0
node a05 Operator ||
node a06 Operator +
node a07 Operator >
node a08 Operator ||
node a09 Branch
node a10 Fatal
	in message "Span.Slice: the range is out of range"
node a11 Scope
	unsafe
node a12 Get this.Ptr
node a13 Call Pointer.Add
node a14 Make Span<T>
node a15 Set local:view
node a16 Get local:view
node a17 Return
wire a01.start a03.a
wire a01.length a04.a
wire a03.result a05.a
wire a04.result a05.b
wire a01.start a06.a
wire a01.length a06.b
wire a06.result a07.a
wire a02.value a07.b
wire a05.result a08.a
wire a07.result a08.b
wire a08.result a09.condition
wire a01.then a09.in
wire a09.true a10.in
wire a09.false a11.in
wire a01.start a13.count
wire a12.value a13.ptr
wire a01.length a14.Length
wire a13.result a14.Ptr
wire a11.body a15.in
wire a14.value a15.value
wire a11.done a17.in
wire a16.value a17.value

function a0002 IsEmpty
	pure
	returns bool
	doc "True when the span has no elements."
sheet body
node b01 Entry
node b02 Get this.Length
node b03 Operator ==
	in b 0
node b04 Return
wire b02.value b03.a
wire b01.then b04.in
wire b03.result b04.value

function a0003 Sort
	doc "Sorts the elements the span views with `comparer` (negative: a before b, 0: equal, positive: a after b): an introsort, O(n log n), in place, not stable."
param comparer delegate:int(T,T)
sheet body
node c01 Entry
node c02 Make Span<T>
node c03 Call Sorting.SortBy
node c04 Return
node c05 Get this.Ptr
node c06 Get this.Length
wire c06.value c02.Length
wire c05.value c02.Ptr
wire c01.comparer c03.comparer
wire c01.then c03.in
wire c02.value c03.items
wire c03.then c04.in

function a0004 Sort
	generic T operator<
	doc "Sorts the elements the span views in ascending order with T's operator <: the same sort as Sort(comparer) with no delegate call per comparison."
sheet body
node d01 Entry
node d02 Make Span<T>
node d03 Call Sorting.Sort
node d04 Return
node d05 Get this.Ptr
node d06 Get this.Length
wire d06.value d02.Length
wire d05.value d02.Ptr
wire d01.then d03.in
wire d02.value d03.items
wire d03.then d04.in
