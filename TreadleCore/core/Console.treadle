# treadle 1
type Console class
	namespace Core
	static
	doc "Text output to the console and line input from it. Write has an overload per kind of value; WriteLine adds a line break."

function c0001 WriteLine
	static
	attr Intrinsic Console.WriteLine(StringView)
	doc "Writes the text and a line break."
param text StringView

function c0002 Write
	static
	attr Intrinsic Console.Write(StringView)
	doc "Writes the text."
param text StringView

function c0003 WriteLine
	static
	doc "Writes a line break."
sheet body
node a1 Entry
node a2 Call Console.WriteLine(StringView)
	in text ""
node a3 Return
wire a1.then a2.in
wire a2.then a3.in

function c0004 Write
	static
	doc "Writes the String."
param value String
sheet body
node b1 Entry
node b2 Call Console.Write(StringView)
node b3 Return
wire b1.then b2.in
wire b1.value b2.text
wire b2.then b3.in

function c0005 Write
	static
	doc "Writes the number in decimal."
param value int
sheet body
node c1 Entry
node c2 Local String
node c3 Call String.Append(int)
node c4 Call Console.Write(StringView)
node c5 Return
wire c1.then c2.in
wire c2.then c3.in
wire c2.object c3.receiver
wire c1.value c3.value
wire c3.then c4.in
wire c2.object c4.text
wire c4.then c5.in

