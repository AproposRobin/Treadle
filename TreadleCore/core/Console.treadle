function c0012 ReadLine
	static
	returns bool
	doc "Reads one line from the console into the String (appended, without the line break). False at the end of the input when nothing was read."
param into String
local c int32
local any bool
sheet body
node y1 Break
node y2 Operator !=
	in b 13
node y3 Branch
node y4 Cast char8
node y5 Call String.Append(char8)
node y6 Set local:any
	in value true
node y7 Get local:any
node y8 Operator ||
node y9 Return
node z1 Entry
node z2 While
	in condition true
node z3 Call C.crt.getchar
node z4 Set local:c
node z5 Get local:c
node z6 Operator ==
	in b -1
node z7 Operator ==
	in b 10
node z8 Operator ||
node z9 Branch
wire z9.true y1.in
wire z5.value y2.a
wire y2.result y3.condition
wire z9.false y3.in
wire z5.value y4.value
wire y3.true y5.in
wire z1.into y5.receiver
wire y4.result y5.value
wire y5.then y6.in
wire y7.value y8.a
wire z7.result y8.b
wire z2.done y9.in
wire y8.result y9.value
wire z1.then z2.in
wire z2.body z3.in
wire z3.then z4.in
wire z3.result z4.value
wire z5.value z6.a
wire z5.value z7.a
wire z6.result z8.a
wire z7.result z8.b
wire z8.result z9.condition
wire z4.then z9.in

function c0013 Error
	static
	attr Intrinsic Console.Error(StringView)
	doc "Writes the text to the error output (stderr), after flushing what Write and WriteLine wrote."
param text StringView

function c0014 ErrorLine
	static
	doc "Writes the text and a line break to the error output (stderr)."
param text StringView
sheet body
node ea Entry
node eb Call Console.Error(StringView)
node ec Call Console.Error(StringView)
	in text "\n"
node ed Return
wire ea.then eb.in
wire ea.text eb.text
wire eb.then ec.in
wire ec.then ed.in
