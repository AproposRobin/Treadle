# treadle 1
type DictionaryEnumerator struct
	namespace Core
	generic K IHashable
	generic V
	doc "Walks a Dictionary for For Each: each element is a (key, value) tuple (Break it for item0 and item1)."

field mDict Dictionary<K,V>
	access internal

field mIndex int
	access internal

function e0001 MoveNext
	mutating
	returns bool
	doc "Steps to the next key in use; false after the last."
sheet body
node a1 Entry
node a2 Set this.mIndex
	set op +=
	in value 1
node a3 Get this.mIndex
node a4 Get this.mDict
node a5 Get Dictionary<K,V>.mCapacity
node a6 Operator <
node a7 Get Dictionary<K,V>.mStates
node a8 Index
node a9 Operator !=
	in b 1
node b1 Operator &&
node b2 While
node b3 Set this.mIndex
	set op +=
	in value 1
node b4 Return
wire a1.then a2.in
wire a4.value a5.receiver
wire a3.value a6.a
wire a5.value a6.b
wire a4.value a7.receiver
wire a7.value a8.collection
wire a3.value a8.index
wire a8.value a9.a
wire a6.result b1.a
wire a9.result b1.b
wire b1.result b2.condition
wire a2.then b2.in
wire b2.body b3.in
wire b2.done b4.in
wire a6.result b4.value

property e0002 Current (K,V)
	doc "The key and value MoveNext stepped to."
sheet get
node c1 Entry
node c2 Get this.mDict
node c3 Get Dictionary<K,V>.mKeys
node c4 Get Dictionary<K,V>.mValues
node c5 Get this.mIndex
node c6 Index
node c7 Index
node c8 Make (K,V)
node c9 Return
wire c2.value c3.receiver
wire c2.value c4.receiver
