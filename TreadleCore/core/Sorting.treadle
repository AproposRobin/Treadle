function b0005 IntroBy
	static
	unsafe
	access internal
	generic T
	doc "Introsort of the elements from `lo` up to (not including) `hi`: quicksort partitions around the median of the first, middle and last elements (Hoare's scheme, so runs of equal elements split evenly); the smaller side is sorted by a recursive call, the larger by the loop; ranges of 16 or fewer elements go to InsertionBy, and a range still partitioning after `depth` rounds goes to HeapBy."
param p T*
param lo int
param hi int
param depth int
param comparer delegate:int(T,T)
local l int
local h int
local d int
local m int
local last int
local i int
local j int
local pv T
