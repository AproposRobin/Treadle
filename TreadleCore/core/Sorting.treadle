node i14 Return
node i15 Set local:d
	set op -=
	in value 1
node i16 Set local:m
node i17 Math
	set expr "l + (h - l) / 2"
node i18 Set local:last
node i19 Operator -
	in b 1
node i20 Call this.LessBy
node i21 Get local:m
