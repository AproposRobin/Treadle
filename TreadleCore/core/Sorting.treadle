function b0006 SortBy
	static
	access internal
	generic T
	doc "Sorts the elements of `items` (in place, not stable): IntroBy with a depth limit of 2 log2 n."
param items Span<T>
param comparer delegate:int(T,T)
local k int
local d int
sheet body
node s01 Entry
node s02 Get Span<T>.Length
node s03 Operator <
	in b 2
node s04 Branch
node s05 Return
node s06 Set local:k
node s07 While
node s08 Get local:k
node s09 Operator >
	in b 1
node s10 Set local:k
	set op /=
	in value 2
node s11 Set local:d
	set op +=
	in value 2
node s12 Scope
	unsafe
node s13 Get Span<T>.Ptr
node s14 Call this.IntroBy
	in lo 0
node s15 Get local:d
node s16 Return
