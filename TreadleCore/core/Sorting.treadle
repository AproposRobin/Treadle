node w02 Set local:t
node w03 Call Pointer.Load
node w04 Call Pointer.Store
node w05 Call Pointer.Load
node w06 Call Pointer.Store
node w07 Get local:t
node w08 Return
wire w01.then w02.in
wire w03.result w02.value
wire w01.a w03.ptr
wire w02.then w04.in
wire w01.a w04.ptr
wire w05.result w04.value
wire w01.b w05.ptr
wire w04.then w06.in
wire w01.b w06.ptr
wire w07.value w06.value
wire w06.then w08.in

