function q00c Inverse
	pure
	returns Quat
	doc "The inverse: the conjugate divided by the squared length (zero stays zero)."
sheet body
node n00c00 Entry
node n00c01 This
node n00c02 Math
	set expr "q.X * q.X + q.Y * q.Y + q.Z * q.Z + q.W * q.W"
node n00c03 Math
	set expr "d > 0.0f ? 1.0f / d : 0.0f"
node n00c04 Math
	set expr "-q.X * k"
node n00c05 Math
	set expr "-q.Y * k"
node n00c06 Math
	set expr "-q.Z * k"
node n00c07 Math
	set expr "q.W * k"
node n00c08 Make Quat
node n00c09 Return
