function q00a FromTo
	static
	pure
	returns Quat
	doc "The shortest rotation that turns the direction `from` to `to` (any length but zero); opposite directions turn half a turn about an axis perpendicular to `from`."
param from Vec3
param to Vec3
sheet body
node n00a00 Entry
node n00a01 Call Core.Vec3.Normalized
node n00a02 Call Core.Vec3.Normalized
node n00a03 Call Core.Vec3.Dot
node n00a04 Call Core.Vec3.Cross
node n00a05 Math
	set expr "Sqrt((1.0f + d) * 2.0f)"
node n00a06 Math
	set expr "c.X / s"
node n00a07 Math
	set expr "c.Y / s"
node n00a08 Math
	set expr "c.Z / s"
node n00a09 Math
	set expr "s * 0.5f"
node n00a0a Make Quat
node n00a0b Get Core.Vec3.UnitX
node n00a0c Call Core.Vec3.Cross
node n00a0d Get Core.Vec3.UnitY
node n00a0e Call Core.Vec3.Cross
node n00a0f Math
	set expr "a.X * a.X + a.Y * a.Y + a.Z * a.Z > 0.000001f"
node n00a0g Select
node n00a0h Call Core.Vec3.Normalized
node n00a0i Math
	set expr "a.X"
node n00a0j Math
	set expr "a.Y"
node n00a0k Math
	set expr "a.Z"
node n00a0l Make Quat
	in W 0.0f
node n00a0m Math
	set expr "d < -0.999999f"
node n00a0n Select
node n00a0o Math
	set expr "d > 0.999999f"
node n00a0p Get Core.Quat.Identity
node n00a0q Select
node n00a0r Return
