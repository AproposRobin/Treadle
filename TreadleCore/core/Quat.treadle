function q00h Slerp
	pure
	returns Quat
	doc "The rotation `t` of the way to `to` along the shortest arc at an even speed (spherical interpolation; very close rotations blend straight)."
param to Quat
param t float
sheet body
node n00h00 Entry
node n00h01 This
node n00h02 Math
	set expr "a.X * b.X + a.Y * b.Y + a.Z * b.Z + a.W * b.W"
node n00h03 Math
	set expr "d < 0.0f ? -1.0f : 1.0f"
node n00h04 Math
	set expr "b.X * s"
node n00h05 Math
	set expr "b.Y * s"
node n00h06 Math
	set expr "b.Z * s"
node n00h07 Math
	set expr "b.W * s"
node n00h08 Make Quat
node n00h09 Math
	set expr "d * s"
node n00h0a Math
	set expr "Acos(Min(c, 1.0f))"
node n00h0b Math
	set expr "Sin(x)"
node n00h0c Math
	set expr "c > 0.9995f ? 1.0f - t : Sin((1.0f - t) * x) / n"
node n00h0d Math
	set expr "c > 0.9995f ? t : Sin(t * x) / n"
node n00h0e Math
	set expr "a.X * k + b.X * j"
node n00h0f Math
	set expr "a.Y * k + b.Y * j"
node n00h0g Math
	set expr "a.Z * k + b.Z * j"
node n00h0h Math
	set expr "a.W * k + b.W * j"
node n00h0i Make Quat
node n00h0j Math
	set expr "c > 0.9995f"
node n00h0k Math
	set expr "Sqrt(q.X * q.X + q.Y * q.Y + q.Z * q.Z + q.W * q.W)"
node n00h0l Math
	set expr "l > 0.0f ? 1.0f / l : 0.0f"
node n00h0m Math
	set expr "q.X * k"
node n00h0n Math
	set expr "q.Y * k"
node n00h0o Math
	set expr "q.Z * k"
node n00h0p Math
	set expr "q.W * k"
node n00h0q Make Quat
node n00h0r Math
	set expr "l > 0.0f"
node n00h0s Get Core.Quat.Identity
node n00h0t Select
node n00h0u Select
node n00h0v Return
