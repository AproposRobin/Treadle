function q008 FromMat3
	static
	pure
	returns Quat
	doc "The rotation of a 3x3 rotation matrix (orthonormal, no scale)."
param m Mat3
sheet body
node n00800 Entry
node n00801 Math
	set expr "m.C0.X + m.C1.Y + m.C2.Z"
node n00802 Math
	set expr "m.C0.X - m.C1.Y - m.C2.Z"
node n00803 Math
	set expr "m.C1.Y - m.C0.X - m.C2.Z"
node n00804 Math
	set expr "m.C2.Z - m.C0.X - m.C1.Y"
node n00805 Math
	set expr "x > w ? 1 : 0"
node n00806 Math
	set expr "x > w ? x : w"
node n00807 Math
	set expr "y > b ? 2 : i"
node n00808 Math
	set expr "y > b ? y : b"
node n00809 Math
	set expr "z > b ? 3 : i"
node n0080a Math
	set expr "z > b ? z : b"
node n0080b Math
	set expr "Sqrt(f + 1.0f) * 0.5f"
node n0080c Math
	set expr "0.25f / v"
node n0080d Math
	set expr "i == 0 ? (m.C1.Z - m.C2.Y) * k : i == 1 ? v : i == 2 ? (m.C0.Y + m.C1.X) * k : (m.C2.X + m.C0.Z) * k"
node n0080e Math
	set expr "i == 0 ? (m.C2.X - m.C0.Z) * k : i == 1 ? (m.C0.Y + m.C1.X) * k : i == 2 ? v : (m.C1.Z + m.C2.Y) * k"
node n0080f Math
	set expr "i == 0 ? (m.C0.Y - m.C1.X) * k : i == 1 ? (m.C2.X + m.C0.Z) * k : i == 2 ? (m.C1.Z + m.C2.Y) * k : v"
node n0080g Math
	set expr "i == 0 ? v : i == 1 ? (m.C1.Z - m.C2.Y) * k : i == 2 ? (m.C2.X - m.C0.Z) * k : (m.C0.Y - m.C1.X) * k"
node n0080h Make Quat
node n0080i Return
