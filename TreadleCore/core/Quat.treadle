# treadle 1
type Quat struct
	namespace Core
	attr CRepr
	doc "A rotation as a unit quaternion (X, Y, Z the vector part, W the real part; 16 bytes). a * b rotates by b first, then a. Every function is Pure."

field X float

field Y float

field Z float

field W float

property q000 Identity Quat
	static
	doc "No rotation: (0, 0, 0, 1)."
sheet get
node n00000 Entry
node n00001 Make Quat
	in X 0.0f
	in Y 0.0f
	in Z 0.0f
	in W 1.0f
node n00002 Return
wire n00000.then n00002.in
wire n00001.value n00002.value

operator q001 *
	static
	pure
	returns Quat
	doc "The rotation b, then a (the Hamilton product)."
param a Quat
param b Quat
sheet body
node n00100 Entry
node n00101 Math
	set expr "a.W * b.X + a.X * b.W + a.Y * b.Z - a.Z * b.Y"
node n00102 Math
	set expr "a.W * b.Y - a.X * b.Z + a.Y * b.W + a.Z * b.X"
node n00103 Math
	set expr "a.W * b.Z + a.X * b.Y - a.Y * b.X + a.Z * b.W"
node n00104 Math
	set expr "a.W * b.W - a.X * b.X - a.Y * b.Y - a.Z * b.Z"
node n00105 Make Quat
node n00106 Return
wire n00100.a n00101.a
wire n00100.b n00101.b
wire n00100.a n00102.a
wire n00100.b n00102.b
wire n00100.a n00103.a
wire n00100.b n00103.b
wire n00100.a n00104.a
wire n00100.b n00104.b
wire n00104.result n00105.W
wire n00101.result n00105.X
wire n00102.result n00105.Y
wire n00103.result n00105.Z
wire n00100.then n00106.in
wire n00105.value n00106.value

operator q002 ==
	static
	pure
	returns bool
	doc "True when every component is equal (exact; q and -q are the same rotation but not ==)."
param a Quat
param b Quat
sheet body
node n00200 Entry
node n00201 Math
	set expr "a.X == b.X && a.Y == b.Y && a.Z == b.Z && a.W == b.W"
node n00202 Return
wire n00200.a n00201.a
wire n00200.b n00201.b
wire n00200.then n00202.in
wire n00201.result n00202.value

operator q003 *
	static
	pure
	returns Vec3
	doc "The vector `v` rotated by `q`."
param q Quat
param v Vec3
sheet body
node n00300 Entry
node n00301 Math
	set expr "q.Y * v.Z - q.Z * v.Y"
node n00302 Math
	set expr "q.Z * v.X - q.X * v.Z"
node n00303 Math
	set expr "q.X * v.Y - q.Y * v.X"
node n00304 Make Vec3
node n00305 Math
	set expr "q.Y * u.Z - q.Z * u.Y"
node n00306 Math
	set expr "q.Z * u.X - q.X * u.Z"
node n00307 Math
	set expr "q.X * u.Y - q.Y * u.X"
node n00308 Math
	set expr "v.X + (u.X * q.W + w) * 2.0f"
node n00309 Math
	set expr "v.Y + (u.Y * q.W + w) * 2.0f"
node n0030a Math
	set expr "v.Z + (u.Z * q.W + w) * 2.0f"
node n0030b Make Vec3
node n0030c Return
wire n00300.q n00301.q
wire n00300.v n00301.v
wire n00300.q n00302.q
wire n00300.v n00302.v
wire n00300.q n00303.q
wire n00300.v n00303.v
