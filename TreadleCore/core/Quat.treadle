function q006 FromAxisAngle
	static
	pure
	returns Quat
	doc "A rotation of `angle` radians about the unit vector `axis` (counter-clockwise looking down the axis)."
param axis Vec3
param angle float
sheet body
node n00600 Entry
node n00601 Math
	set expr "x * 0.5f"
node n00602 Math
	set expr "Sin(h)"
node n00603 Math
	set expr "a.X * s"
node n00604 Math
	set expr "a.Y * s"
node n00605 Math
	set expr "a.Z * s"
node n00606 Math
	set expr "Cos(h)"
node n00607 Make Quat
node n00608 Return
wire n00600.angle n00601.x
wire n00601.result n00602.h
wire n00600.axis n00603.a
wire n00602.result n00603.s
wire n00600.axis n00604.a
wire n00602.result n00604.s
wire n00600.axis n00605.a
wire n00602.result n00605.s
wire n00601.result n00606.h
