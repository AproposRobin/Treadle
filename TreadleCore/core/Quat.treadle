function q00l ToAxisAngle
	pure
	returns float
	doc "The angle in radians (0 to 2 PI) and the unit `axis` of the rotation; no rotation gives the X axis."
out axis Vec3
sheet body
node n00l00 Entry
node n00l01 This
node n00l02 Math
	set expr "Clamp(q.W, -1.0f, 1.0f)"
node n00l03 Math
	set expr "Sqrt(1.0f - w * w)"
node n00l04 Math
	set expr "s < 0.000001f"
node n00l05 Math
	set expr "k ? 1.0f : q.X / s"
node n00l06 Math
	set expr "k ? 0.0f : q.Y / s"
node n00l07 Math
	set expr "k ? 0.0f : q.Z / s"
node n00l08 Make Vec3
node n00l09 Math
	set expr "2.0f * Acos(w)"
node n00l0a Return
wire n00l01.value n00l02.q
wire n00l02.result n00l03.w
wire n00l03.result n00l04.s
wire n00l04.result n00l05.k
wire n00l01.value n00l05.q
wire n00l03.result n00l05.s
wire n00l04.result n00l06.k
wire n00l01.value n00l06.q
wire n00l03.result n00l06.s
wire n00l04.result n00l07.k
wire n00l01.value n00l07.q
wire n00l03.result n00l07.s
wire n00l05.result n00l08.X
wire n00l06.result n00l08.Y
wire n00l07.result n00l08.Z
wire n00l02.result n00l09.w
wire n00l08.value n00l0a.axis
wire n00l00.then n00l0a.in
wire n00l09.result n00l0a.value

function q00m ToEuler
	pure
	returns Vec3
	doc "The angles FromEuler takes, as (pitch, yaw, roll) in radians; pitch is -PI/2 to PI/2 (at the poles roll is 0)."
sheet body
node n00m00 Entry
node n00m01 This
node n00m02 Math
	set expr "2.0f * (q.Y * q.Z - q.W * q.X)"
node n00m03 Math
	set expr "Abs(s) > 0.99999f"
node n00m04 Math
	set expr "Asin(Clamp(-s, -1.0f, 1.0f))"
node n00m05 Math
	set expr "p ? Atan2(-2.0f * (q.X * q.Z - q.W * q.Y), 1.0f - 2.0f * (q.Y * q.Y + q.Z * q.Z)) : Atan2(2.0f * (q.X * q.Z + q.W * q.Y), 1.0f - 2.0f * (q.X * q.X + q.Y * q.Y))"
node n00m06 Math
	set expr "p ? 0.0f : Atan2(2.0f * (q.X * q.Y + q.W * q.Z), 1.0f - 2.0f * (q.X * q.X + q.Z * q.Z))"
node n00m07 Make Vec3
node n00m08 Return
wire n00m01.value n00m02.q
wire n00m02.result n00m03.s
wire n00m02.result n00m04.s
wire n00m03.result n00m05.p
wire n00m01.value n00m05.q
wire n00m03.result n00m06.p
wire n00m01.value n00m06.q
wire n00m04.result n00m07.X
wire n00m05.result n00m07.Y
wire n00m06.result n00m07.Z
wire n00m00.then n00m08.in
wire n00m07.value n00m08.value

function q00n ApproxEquals
	pure
	returns bool
	doc "True when the components are within `epsilon` (absolute) of the other's or of their negation (q and -q are the same rotation)."
param other Quat
param epsilon float
	default 0.00001f
sheet body
node n00n00 Entry
node n00n01 This
node n00n02 Math
	set expr "(Abs(q.X - o.X) <= e && Abs(q.Y - o.Y) <= e && Abs(q.Z - o.Z) <= e && Abs(q.W - o.W) <= e) || (Abs(q.X + o.X) <= e && Abs(q.Y + o.Y) <= e && Abs(q.Z + o.Z) <= e && Abs(q.W + o.W) <= e)"
node n00n03 Return
wire n00n00.epsilon n00n02.e
wire n00n00.other n00n02.o
wire n00n01.value n00n02.q
wire n00n00.then n00n03.in
wire n00n02.result n00n03.value
