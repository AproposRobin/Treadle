function q009 LookRotation
	static
	pure
	returns Quat
	doc "The rotation that turns -Z to `forward` and keeps Y as close to `up` as it can."
param forward Vec3
param up Vec3
sheet body
node n00900 Entry
node n00901 Call Core.Vec3.Normalized
node n00902 Call Core.Vec3.Scaled
	in k -1.0f
node n00903 Call Core.Vec3.Cross
node n00904 Call Core.Vec3.Normalized
node n00905 Call Core.Vec3.Cross
node n00906 Make Mat3
node n00907 Math
	set expr "m.C0.X + m.C1.Y + m.C2.Z"
node n00908 Math
	set expr "m.C0.X - m.C1.Y - m.C2.Z"
node n00909 Math
	set expr "m.C1.Y - m.C0.X - m.C2.Z"
node n0090a Math
	set expr "m.C2.Z - m.C0.X - m.C1.Y"
node n0090b Math
	set expr "x > w ? 1 : 0"
node n0090c Math
	set expr "x > w ? x : w"
node n0090d Math
	set expr "y > b ? 2 : i"
node n0090e Math
	set expr "y > b ? y : b"
node n0090f Math
	set expr "z > b ? 3 : i"
node n0090g Math
	set expr "z > b ? z : b"
node n0090h Math
	set expr "Sqrt(f + 1.0f) * 0.5f"
node n0090i Math
	set expr "0.25f / v"
node n0090j Math
	set expr "i == 0 ? (m.C1.Z - m.C2.Y) * k : i == 1 ? v : i == 2 ? (m.C0.Y + m.C1.X) * k : (m.C2.X + m.C0.Z) * k"
node n0090k Math
	set expr "i == 0 ? (m.C2.X - m.C0.Z) * k : i == 1 ? (m.C0.Y + m.C1.X) * k : i == 2 ? v : (m.C1.Z + m.C2.Y) * k"
node n0090l Math
	set expr "i == 0 ? (m.C0.Y - m.C1.X) * k : i == 1 ? (m.C2.X + m.C0.Z) * k : i == 2 ? (m.C1.Z + m.C2.Y) * k : v"
node n0090m Math
	set expr "i == 0 ? v : i == 1 ? (m.C1.Z - m.C2.Y) * k : i == 2 ? (m.C2.X - m.C0.Z) * k : (m.C0.Y - m.C1.X) * k"
node n0090n Make Quat
node n0090o Return
