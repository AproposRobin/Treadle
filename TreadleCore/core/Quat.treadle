function q00i AngleTo
	pure
	returns float
	doc "The angle in radians of the rotation from this one to `b` (unit quaternions), 0 to PI."
param b Quat
sheet body
node n00i00 Entry
node n00i01 This
node n00i02 Math
	set expr "2.0f * Acos(Min(Abs(q.X * b.X + q.Y * b.Y + q.Z * b.Z + q.W * b.W), 1.0f))"
node n00i03 Return
wire n00i00.b n00i02.b
wire n00i01.value n00i02.q
wire n00i00.then n00i03.in
wire n00i02.result n00i03.value

function q00j ToMat3
	pure
	returns Mat3
	doc "The rotation as a 3x3 matrix (this must be a unit quaternion)."
sheet body
node n00j00 Entry
node n00j01 This
node n00j02 Math
	set expr "q.X * q.X"
node n00j03 Math
	set expr "q.Y * q.Y"
node n00j04 Math
	set expr "q.Z * q.Z"
node n00j05 Math
	set expr "q.X * q.Z"
node n00j06 Math
	set expr "q.X * q.Y"
node n00j07 Math
	set expr "q.Y * q.Z"
node n00j08 Math
	set expr "q.W * q.X"
node n00j09 Math
	set expr "q.W * q.Y"
node n00j0a Math
	set expr "q.W * q.Z"
node n00j0b Math
	set expr "1.0f - 2.0f * (yy + zz)"
node n00j0c Math
	set expr "2.0f * (xy + wz)"
node n00j0d Math
	set expr "2.0f * (xz - wy)"
node n00j0e Make Vec3
node n00j0f Math
	set expr "2.0f * (xy - wz)"
node n00j0g Math
	set expr "1.0f - 2.0f * (xx + zz)"
node n00j0h Math
	set expr "2.0f * (yz + wx)"
node n00j0i Make Vec3
node n00j0j Math
	set expr "2.0f * (xz + wy)"
node n00j0k Math
	set expr "2.0f * (yz - wx)"
node n00j0l Math
	set expr "1.0f - 2.0f * (xx + yy)"
node n00j0m Make Vec3
node n00j0n Make Mat3
node n00j0o Return
