function q00g Nlerp
	pure
	returns Quat
	doc "The straight blend `t` of the way to `to` (the shorter way), normalized: cheaper than Slerp, not at an even speed."
param to Quat
param t float
sheet body
node n00g00 Entry
node n00g01 This
node n00g02 Math
	set expr "a.X * b.X + a.Y * b.Y + a.Z * b.Z + a.W * b.W"
node n00g03 Math
	set expr "d < 0.0f ? -1.0f : 1.0f"
node n00g04 Math
	set expr "b.X * s"
node n00g05 Math
	set expr "b.Y * s"
node n00g06 Math
	set expr "b.Z * s"
node n00g07 Math
	set expr "b.W * s"
node n00g08 Make Quat
node n00g09 Math
	set expr "a.X + (b.X - a.X) * t"
node n00g0a Math
	set expr "a.Y + (b.Y - a.Y) * t"
node n00g0b Math
	set expr "a.Z + (b.Z - a.Z) * t"
node n00g0c Math
	set expr "a.W + (b.W - a.W) * t"
node n00g0d Make Quat
node n00g0e Math
	set expr "Sqrt(q.X * q.X + q.Y * q.Y + q.Z * q.Z + q.W * q.W)"
node n00g0f Math
	set expr "l > 0.0f ? 1.0f / l : 0.0f"
node n00g0g Math
	set expr "q.X * k"
node n00g0h Math
	set expr "q.Y * k"
node n00g0i Math
	set expr "q.Z * k"
node n00g0j Math
	set expr "q.W * k"
node n00g0k Make Quat
node n00g0l Math
	set expr "l > 0.0f"
node n00g0m Get Core.Quat.Identity
node n00g0n Select
node n00g0o Return
