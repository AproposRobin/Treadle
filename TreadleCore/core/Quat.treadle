function q005 Rotate
	pure
	returns Vec3
	doc "The vector `v` rotated by this quaternion."
param v Vec3
sheet body
node n00500 Entry
node n00501 This
node n00502 Math
	set expr "q.Y * v.Z - q.Z * v.Y"
node n00503 Math
	set expr "q.Z * v.X - q.X * v.Z"
node n00504 Math
	set expr "q.X * v.Y - q.Y * v.X"
node n00505 Make Vec3
node n00506 Math
	set expr "q.Y * u.Z - q.Z * u.Y"
node n00507 Math
	set expr "q.Z * u.X - q.X * u.Z"
node n00508 Math
	set expr "q.X * u.Y - q.Y * u.X"
node n00509 Math
	set expr "v.X + (u.X * q.W + w) * 2.0f"
node n0050a Math
	set expr "v.Y + (u.Y * q.W + w) * 2.0f"
node n0050b Math
	set expr "v.Z + (u.Z * q.W + w) * 2.0f"
node n0050c Make Vec3
node n0050d Return
