wire n00603.result n00607.X
wire n00604.result n00607.Y
wire n00605.result n00607.Z
wire n00600.then n00608.in
wire n00607.value n00608.value

function q007 FromEuler
	static
	pure
	returns Quat
	doc "Angles in radians applied roll about Z, then pitch about X, then yaw about Y."
param pitch float
param yaw float
param roll float
sheet body
node n00700 Entry
node n00701 Get Core.Vec3.UnitY
node n00702 Call Core.Quat.FromAxisAngle
node n00703 Get Core.Vec3.UnitX
node n00704 Call Core.Quat.FromAxisAngle
node n00705 Get Core.Vec3.UnitZ
node n00706 Call Core.Quat.FromAxisAngle
node n00707 Math
	set expr "a.W * b.X + a.X * b.W + a.Y * b.Z - a.Z * b.Y"
node n00708 Math
	set expr "a.W * b.Y - a.X * b.Z + a.Y * b.W + a.Z * b.X"
node n00709 Math
	set expr "a.W * b.Z + a.X * b.Y - a.Y * b.X + a.Z * b.W"
node n0070a Math
	set expr "a.W * b.W - a.X * b.X - a.Y * b.Y - a.Z * b.Z"
node n0070b Make Quat
node n0070c Math
	set expr "a.W * b.X + a.X * b.W + a.Y * b.Z - a.Z * b.Y"
node n0070d Math
	set expr "a.W * b.Y - a.X * b.Z + a.Y * b.W + a.Z * b.X"
node n0070e Math
	set expr "a.W * b.Z + a.X * b.Y - a.Y * b.X + a.Z * b.W"
node n0070f Math
	set expr "a.W * b.W - a.X * b.X - a.Y * b.Y - a.Z * b.Z"
node n0070g Make Quat
node n0070h Return
