operator m008 ==
	static
	pure
	returns bool
	doc "True when every element is equal (exact)."
param a Mat3
param b Mat3
sheet body
node n00800 Entry
node n00801 Math
	set expr "a.C0.X == b.C0.X && a.C0.Y == b.C0.Y && a.C0.Z == b.C0.Z && a.C1.X == b.C1.X && a.C1.Y == b.C1.Y && a.C1.Z == b.C1.Z && a.C2.X == b.C2.X && a.C2.Y == b.C2.Y && a.C2.Z == b.C2.Z"
node n00802 Return
wire n00800.a n00801.a
wire n00800.b n00801.b
wire n00800.then n00802.in
wire n00801.result n00802.value

