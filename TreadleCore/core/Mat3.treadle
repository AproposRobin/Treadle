# treadle 1
type Mat3 struct
	namespace Core
	attr CRepr
	doc "A 3x3 matrix of floats in columns C0..C2 (column-major, 36 bytes, as GLSL and Vulkan lay it out): M * v transforms a column vector. Every function is Pure."

field C0 Vec3
	doc "Column 0."

field C1 Vec3
	doc "Column 1."

field C2 Vec3
	doc "Column 2."

property m000 Identity Mat3
	static
	doc "Ones on the diagonal, zeros elsewhere."
sheet get
node n00000 Entry
node n00001 Make Vec3
	in X 1.0f
	in Y 0.0f
	in Z 0.0f
node n00002 Make Vec3
	in X 0.0f
	in Y 1.0f
	in Z 0.0f
node n00003 Make Vec3
	in X 0.0f
	in Y 0.0f
	in Z 1.0f
node n00004 Make Mat3
node n00005 Return
wire n00001.value n00004.C0
wire n00002.value n00004.C1
wire n00003.value n00004.C2
wire n00000.then n00005.in
wire n00004.value n00005.value

property m001 Zero Mat3
	static
	doc "All zeros."
sheet get
node n00100 Entry
node n00101 Make Vec3
	in X 0.0f
	in Y 0.0f
	in Z 0.0f
node n00102 Make Vec3
	in X 0.0f
	in Y 0.0f
	in Z 0.0f
node n00103 Make Vec3
	in X 0.0f
	in Y 0.0f
	in Z 0.0f
node n00104 Make Mat3
node n00105 Return
wire n00101.value n00104.C0
wire n00102.value n00104.C1
wire n00103.value n00104.C2
wire n00100.then n00105.in
wire n00104.value n00105.value

function m002 Get
	pure
	returns float
	doc "The element at `row`, `col` (0-based; an index out of range gives the last one)."
param row int
param col int
sheet body
node n00200 Entry
node n00201 This
node n00202 Math
	set expr "c == 0 ? (r == 0 ? m.C0.X : r == 1 ? m.C0.Y : m.C0.Z) : c == 1 ? (r == 0 ? m.C1.X : r == 1 ? m.C1.Y : m.C1.Z) : (r == 0 ? m.C2.X : r == 1 ? m.C2.Y : m.C2.Z)"
node n00203 Return
wire n00200.col n00202.c
wire n00201.value n00202.m
wire n00200.row n00202.r
wire n00200.then n00203.in
wire n00202.result n00203.value

function m003 Column
	pure
	returns Vec3
	doc "Column `index` (0-based; out of range gives the last one)."
param index int
sheet body
node n00300 Entry
node n00301 This
node n00302 Math
	set expr "i == 0 ? m.C0.X : i == 1 ? m.C1.X : m.C2.X"
node n00303 Math
	set expr "i == 0 ? m.C0.Y : i == 1 ? m.C1.Y : m.C2.Y"
node n00304 Math
	set expr "i == 0 ? m.C0.Z : i == 1 ? m.C1.Z : m.C2.Z"
node n00305 Make Vec3
node n00306 Return
wire n00300.index n00302.i
wire n00301.value n00302.m
wire n00300.index n00303.i
wire n00301.value n00303.m
wire n00300.index n00304.i
wire n00301.value n00304.m
wire n00302.result n00305.X
wire n00303.result n00305.Y
wire n00304.result n00305.Z
wire n00300.then n00306.in
wire n00305.value n00306.value

