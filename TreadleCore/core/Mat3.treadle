function m00f Determinant
	pure
	returns float
	doc "The determinant (0 for a matrix that has no inverse)."
sheet body
node n00f00 Entry
node n00f01 This
node n00f02 Math
	set expr "m.C0.X * (m.C1.Y * m.C2.Z - m.C2.Y * m.C1.Z) + m.C0.Y * -(m.C1.X * m.C2.Z - m.C2.X * m.C1.Z) + m.C0.Z * (m.C1.X * m.C2.Y - m.C2.X * m.C1.Y)"
node n00f03 Math
	set expr "d != 0.0f ? 1.0f / d : 0.0f"
node n00f04 Math
	set expr "(m.C1.Y * m.C2.Z - m.C2.Y * m.C1.Z) * k"
node n00f05 Math
	set expr "-(m.C0.Y * m.C2.Z - m.C2.Y * m.C0.Z) * k"
node n00f06 Math
	set expr "(m.C0.Y * m.C1.Z - m.C1.Y * m.C0.Z) * k"
node n00f07 Make Vec3
node n00f08 Math
	set expr "-(m.C1.X * m.C2.Z - m.C2.X * m.C1.Z) * k"
node n00f09 Math
	set expr "(m.C0.X * m.C2.Z - m.C2.X * m.C0.Z) * k"
node n00f0a Math
	set expr "-(m.C0.X * m.C1.Z - m.C1.X * m.C0.Z) * k"
node n00f0b Make Vec3
node n00f0c Math
	set expr "(m.C1.X * m.C2.Y - m.C2.X * m.C1.Y) * k"
node n00f0d Math
	set expr "-(m.C0.X * m.C2.Y - m.C2.X * m.C0.Y) * k"
node n00f0e Math
	set expr "(m.C0.X * m.C1.Y - m.C1.X * m.C0.Y) * k"
node n00f0f Make Vec3
node n00f0g Make Mat3
node n00f0h Return
