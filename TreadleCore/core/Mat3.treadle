function m00i ApproxEquals
	pure
	returns bool
	doc "True when every element is within `epsilon` of the other's (absolute)."
param other Mat3
param epsilon float
	default 0.00001f
sheet body
node n00i00 Entry
node n00i01 This
node n00i02 Math
	set expr "Abs(m.C0.X - o.C0.X) <= e && Abs(m.C0.Y - o.C0.Y) <= e && Abs(m.C0.Z - o.C0.Z) <= e && Abs(m.C1.X - o.C1.X) <= e && Abs(m.C1.Y - o.C1.Y) <= e && Abs(m.C1.Z - o.C1.Z) <= e && Abs(m.C2.X - o.C2.X) <= e && Abs(m.C2.Y - o.C2.Y) <= e && Abs(m.C2.Z - o.C2.Z) <= e"
node n00i03 Return
wire n00i00.epsilon n00i02.e
wire n00i01.value n00i02.m
wire n00i00.other n00i02.o
wire n00i00.then n00i03.in
wire n00i02.result n00i03.value

