operator m005 *
	static
	pure
	returns Mat3
	doc "The matrix product: (a * b) * v is a * (b * v), b applied first."
param a Mat3
param b Mat3
sheet body
node n00500 Entry
node n00501 Math
	set expr "a.C0.X * b.C0.X + a.C1.X * b.C0.Y + a.C2.X * b.C0.Z"
node n00502 Math
	set expr "a.C0.Y * b.C0.X + a.C1.Y * b.C0.Y + a.C2.Y * b.C0.Z"
node n00503 Math
	set expr "a.C0.Z * b.C0.X + a.C1.Z * b.C0.Y + a.C2.Z * b.C0.Z"
node n00504 Make Vec3
node n00505 Math
	set expr "a.C0.X * b.C1.X + a.C1.X * b.C1.Y + a.C2.X * b.C1.Z"
node n00506 Math
	set expr "a.C0.Y * b.C1.X + a.C1.Y * b.C1.Y + a.C2.Y * b.C1.Z"
node n00507 Math
	set expr "a.C0.Z * b.C1.X + a.C1.Z * b.C1.Y + a.C2.Z * b.C1.Z"
node n00508 Make Vec3
node n00509 Math
	set expr "a.C0.X * b.C2.X + a.C1.X * b.C2.Y + a.C2.X * b.C2.Z"
node n0050a Math
	set expr "a.C0.Y * b.C2.X + a.C1.Y * b.C2.Y + a.C2.Y * b.C2.Z"
node n0050b Math
	set expr "a.C0.Z * b.C2.X + a.C1.Z * b.C2.Y + a.C2.Z * b.C2.Z"
node n0050c Make Vec3
node n0050d Make Mat3
node n0050e Return
