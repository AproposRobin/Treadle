function v00u Reflect
	pure
	returns Vec2
	doc "The vector mirrored off a surface with this unit `normal`: v - 2 Dot(v, n) n."
param normal Vec2
sheet body
node n00u00 Entry
node n00u01 This
node n00u02 Math
	set expr "2.0f * (Dot(float2(v.X, v.Y), float2(n.X, n.Y)))"
node n00u03 Math
	set expr "float2(v.X, v.Y) - float2(n.X, n.Y) * k"
node n00u04 Break float2
node n00u05 Make Vec2
node n00u06 Return
wire n00u00.normal n00u02.n
wire n00u01.value n00u02.v
wire n00u02.result n00u03.k
wire n00u00.normal n00u03.n
wire n00u01.value n00u03.v
wire n00u03.result n00u04.value
wire n00u04.x n00u05.X
wire n00u04.y n00u05.Y
wire n00u00.then n00u06.in
wire n00u05.value n00u06.value

function v00v ProjectOnto
	pure
	returns Vec2
	doc "The part of this vector along `b`; a zero `b` gives zero."
param b Vec2
sheet body
node n00v00 Entry
node n00v01 This
node n00v02 Math
	set expr "Dot(float2(b.X, b.Y), float2(b.X, b.Y))"
node n00v03 Math
	set expr "bb > 0.0f ? (Dot(float2(v.X, v.Y), float2(b.X, b.Y))) / bb : 0.0f"
node n00v04 Math
	set expr "float2(b.X, b.Y) * k"
node n00v05 Break float2
node n00v06 Make Vec2
node n00v07 Return
wire n00v00.b n00v02.b
wire n00v00.b n00v03.b
wire n00v02.result n00v03.bb
wire n00v01.value n00v03.v
wire n00v00.b n00v04.b
wire n00v03.result n00v04.k
wire n00v04.result n00v05.value
wire n00v05.x n00v06.X
wire n00v05.y n00v06.Y
wire n00v00.then n00v07.in
wire n00v06.value n00v07.value

function v00w AngleTo
	pure
	returns float
	doc "The angle to `b` in radians, 0 to PI; 0 when either is zero."
param b Vec2
sheet body
node n00w00 Entry
node n00w01 This
node n00w02 Math
	set expr "Sqrt((Dot(float2(v.X, v.Y), float2(v.X, v.Y))) * (Dot(float2(b.X, b.Y), float2(b.X, b.Y))))"
node n00w03 Math
	set expr "d > 0.0f ? Acos(Clamp((Dot(float2(v.X, v.Y), float2(b.X, b.Y))) / d, -1.0f, 1.0f)) : 0.0f"
node n00w04 Return
wire n00w00.b n00w02.b
wire n00w01.value n00w02.v
wire n00w00.b n00w03.b
wire n00w02.result n00w03.d
wire n00w01.value n00w03.v
wire n00w00.then n00w04.in
wire n00w03.result n00w04.value

function v00x IsFinite
	pure
	returns bool
	doc "True when no component is infinite or NaN."
sheet body
node n00x00 Entry
node n00x01 This
node n00x02 Math
	set expr "v.X - v.X == 0.0f && v.Y - v.Y == 0.0f"
node n00x03 Return
wire n00x01.value n00x02.v
wire n00x00.then n00x03.in
wire n00x02.result n00x03.value

function v00y ApproxEquals
	pure
	returns bool
	doc "True when every component is within `epsilon` of the other's (absolute)."
param other Vec2
param epsilon float
	default 0.00001f
sheet body
node n00y00 Entry
node n00y01 This
node n00y02 Math
	set expr "Abs(v.X - o.X) <= e && Abs(v.Y - o.Y) <= e"
node n00y03 Return
wire n00y00.epsilon n00y02.e
wire n00y00.other n00y02.o
wire n00y01.value n00y02.v
wire n00y00.then n00y03.in
wire n00y02.result n00y03.value

