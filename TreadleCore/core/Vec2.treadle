# treadle 1
type Vec2 struct
	namespace Core
	attr CRepr
	doc "A 2D vector of floats (X, Y; 8 bytes, laid out as in C): a position, a direction, a size. Every function is Pure."

field X float

field Y float

property v000 Zero Vec2
	static
	doc "All components 0."
sheet get
node n00000 Entry
node n00001 Make Vec2
	in X 0.0f
	in Y 0.0f
node n00002 Return
wire n00000.then n00002.in
wire n00001.value n00002.value

property v001 One Vec2
	static
	doc "All components 1."
sheet get
node n00100 Entry
node n00101 Make Vec2
	in X 1.0f
	in Y 1.0f
node n00102 Return
wire n00100.then n00102.in
wire n00101.value n00102.value

property v002 UnitX Vec2
	static
	doc "The unit vector along X."
sheet get
node n00200 Entry
node n00201 Make Vec2
	in X 1.0f
	in Y 0.0f
node n00202 Return
wire n00200.then n00202.in
wire n00201.value n00202.value

property v003 UnitY Vec2
	static
	doc "The unit vector along Y."
