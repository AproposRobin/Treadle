node n00k01 This
node n00k02 Math
	set expr "Sqrt(Dot(float2(v.X, v.Y) - float2(b.X, b.Y), float2(v.X, v.Y) - float2(b.X, b.Y)))"
node n00k03 Return
wire n00k00.b n00k02.b
wire n00k01.value n00k02.v
wire n00k00.then n00k03.in
wire n00k02.result n00k03.value

function v00l Normalized
	pure
	returns Vec2
	doc "The vector scaled to length 1; a zero vector gives zero."
sheet body
node n00l00 Entry
node n00l01 This
node n00l02 Math
	set expr "Sqrt(Dot(float2(v.X, v.Y), float2(v.X, v.Y)))"
node n00l03 Math
	set expr "l > 0.0f ? 1.0f / l : 0.0f"
node n00l04 Math
	set expr "float2(v.X, v.Y) * k"
node n00l05 Break float2
node n00l06 Make Vec2
node n00l07 Return
wire n00l01.value n00l02.v
wire n00l02.result n00l03.l
wire n00l03.result n00l04.k
wire n00l01.value n00l04.v
wire n00l04.result n00l05.value
wire n00l05.x n00l06.X
wire n00l05.y n00l06.Y
wire n00l00.then n00l07.in
wire n00l06.value n00l07.value

function v00m Lerp
	pure
	returns Vec2
	doc "The point `t` of the way to `to`: this at 0, `to` at 1 (t is not clamped)."
param to Vec2
param t float
sheet body
node n00m00 Entry
node n00m01 This
node n00m02 Math
	set expr "float2(v.X, v.Y) + (float2(b.X, b.Y) - float2(v.X, v.Y)) * t"
node n00m03 Break float2
node n00m04 Make Vec2
node n00m05 Return
wire n00m00.to n00m02.b
wire n00m00.t n00m02.t
wire n00m01.value n00m02.v
wire n00m02.result n00m03.value
wire n00m03.x n00m04.X
wire n00m03.y n00m04.Y
wire n00m00.then n00m05.in
wire n00m04.value n00m05.value

