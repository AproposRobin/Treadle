function m2 Row
	static
	returns double
	doc "Appends one table row for `text` to `into`: an int (thousands grouped), a double (two decimals) or not a number; gives its value (0 when it is none)."
param text StringView
param into String
sheet body
node b01 Entry
node b02 Call Int.TryParse
node b03 Branch
node b04 Call String.AppendF
	in format "{0,-8}|{1,-7}|{2,10:N0}"
	in arg1 "int"
node b05 Cast double
node b06 Return
node b07 Call Double.TryParse
node b08 Branch
node b09 Call String.AppendF
	in format "{0,-8}|{1,-7}|{2,10:N2}"
	in arg1 "double"
node b10 Return
node b11 Call Int.Parse
node b12 ResultMatch
node b13 Return
	in value 0.0
node b14 Switch
	case InvalidChar
node b15 Call String.AppendF
	in format "{0,-8}|{1,-7}|{2,10}"
	in arg1 "-"
	in arg2 "no number"
node b16 Return
	in value 0.0
node b17 Call String.AppendF
	in format "{0,-8}|{1,-7}|{2,4} at {3}"
	in arg1 "-"
	in arg2 "bad"
node b18 Return
	in value 0.0
node b19 Return
	in value 0.0
