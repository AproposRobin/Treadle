# treadle 1
type Program class
	namespace M3Text
	static
	doc "Milestone 3 text sample: Int / Double TryParse and Parse errors, an AppendF table with alignment and number specs, UTF-8 code points, Process.Start with captured output, Time.Now as a DateTime."

function m1 Main
	static
	returns int
	doc "Parses the arguments (or a built-in list) as numbers into an aligned table with their total, counts the code points of a non-ASCII text, prints what a child process (cmd /c echo on Windows, echo on Linux) wrote and the current year."
param args String[]
local sum double
sheet body
node a01 Entry
node a02 Local List<StringView>
node a03 Get String[].Length
node a04 Operator >
	in b 0
node a05 Branch
node a06 ForEach
node a07 Call List<StringView>.Add
node a08 Literal
	set type StringView
	set value "12 3.5 0x1F -7 abc 1e3 1'000 4x2 zwölf"
node a09 Call StringView.Split
	in separator 32
node a10 Local String
node a11 Call String.AppendF
	in format "{0,-8}|{1,-7}|{2,10}"
	in arg0 "text"
	in arg1 "kind"
	in arg2 "value"
node a12 Call Console.WriteLine(String)
node a13 Call String.Clear
node a14 Call Console.WriteLine(StringView)
	in text "--------+-------+----------"
node a15 ForEach
node a16 Call Program.Row
node a17 Set local:sum
	set op +=
node a18 Call Console.WriteLine(String)
node a19 Call String.Clear
node a20 Get local:sum
node a21 Call String.AppendF
	in format "{0,-8}|{1,-7}|{2,10:N2}"
	in arg0 "total"
	in arg1 ""
node a22 Call Console.WriteLine(String)
node a23 Call String.Clear
node a24 Literal
	set type StringView
	set value "Grüße aus Köln ✓"
node a25 Get StringView.Length
node a26 Call StringView.CodePointCount
node a27 Call String.AppendF
	in format "\"{0}\": {1} bytes, {2} code points"
node a28 Call Console.WriteLine(String)
node a29 Call String.Clear
node a30 Call Environment.IsWindows
node a31 Literal
	set type StringView
	set value "cmd"
node a32 Literal
	set type StringView
	set value "echo"
node a33 Select
node a34 Literal
	set type StringView
	set value "/c echo hello from a child process"
node a35 Literal
	set type StringView
	set value "hello from a child process"
node a36 Select
node a37 Call Process.Start
node a38 ResultMatch
node a39 Local String
node a40 Call ProcessHandle.GetOutput
node a41 Call String.Trim
node a42 Call ProcessHandle.ExitCode
node a43 Call String.AppendF
	in format "child said \"{0}\", exit code {1}"
node a44 Call Console.WriteLine(String)
node a45 Call String.Clear
node a46 Delete
node a47 Call Console.WriteLine(StringView)
	in text "the child could not be started"
node a48 Call Time.Now
node a49 Break DateTime
node a50 Call String.AppendF
	in format "year {0}"
node a51 Call Console.WriteLine(String)
node a52 Call String.Clear
node a53 Return
	in value 0
