node d3 Call Console.WriteLine(String)
node d4 ForEach
node d5 Local String
node d6 Index
node d7 Call String.Append(int)
node d8 Local String
node d9 Call String.AppendF
	in format "  {0}: {1}"
node e1 Call Console.WriteLine(String)
node e2 Call Stopwatch.Stop
node e3 Local String
node e4 Call Stopwatch.ElapsedMicroseconds
node e5 Call String.Append(int)
node e6 Local String
node e7 Call String.AppendF
	in format "counted in {0} microseconds"
node e8 Call Console.WriteLine(String)
node e9 Call List<String>.DeleteAll
node f1 Delete
node f2 Return
	in value 0
