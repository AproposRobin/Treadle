# treadle 1
type Program class
	namespace M3
	static
	doc "Milestone 3, the core library: counts the words of the command line (or of a built-in sentence when there are none) and prints them by count, most frequent first, then how long it took."

function m0001 Main
	static
	returns int
	doc "Builds the List<String> of words (the list owns them), counts them in a Dictionary<String,int>, sorts the distinct words by count with a Lambda comparer, prints with AppendF, measures with a Stopwatch."
param args String[]
local counts Dictionary<String,int>
sheet body
node a1 Entry
node a2 Local Stopwatch
