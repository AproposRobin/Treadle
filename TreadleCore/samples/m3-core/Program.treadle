function m0002 AddWords
	static
	doc "Adds a new String for each word of `text` (separated by spaces) to `into`, which owns them."
param text StringView
param into List<String>
sheet body
node w1 Entry
node w2 Local List<StringView>
node w3 Call StringView.Split
	in separator 32
	in skipEmpty true
node w4 ForEach
node w5 Construct String
	set ctor (StringView)
node w6 Call List<String>.Add
node w7 Return
wire w1.then w2.in
wire w2.then w3.in
wire w2.object w3.into
wire w1.text w3.receiver
wire w2.object w4.collection
wire w3.then w4.in
wire w4.body w5.in
wire w4.element w5.text
wire w5.then w6.in
wire w1.into w6.receiver
wire w5.object w6.value
wire w4.done w7.in
