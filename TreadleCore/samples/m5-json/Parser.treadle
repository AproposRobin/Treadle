# treadle 1
type Parser class
	namespace Json
	doc "A recursive-descent JSON parser (RFC 8259) over a StringView: Parse() gives the value or a ParseError with the line and column. The parser does not own the text, which must live while it parses; the value it gives owns its own copies of the strings."

field mText StringView
	doc "The text being read."

field mPos int
	doc "The byte position of the next character."

field mLine int
	init 1
	doc "The line of mPos (1-based)."

field mLineStart int
	doc "The byte position where the current line starts."

field mMaxDepth int
	init 512
	doc "The deepest nesting accepted (512 levels); deeper documents are an error, not a stack overflow. A Debug build overflows the 1 MB main stack at about 650 levels."

ctor m0001
	doc "A parser over `text`, at its start."
param text StringView
sheet body
node a000 Entry
node a001 Set this.mText
node a002 Return
wire a000.then a001.in
wire a000.text a001.value
wire a001.then a002.in

function m0002 Parse
	returns Result<Json.JsonValue,Json.ParseError>
	doc "Reads one JSON document: white space, a value, white space, the end of the text. Ok(value), which the caller owns (Free it), or Err with the position."
sheet body
node b000 Entry
node b001 Call this.SkipWhitespace
node b002 Call this.ParseValue
	in depth 1
node b003 ResultMatch
node b004 Return
node b005 Call this.SkipWhitespace
node b006 Get this.mPos
node b007 Get this.mText
node b008 Get StringView.Length
node b009 Operator ==
node b00a Branch
node b00b Return
node b00c Call Json.JsonValue.Free
node b00d Call this.FailValue
	in message "unexpected text after the value"
node b00e Return
node b00f Fatal
	in message "unreachable: both arms return"
wire b000.then b001.in
wire b001.then b002.in
wire b002.then b003.in
wire b002.result b003.result
wire b003.err b004.in
wire b002.result b004.value
wire b003.ok b005.in
wire b007.value b008.receiver
wire b006.value b009.a
wire b008.value b009.b
wire b009.result b00a.condition
wire b005.then b00a.in
wire b00a.true b00b.in
wire b002.result b00b.value
wire b00a.false b00c.in
wire b003.value b00c.value
wire b00c.then b00e.in
wire b00d.result b00e.value
wire b003.done b00f.in

