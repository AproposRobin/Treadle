local start int
sheet body
node k000 Entry
node k001 Call this.Peek
node k002 Call Json.Parser.IsNumberStart
node k003 Branch
node k004 Call this.FailValue
	in message "unexpected character"
node k005 Return
node k006 Get this.mPos
node k007 Set local:start
node k008 Call this.Peek
node k009 Call Json.Parser.IsNumberChar
node k00a While
node k00b Set this.mPos
	set op +=
	in value 1
node k00c Get this.mText
node k00d Get local:start
node k00e Get this.mPos
node k00f Operator -
node k00g Call StringView.Substring
node k00h Call Double.Parse
node k00i ResultMatch
node k00j MakeCase Json.JsonValue.Number
node k00k MakeCase Result<Json.JsonValue,Json.ParseError>.Ok
node k00l Return
node k00m Set this.mPos
node k00n Call this.FailValue
	in message "invalid number"
node k00o Return
node k00p Fatal
	in message "unreachable: both arms return"
wire k001.result k002.c
wire k002.result k003.condition
wire k000.then k003.in
wire k003.false k005.in
wire k004.result k005.value
wire k003.true k007.in
wire k006.value k007.value
wire k008.result k009.c
wire k009.result k00a.condition
wire k007.then k00a.in
wire k00a.body k00b.in
wire k00e.value k00f.a
wire k00d.value k00f.b
wire k00f.result k00g.length
wire k00c.value k00g.receiver
wire k00d.value k00g.start
wire k00a.done k00h.in
wire k00g.result k00h.text
wire k00h.then k00i.in
wire k00h.result k00i.result
wire k00i.value k00j.value
wire k00j.value k00k.value
wire k00i.ok k00l.in
wire k00k.value k00l.value
wire k00i.err k00m.in
