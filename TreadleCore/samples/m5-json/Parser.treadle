function m0009 ReadHex4
	access private
	returns Result<int,Json.ParseError>
	doc "Reads four hex digits (either case) at the current position and gives their value."
local acc int
local d int
sheet body
node j000 Entry
node j001 For
	in start 0
	in count 4
node j002 Call this.Peek
node j003 Call Json.Parser.HexDigit
node j004 Set local:d
node j005 Get local:d
node j006 Operator <
	in b 0
node j007 Branch
node j008 Call this.Fail
	in message "invalid \\u escape (four hex digits expected)"
node j009 MakeCase Result<int,Json.ParseError>.Err
node j00a Return
node j00b Get local:acc
node j00c Math
	set expr "a*16+d"
node j00d Set local:acc
node j00e Set this.mPos
	set op +=
	in value 1
node j00f MakeCase Result<int,Json.ParseError>.Ok
node j00g Return
wire j000.then j001.in
wire j002.result j003.c
wire j001.body j004.in
wire j003.result j004.value
wire j005.value j006.a
wire j006.result j007.condition
wire j004.then j007.in
wire j008.result j009.error
wire j007.true j00a.in
wire j009.value j00a.value
wire j00b.value j00c.a
wire j005.value j00c.d
wire j007.false j00d.in
wire j00c.result j00d.value
wire j00d.then j00e.in
wire j00b.value j00f.value
wire j001.done j00g.in
wire j00f.value j00g.value

function m0010 ParseNumber
	access private
