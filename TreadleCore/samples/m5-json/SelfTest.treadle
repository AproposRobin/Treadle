function m0006 QueryIs
	static
	returns bool
	doc "True when Query.Find(root, path) written compact is `expected` (`none` for no value)."
param root Json.JsonValue
param path StringView
param expected StringView
sheet body
node f000 Entry
node f001 Local String
	set ctor ()
node f002 Call Json.Query.Find
node f003 IsCase Option<Json.JsonValue>.Some
node f004 Branch
node f005 Call Json.Writer.Write
	in pretty false
	in level 0
node f006 Call String.Append(StringView)
	in text "none"
node f007 Call String.Equals
node f008 Return
wire f000.then f001.in
wire f001.then f002.in
wire f000.path f002.path
wire f000.root f002.root
wire f002.result f003.value
wire f003.result f004.condition
wire f002.then f004.in
wire f004.true f005.in
wire f001.object f005.into
wire f003.value f005.value
wire f004.false f006.in
wire f001.object f006.receiver
wire f000.expected f007.other
wire f001.object f007.receiver
wire f005.then f008.in
wire f006.then f008.in
wire f007.result f008.value

function m0007 Nested
	static
	doc "Appends `count` opening brackets, then `count` closing ones."
param count int
param into String
sheet body
node g000 Entry
node g001 For
	in start 0
node g002 Call String.Append(char8)
	in value 91
node g003 For
	in start 0
node g004 Call String.Append(char8)
	in value 93
node g005 Return
wire g000.count g001.count
wire g000.then g001.in
wire g001.body g002.in
wire g000.into g002.receiver
wire g000.count g003.count
wire g001.done g003.in
wire g003.body g004.in
wire g000.into g004.receiver
wire g003.done g005.in

function m0008 CaseScalars
	static
	returns bool
	doc "Every scalar kind in one array: 9 values, depth 2."
sheet body
node h000 Entry
node h001 Call Json.SelfTest.CheckValid
	in name "scalars"
	in text "[null, true, false, 0, -1.5e3, \"x\", 1e-2, 123456789012]"
	in nodes 9
	in depth 2
node h002 Return
wire h000.then h001.in
wire h001.then h002.in
wire h001.result h002.value

function m0009 CaseQuery
	static
	returns bool
	doc "Path lookups: members, indexes, misses and a subtree."
local v Json.JsonValue
local good bool
sheet body
node j000 Entry
node j001 Call Json.SelfTest.ParseText
	in text "{\"a\": {\"b\": [10, 20, {\"c\": \"deep\"}]}, \"n\": -0.5, \"s\": \"x\\u00e9\"}"
node j002 ResultMatch
node j003 Call Json.SelfTest.Report
	in name "query"
	in detail "did not parse"
node j004 Return
	in value false
node j005 Set local:v
node j006 Get local:v
node j007 Call Json.SelfTest.QueryIs
	in path "a.b[2].c"
	in expected "\"deep\""
node j008 Call Json.SelfTest.QueryIs
	in path "a.b[1]"
	in expected "20"
node j009 Call Json.SelfTest.QueryIs
	in path "a.b[3]"
	in expected "none"
node j00a Call Json.SelfTest.QueryIs
	in path "a.x.y"
	in expected "none"
node j00b Call Json.SelfTest.QueryIs
	in path "a.b"
	in expected "[10,20,{\"c\":\"deep\"}]"
node j00c Call Json.SelfTest.QueryIs
	in path "n"
	in expected "-0.5"
node j00d Call Json.SelfTest.QueryIs
	in path "s"
	in expected "\"xé\""
node j00e Call Json.SelfTest.QueryIs
	in path "n[0]"
	in expected "none"
node j00f Operator &&
node j00g Operator &&
node j00h Operator &&
node j00i Operator &&
node j00j Operator &&
node j00k Operator &&
node j00l Operator &&
node j00m Set local:good
node j00n Call Json.JsonValue.Free
node j00o Get local:good
node j00p Branch
node j00q Return
	in value true
node j00r Call Json.SelfTest.Report
	in name "query"
	in detail "a path gave the wrong value"
node j00s Fatal
	in message "unreachable: both arms return"
wire j000.then j001.in
wire j001.then j002.in
wire j001.result j002.result
wire j002.err j003.in
wire j003.then j004.in
wire j00r.then j004.in
wire j002.ok j005.in
wire j002.value j005.value
wire j005.then j007.in
wire j006.value j007.root
wire j007.then j008.in
wire j006.value j008.root
wire j008.then j009.in
wire j006.value j009.root
wire j009.then j00a.in
wire j006.value j00a.root
wire j00a.then j00b.in
wire j006.value j00b.root
wire j00b.then j00c.in
wire j006.value j00c.root
wire j00c.then j00d.in
wire j006.value j00d.root
wire j00d.then j00e.in
wire j006.value j00e.root
wire j007.result j00f.a
wire j008.result j00f.b
wire j00f.result j00g.a
wire j009.result j00g.b
wire j00g.result j00h.a
wire j00a.result j00h.b
wire j00h.result j00i.a
wire j00b.result j00i.b
wire j00i.result j00j.a
wire j00c.result j00j.b
wire j00j.result j00k.a
wire j00d.result j00k.b
wire j00k.result j00l.a
wire j00e.result j00l.b
wire j00e.then j00m.in
wire j00l.result j00m.value
wire j00m.then j00n.in
wire j006.value j00n.value
wire j00o.value j00p.condition
wire j00n.then j00p.in
wire j00p.true j00q.in
wire j00p.false j00r.in
wire j002.done j00s.in

function m0010 CaseEscapes
	static
	returns bool
	doc "Every short escape and a \\u escape decode to the right bytes and are written back."
sheet body
node k000 Entry
node k001 Local String
	set ctor (StringView)
	in text "q\"b\\s/n\nt\tr\rb\u0008f"
node k002 Call String.Append(char8)
	in value 12
node k003 Call String.Append(StringView)
	in text "uA"
node k004 Call Json.SelfTest.CheckText
	in name "string escapes"
	in json "\"q\\\"b\\\\s\\/n\\nt\\tr\\rb\\bf\\fu\\u0041\""
node k005 Return
wire k000.then k001.in
wire k001.then k002.in
wire k001.object k002.receiver
wire k002.then k003.in
wire k001.object k003.receiver
wire k001.object k004.expected
wire k003.then k004.in
wire k004.then k005.in
wire k004.result k005.value

function m0011 CaseUnicode
	static
	returns bool
	doc "\\u escapes (BMP and a surrogate pair) and raw UTF-8 give the same bytes."
sheet body
node n000 Entry
node n001 Call Json.SelfTest.CheckText
	in name "unicode"
	in json "\"\\u00e9\\u4E2D\\ud83d\\ude00 raw é中😀\""
	in expected "é中😀 raw é中😀"
node n002 Return
wire n000.then n001.in
wire n001.then n002.in
wire n001.result n002.value

function m0012 CaseDeep
	static
	returns bool
	doc "500 nested arrays parse (500 values, depth 500); 513 are refused at the 513th bracket (the parser limit is 512)."
sheet body
node p000 Entry
node p001 Local String
	set ctor ()
node p002 Call Json.SelfTest.Nested
	in count 500
node p003 Call Json.SelfTest.CheckValid
	in name "500 levels"
	in nodes 500
	in depth 500
node p004 Local String
	set ctor ()
node p005 Call Json.SelfTest.Nested
	in count 513
node p006 Call Json.SelfTest.CheckError
	in name "513 levels"
	in line 1
	in column 513
node p007 Operator &&
node p008 Return
wire p000.then p001.in
wire p001.then p002.in
wire p001.object p002.into
wire p002.then p003.in
wire p001.object p003.text
wire p003.then p004.in
wire p004.then p005.in
wire p004.object p005.into
wire p005.then p006.in
wire p004.object p006.text
wire p003.result p007.a
wire p006.result p007.b
wire p006.then p008.in
wire p007.result p008.value

function m0013 CaseLarge
