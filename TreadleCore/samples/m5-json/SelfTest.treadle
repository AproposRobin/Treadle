	in value false
node q00m Local Stopwatch
	set ctor (bool)
	in startNow true
node q00n Local String
	set ctor ()
node q00o Call Json.Writer.Write
	in pretty false
	in level 0
node q00p Call Stopwatch.Stop
node q00q Call Stopwatch.ElapsedMicroseconds
node q00r Call String.Length
node q00s Cast double
node q00t Cast int
node q00u Cast int
node q00v Operator +
	in b 1
node q00w Cast double
node q00x Operator /
node q00y Call Json.JsonValue.Count
node q00z Local String
	set ctor ()
node q010 Call String.AppendF
	in format "1 MB array: {0} bytes, {1} elements; parse {2} us ({3:F1} MB/s), compact write {4} us"
node q011 Call Console.WriteLine(String)
node q012 Operator ==
