function m0017 CaseRoundTrip
	static
	returns bool
	doc "The exact compact and pretty texts of a mixed document (keys sorted, empty containers, an escape, 15 and 17 digit numbers) and their round trips."
local v Json.JsonValue
local good bool
sheet body
node v000 Entry
node v001 Call Json.SelfTest.ParseText
	in text "{\"b\": [1, 2.5, {}, [], \"s\\n\"], \"a\": null, \"c\": {\"z\": 0.1, \"y\": 1e300, \"x\": -12345678901234, \"w\": true, \"v\": 0.30000000000000004}}"
node v002 ResultMatch
node v003 Call Json.SelfTest.Report
	in name "round trip"
	in detail "did not parse"
node v004 Return
	in value false
node v005 Set local:v
node v006 Get local:v
node v007 Local String
	set ctor ()
node v008 Call Json.Writer.Write
	in pretty false
	in level 0
node v009 Local String
	set ctor ()
node v00a Call Json.Writer.Write
	in pretty true
	in level 0
node v00b Call String.Equals
	in other "{\"a\":null,\"b\":[1,2.5,{},[],\"s\\n\"],\"c\":{\"v\":0.30000000000000004,\"w\":true,\"x\":-12345678901234,\"y\":1E+300,\"z\":0.1}}"
node v00c Call String.Equals
	in other "{\n  \"a\": null,\n  \"b\": [\n    1,\n    2.5,\n    {},\n    [],\n    \"s\\n\"\n  ],\n  \"c\": {\n    \"v\": 0.30000000000000004,\n    \"w\": true,\n    \"x\": -12345678901234,\n    \"y\": 1E+300,\n    \"z\": 0.1\n  }\n}"
node v00d Call Json.Equality.RoundTrips
node v00e Operator &&
node v00f Operator &&
node v00g Set local:good
node v00h Call Json.JsonValue.Free
node v00i Get local:good
node v00j Branch
node v00k Return
	in value true
node v00l Call Json.SelfTest.Report
	in name "round trip"
	in detail "wrong compact or pretty text, or no round trip"
node v00m Fatal
	in message "unreachable: both arms return"
wire v000.then v001.in
wire v001.then v002.in
wire v001.result v002.result
wire v002.err v003.in
wire v003.then v004.in
wire v00l.then v004.in
wire v002.ok v005.in
wire v002.value v005.value
wire v005.then v007.in
wire v007.then v008.in
wire v007.object v008.into
wire v006.value v008.value
wire v008.then v009.in
wire v009.then v00a.in
wire v009.object v00a.into
wire v006.value v00a.value
wire v007.object v00b.receiver
wire v009.object v00c.receiver
wire v00a.then v00d.in
wire v006.value v00d.value
wire v00b.result v00e.a
wire v00c.result v00e.b
wire v00e.result v00f.a
wire v00d.result v00f.b
wire v00d.then v00g.in
wire v00f.result v00g.value
wire v00g.then v00h.in
wire v006.value v00h.value
wire v00i.value v00j.condition
wire v00h.then v00j.in
wire v00j.true v00k.in
wire v00j.false v00l.in
wire v002.done v00m.in

function m0018 Run
	static
	returns int
	doc "Runs the ten cases in order; prints `selftest ok` and gives 0, or stops at the first failure (already printed) and gives 1."
sheet body
node w000 Entry
node w001 Return
	in value 1
node w002 Call Json.SelfTest.CaseScalars
node w003 Branch
node w004 Call Json.SelfTest.CaseQuery
node w005 Branch
node w006 Call Json.SelfTest.CaseEscapes
node w007 Branch
node w008 Call Json.SelfTest.CaseUnicode
node w009 Branch
node w00a Call Json.SelfTest.CaseDeep
node w00b Branch
node w00c Call Json.SelfTest.CaseLarge
node w00d Branch
node w00e Call Json.SelfTest.CaseTrailingArray
node w00f Branch
node w00g Call Json.SelfTest.CaseTrailingObject
node w00h Branch
node w00i Call Json.SelfTest.CaseInvalid
node w00j Branch
node w00k Call Json.SelfTest.CaseRoundTrip
node w00l Branch
node w00m Call Console.WriteLine(StringView)
	in text "selftest ok"
node w00n Return
	in value 0
