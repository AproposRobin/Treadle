wire e00a.result e00b.b
wire e00a.then e00c.in
wire e00b.result e00c.value
wire e00c.then e00d.in
wire e009.result e00e.arg0
wire e00a.result e00e.arg1
wire e000.expected e00e.arg2
wire e00d.then e00e.in
wire e00d.object e00e.receiver
wire e00e.then e00f.in
wire e00d.object e00f.into
wire e002.value e00f.value
wire e00f.then e00g.in
wire e002.value e00g.value
wire e00h.value e00i.condition
wire e00g.then e00i.in
