function m0014 CaseTrailingArray
	static
	returns bool
	doc "A trailing comma in an array is an error at the closing bracket."
sheet body
node r000 Entry
node r001 Call Json.SelfTest.CheckError
	in name "trailing comma in an array"
	in text "[1,2,]"
	in line 1
	in column 6
node r002 Return
wire r000.then r001.in
wire r001.then r002.in
wire r001.result r002.value

function m0015 CaseTrailingObject
	static
	returns bool
	doc "A trailing comma in an object is an error at the closing brace."
sheet body
node s000 Entry
node s001 Call Json.SelfTest.CheckError
	in name "trailing comma in an object"
	in text "{\"a\":1,}"
	in line 1
	in column 8
node s002 Return
wire s000.then s001.in
wire s001.then s002.in
wire s001.result s002.value

function m0016 CaseInvalid
	static
	returns bool
	doc "Documents that are not JSON are refused; the multi-line one at the exact line and column."
sheet body
node t000 Entry
node t001 Call Json.SelfTest.CheckError
	in name "unterminated string"
	in text "\"abc"
	in line 0
	in column 0
node t002 Call Json.SelfTest.CheckError
	in name "invalid escape"
	in text "\"\\x\""
	in line 0
	in column 0
node t003 Call Json.SelfTest.CheckError
	in name "lone high surrogate"
	in text "\"\\ud800\""
	in line 0
	in column 0
node t004 Call Json.SelfTest.CheckError
	in name "lone low surrogate"
	in text "\"\\udc00\""
	in line 0
	in column 0
node t005 Call Json.SelfTest.CheckError
	in name "short \\u escape"
	in text "\"\\u12\""
	in line 0
	in column 0
node t006 Call Json.SelfTest.CheckError
	in name "missing colon"
	in text "{\"a\" 1}"
	in line 0
	in column 0
node t007 Call Json.SelfTest.CheckError
	in name "text after the value"
	in text "[1] 2"
	in line 0
	in column 0
node t008 Call Json.SelfTest.CheckError
	in name "empty document"
	in text ""
	in line 0
	in column 0
node t009 Call Json.SelfTest.CheckError
	in name "bad literal"
	in text "[tru]"
	in line 0
	in column 0
node t00a Call Json.SelfTest.CheckError
	in name "duplicate key"
	in text "{\"a\":1,\"a\":2}"
	in line 0
	in column 0
node t00b Call Json.SelfTest.CheckError
	in name "bad number"
	in text "[1.2.3]"
	in line 0
	in column 0
node t00c Call Json.SelfTest.CheckError
	in name "raw tab in a string"
	in text "\"a\tb\""
	in line 0
	in column 0
