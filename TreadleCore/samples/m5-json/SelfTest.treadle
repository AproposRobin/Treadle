# treadle 1
type SelfTest class
	namespace Json
	static
	doc "The built-in cases run by `--selftest`: valid and invalid documents, escapes and unicode, 500 levels of nesting, a generated 1 MB array (timed), trailing commas, exact error positions and the compact and pretty texts. Run stops at the first failing case."

function m0001 ParseText
	static
	returns Result<Json.JsonValue,Json.ParseError>
	doc "Parses `text` with a Local Parser."
param text StringView
sheet body
node a000 Entry
node a001 Local Json.Parser
node a002 Call Json.Parser.Parse
node a003 Return
wire a000.then a001.in
wire a000.text a001.text
wire a001.then a002.in
wire a001.object a002.receiver
wire a002.then a003.in
wire a002.result a003.value

function m0002 Report
	static
	doc "Prints `selftest FAILED: <name>: <detail>`."
param name StringView
param detail StringView
sheet body
node b000 Entry
node b001 Local String
	set ctor ()
node b002 Call String.AppendF
	in format "selftest FAILED: {0}: {1}"
node b003 Call Console.WriteLine(String)
node b004 Return
wire b000.then b001.in
wire b000.name b002.arg0
wire b000.detail b002.arg1
wire b001.then b002.in
wire b001.object b002.receiver
wire b002.then b003.in
wire b001.object b003.value
wire b003.then b004.in

function m0003 CheckValid
	static
	returns bool
	doc "`text` must parse, hold `nodes` values nested `depth` deep, and round-trip."
param name StringView
param text StringView
param nodes int
param depth int
local good bool
sheet body
node c000 Entry
node c001 Call Json.SelfTest.ParseText
node c002 ResultMatch
node c003 Local String
	set ctor ()
node c004 Call Json.ParseError.Describe
node c005 Call Json.SelfTest.Report
node c006 Return
	in value false
node c007 Call Json.Stats.Of
node c008 Break Json.Stats
node c009 Operator ==
node c00a Operator ==
node c00b Operator &&
node c00c Call Json.Equality.RoundTrips
node c00d Operator &&
node c00e Set local:good
node c00f Call Json.JsonValue.Free
node c00g Get local:good
node c00h Branch
node c00i Return
	in value true
node c00j Call Json.SelfTest.Report
	in detail "wrong node count or depth, or no round trip"
node c00k Fatal
	in message "unreachable: both arms return"
wire c000.then c001.in
wire c000.text c001.text
wire c001.then c002.in
wire c001.result c002.result
wire c002.err c003.in
wire c003.then c004.in
wire c003.object c004.into
wire c002.error c004.receiver
wire c003.object c005.detail
wire c004.then c005.in
wire c000.name c005.name
wire c005.then c006.in
wire c00j.then c006.in
wire c002.ok c007.in
wire c002.value c007.value
wire c007.result c008.value
wire c008.Nodes c009.a
wire c000.nodes c009.b
wire c008.Depth c00a.a
wire c000.depth c00a.b
wire c009.result c00b.a
wire c00a.result c00b.b
wire c007.then c00c.in
wire c002.value c00c.value
wire c00b.result c00d.a
wire c00c.result c00d.b
wire c00c.then c00e.in
wire c00d.result c00e.value
wire c00e.then c00f.in
wire c002.value c00f.value
wire c00g.value c00h.condition
wire c00f.then c00h.in
wire c00h.true c00i.in
wire c00h.false c00j.in
wire c000.name c00j.name
wire c002.done c00k.in

function m0004 CheckError
	static
	returns bool
	doc "`text` must not parse; when `line` is not 0 the error must be at that line and column."
param name StringView
param text StringView
param line int
param column int
sheet body
node d000 Entry
node d001 Call Json.SelfTest.ParseText
node d002 ResultMatch
node d003 Call Json.JsonValue.Free
node d004 Call Json.SelfTest.Report
	in detail "parsed, but it is not valid JSON"
node d005 Return
	in value false
node d006 Break Json.ParseError
node d007 Operator ==
	in b 0
node d008 Operator ==
node d009 Operator ==
node d00a Operator &&
node d00b Operator ||
node d00c Branch
node d00d Return
	in value true
node d00e Local String
	set ctor ()
node d00f Call Json.ParseError.Describe
node d00g Call Json.SelfTest.Report
node d00h Fatal
	in message "unreachable: both arms return"
wire d000.then d001.in
wire d000.text d001.text
wire d001.then d002.in
wire d001.result d002.result
wire d002.ok d003.in
wire d002.value d003.value
wire d003.then d004.in
wire d000.name d004.name
wire d004.then d005.in
wire d00g.then d005.in
wire d002.error d006.value
wire d000.line d007.a
wire d006.Line d008.a
wire d000.line d008.b
wire d006.Column d009.a
wire d000.column d009.b
wire d008.result d00a.a
wire d009.result d00a.b
wire d007.result d00b.a
wire d00a.result d00b.b
wire d00b.result d00c.condition
wire d002.err d00c.in
wire d00c.true d00d.in
wire d00c.false d00e.in
wire d00e.then d00f.in
wire d00e.object d00f.into
wire d002.error d00f.receiver
wire d00e.object d00g.detail
wire d00f.then d00g.in
wire d000.name d00g.name
wire d002.done d00h.in

function m0005 CheckText
	static
	returns bool
	doc "`json` must parse to a string equal to `expected` and round-trip."
param name StringView
param json StringView
param expected StringView
local good bool
sheet body
node e000 Entry
node e001 Call Json.SelfTest.ParseText
node e002 ResultMatch
node e003 Local String
	set ctor ()
node e004 Call Json.ParseError.Describe
node e005 Call Json.SelfTest.Report
node e006 Return
	in value false
node e007 IsCase Json.JsonValue.Text
node e008 Call String.Equals
node e009 Operator &&
node e00a Call Json.Equality.RoundTrips
node e00b Operator &&
node e00c Set local:good
node e00d Local String
	set ctor ()
node e00e Call String.AppendF
	in format "text equal {0}, round trip {1}, expected {2}; read "
node e00f Call Json.Writer.Write
	in pretty false
	in level 0
node e00g Call Json.JsonValue.Free
node e00h Get local:good
node e00i Branch
node e00j Return
	in value true
node e00k Call Json.SelfTest.Report
node e00l Fatal
	in message "unreachable: both arms return"
wire e000.then e001.in
wire e000.json e001.text
wire e001.then e002.in
wire e001.result e002.result
wire e002.err e003.in
wire e003.then e004.in
wire e003.object e004.into
wire e002.error e004.receiver
wire e003.object e005.detail
wire e004.then e005.in
wire e000.name e005.name
wire e005.then e006.in
wire e00k.then e006.in
wire e002.value e007.value
wire e000.expected e008.other
wire e007.value e008.receiver
wire e007.result e009.a
wire e008.result e009.b
wire e002.ok e00a.in
wire e002.value e00a.value
