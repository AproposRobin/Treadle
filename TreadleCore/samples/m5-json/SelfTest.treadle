local good bool
sheet body
node q000 Entry
node q001 Local String
	set ctor ()
node q002 Call String.Append(char8)
	in value 91
node q003 Call String.Length
node q004 Operator <
	in b 1048576
node q005 While
node q006 Get local:count
node q007 Operator >
	in b 0
node q008 Branch
node q009 Call String.Append(char8)
	in value 44
node q00a Cast double
node q00b Operator *
	in b 0.25
node q00c Call String.AppendF
