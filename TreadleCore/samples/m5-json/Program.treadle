# treadle 1
type Program class
	namespace Json
	static
	doc "Program Start of the m5-json sample: reads a JSON file (or stdin with `-`), prints its statistics, writes it compact and pretty, checks the round trip and saves the pretty form next to the input; `--selftest` runs the built-in cases."

function m0001 Main
	static
	returns int
	doc "`<file>`: 0 when the file is JSON and round-trips, 1 when it cannot be read, is not JSON or does not round-trip; `-` reads stdin and prints the pretty form; `--selftest`: 0 or 1; no argument: usage, 2."
param args String[]
sheet body
node a000 Entry
node a001 Get String[].Length
node a002 Operator ==
	in b 0
node a003 Branch
node a004 Call Console.ErrorLine
	in text "usage: m5-json <file.json> | - | --selftest"
node a005 Return
	in value 2
node a006 Index
	in index 0
node a007 Call String.Equals
	in other "--selftest"
node a008 Branch
node a009 Call Json.SelfTest.Run
node a00a Return
node a00b Local String
	set ctor ()
node a00c Call String.Equals
	in other "-"
node a00d Branch
node a00e Call Json.Program.ReadStdin
node a00f Call File.ReadAllText
node a00g Branch
node a00h Local String
	set ctor ()
node a00i Call String.AppendF
	in format "cannot read {0}"
node a00j Call Console.ErrorLine
node a00k Return
	in value 1
node a00l Call Json.Program.Process
node a00m Return
wire a000.args a001.receiver
wire a001.value a002.a
wire a002.result a003.condition
wire a000.then a003.in
wire a003.true a004.in
wire a004.then a005.in
wire a000.args a006.collection
wire a006.value a007.receiver
wire a007.result a008.condition
wire a003.false a008.in
wire a008.true a009.in
wire a009.then a00a.in
wire a009.result a00a.value
wire a008.false a00b.in
wire a006.value a00c.receiver
wire a00c.result a00d.condition
wire a00b.then a00d.in
wire a00d.true a00e.in
wire a00b.object a00e.into
wire a00d.false a00f.in
wire a00b.object a00f.into
wire a006.value a00f.path
wire a00f.result a00g.condition
wire a00f.then a00g.in
wire a00g.false a00h.in
wire a006.value a00i.arg0
wire a00h.then a00i.in
wire a00h.object a00i.receiver
wire a00i.then a00j.in
wire a00h.object a00j.text
wire a00j.then a00k.in
wire a00e.then a00l.in
wire a00g.true a00l.in
wire a006.value a00l.path
wire a00b.object a00l.text
wire a00l.then a00m.in
wire a00l.result a00m.value

function m0002 ReadStdin
	static
	doc "Appends every line of stdin to `into`, each with a line feed."
param into String
sheet body
node b000 Entry
node b001 Local String
	set ctor ()
node b002 While
	in condition true
node b003 Call String.Clear
node b004 Call Console.ReadLine
node b005 Branch
node b006 Return
node b007 Call String.Append(StringView)
node b008 Call String.Append(char8)
	in value 10
wire b000.then b001.in
wire b001.then b002.in
wire b002.body b003.in
wire b001.object b003.receiver
wire b003.then b004.in
wire b001.object b004.into
wire b004.result b005.condition
wire b004.then b005.in
wire b002.done b006.in
wire b005.false b006.in
wire b005.true b007.in
wire b000.into b007.receiver
wire b001.object b007.text
wire b007.then b008.in
wire b000.into b008.receiver

