function m0002 RoundTripOne
	static
	access private
	returns bool
	doc "Writes `value` (pretty or compact), parses the text again and compares the result with `value`."
param value Json.JsonValue
param pretty bool
sheet body
node b000 Entry
node b001 Local String
	set ctor ()
node b002 Call Json.Writer.Write
	in level 0
node b003 Local Json.Parser
node b004 Call Json.Parser.Parse
node b005 ResultMatch
node b006 Return
	in value false
node b007 Call Json.Equality.Same
node b008 Call Json.JsonValue.Free
node b009 Return
node b00a Fatal
	in message "unreachable: both arms return"
wire b000.then b001.in
wire b001.then b002.in
wire b001.object b002.into
wire b000.pretty b002.pretty
wire b000.value b002.value
wire b002.then b003.in
wire b001.object b003.text
wire b003.then b004.in
wire b003.object b004.receiver
wire b004.then b005.in
wire b004.result b005.result
wire b005.err b006.in
wire b000.value b007.a
wire b005.value b007.b
wire b005.ok b007.in
wire b007.then b008.in
wire b005.value b008.value
wire b008.then b009.in
wire b007.result b009.value
wire b005.done b00a.in

function m0003 RoundTrips
	static
	returns bool
	doc "True when both the compact and the pretty text of `value` parse back to the same JSON."
param value Json.JsonValue
sheet body
node c000 Entry
node c001 Call Json.Equality.RoundTripOne
	in pretty false
node c002 Call Json.Equality.RoundTripOne
	in pretty true
node c003 Operator &&
node c004 Return
wire c000.then c001.in
wire c000.value c001.value
wire c001.then c002.in
wire c000.value c002.value
wire c001.result c003.a
wire c002.result c003.b
wire c002.then c004.in
wire c003.result c004.value
