# treadle 1
type Equality class
	namespace Json
	static
	doc "Structural comparison of JsonValues and the write-then-read round trip check."

function m0001 Same
	static
	returns bool
	doc "True when `a` and `b` hold the same JSON: the same case and equal payloads, arrays element by element in order, objects with the same keys and the same values (in any order)."
param a Json.JsonValue
param b Json.JsonValue
sheet body
node a000 Entry
node a001 Call Json.JsonValue.Kind
node a002 Call Json.JsonValue.Kind
node a003 Operator !=
node a004 Branch
node a005 Return
	in value false
node a006 Return
	in value true
node a007 Switch
	case Null
	case Bool
	case Number
	case Text
	case Array
	case Object
node a008 IsCase Json.JsonValue.Bool
node a009 Operator ==
node a00a Return
node a00b IsCase Json.JsonValue.Number
node a00c Operator ==
node a00d Return
node a00e IsCase Json.JsonValue.Text
node a00f Call String.Equals
node a00g Return
node a00h IsCase Json.JsonValue.Array
node a00i Get List<Json.JsonValue>.Count
node a00j Get List<Json.JsonValue>.Count
node a00k Operator !=
node a00l Branch
node a00m For
	in start 0
node a00n Index
node a00o Index
node a00p Call Json.Equality.Same
node a00q Branch
node a00r IsCase Json.JsonValue.Object
node a00s Get Dictionary<String,Json.JsonValue>.Count
node a00t Get Dictionary<String,Json.JsonValue>.Count
node a00u Operator !=
node a00v Branch
node a00w ForEach
node a00x Break (String,Json.JsonValue)
node a00y Call Dictionary<String,Json.JsonValue>.TryGet
node a00z Branch
node a010 Call Json.Equality.Same
node a011 Branch
wire a000.a a001.value
wire a000.b a002.value
wire a001.result a003.a
wire a002.result a003.b
wire a003.result a004.condition
wire a000.then a004.in
wire a004.true a005.in
wire a007.done a005.in
wire a00l.true a005.in
wire a00q.false a005.in
wire a00v.true a005.in
wire a00z.false a005.in
wire a011.false a005.in
wire a007.case:Null a006.in
wire a00m.done a006.in
wire a00w.done a006.in
