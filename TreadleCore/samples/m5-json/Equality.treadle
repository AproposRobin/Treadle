wire a007.case:Text a00g.in
wire a00f.result a00g.value
wire a000.b a00h.value
wire a007.case:Array.items a00i.receiver
wire a00h.items a00j.receiver
wire a00i.value a00k.a
wire a00j.value a00k.b
wire a00k.result a00l.condition
wire a007.case:Array a00l.in
wire a00i.value a00m.count
wire a00l.false a00m.in
wire a007.case:Array.items a00n.collection
wire a00m.index a00n.index
wire a00h.items a00o.collection
wire a00m.index a00o.index
wire a00n.value a00p.a
wire a00o.value a00p.b
wire a00m.body a00p.in
wire a00p.result a00q.condition
