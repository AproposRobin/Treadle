# treadle 1
type Dog class
	namespace Zoo
	base Animal
	doc "An Animal with 4 legs that says Woof."

ctor d0001
	chain base
sheet body
node a1 Entry
node a2 ChainCtor base
	in legs 4
node a3 Return
wire a1.then a3.in

function d0002 Speak
	override
sheet body
node b1 Entry
node b2 Call C.libc.puts
	in s "Woof"
node b3 Return
wire b1.then b2.in
wire b2.then b3.in
