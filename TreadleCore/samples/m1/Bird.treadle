# treadle 1
type Bird class
	namespace Zoo
	base Animal
	doc "An Animal with 2 legs that says Tweet."

ctor w0001
	chain base
sheet body
node a1 Entry
node a2 ChainCtor base
	in legs 2
node a3 Return
wire a1.then a3.in

function w0002 Speak
	override
sheet body
node b1 Entry
node b2 Call C.libc.puts
	in s "Tweet"
node b3 Return
wire b1.then b2.in
wire b2.then b3.in
