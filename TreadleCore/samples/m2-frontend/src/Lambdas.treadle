# treadle 1
type Lambdas class
	namespace M2
	doc "Lambda Sheets (Language.md 4.2): a heap Lambda capturing a local by value, a Local Lambda writing a local by reference, a Lambda returned by a member function capturing this and a parameter, a function pointer Lambda. Run prints 1005, 2008, 16, 106, 81."

field mBase int
	init 100

function l0001 Scaled
	returns IntFn
param k int
sheet body
node a1 Entry
node a2 Lambda
	set type IntFn
	set alloc construct
	set inputs x
node a3 Return
wire a1.then a2.in
wire a2.then a3.in
wire a2.value a3.value
