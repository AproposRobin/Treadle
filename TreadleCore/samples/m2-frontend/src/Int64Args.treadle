# treadle 1
type Int64Args class
	namespace M2
	static
	doc "A generic core function reached with an int and with an int64 (AppendF's AppendSlot<int> and AppendSlot<int64>): int64 is int at the IR level, so it is one instance. Run prints 5 7 and 12."

