function m0003 Windowed
	static
	returns int
	doc "Opens the window and runs the frame loop on a Sim and a Projector; prints the frames drawn and the checksum. Exit code 1 when SDL could not start."
param frames int
param shot String
local drawn int
sheet body
node d01 Entry
node d02 Get Particles.Tuning.CountA
node d03 Get Particles.Tuning.CountB
node d04 Get Particles.Tuning.Seed
node d05 Construct Particles.Sim
	set ctor (int,int,int)
node d06 DeferDelete
node d07 Construct Particles.Projector
	set ctor (Sim)
node d08 DeferDelete
node d09 Local Particles.Window
	set ctor ()
node d0a Call Particles.Window.IsOpen
node d0b Branch
node d0c Call Console.ErrorLine
	in text "SDL could not open the window"
node d0d Call C.sdl2.SDL_GetError
node d0e Call C.sdl2.SDL_Log
	in fmt "SDL: %s"
node d0f Return
	in value 1
node d0g Call Particles.Window.Run
	in shotFrame 150
node d0h Set local:drawn
node d0i Local String
	set ctor ()
node d0j Get local:drawn
node d0k Call Particles.Sim.Checksum
node d0l Call String.AppendF
	in format "frames {0}, checksum {1}"
node d0m Call Console.WriteLine(String)
node d0n Return
	in value 0
