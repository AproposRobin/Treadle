# treadle 1
type Program class
	namespace Particles
	static
	doc "Program Start: --selftest runs the eight checks; --headless [--frames n] steps the 200,000 particles n times (300 by default) and prints a summary that is the same on every run, with the timings on stderr; the two checksums are computed at once by two ThreadPool jobs; otherwise an SDL window shows them (--frames n stops after n frames, --shot <file.bmp> saves frame 150)."

field sCPar int
	static
	doc "The parallel Sim's checksum, written by a ThreadPool job."

field sCSer int
	static
	doc "The serial Sim's checksum, written by the other job."

function m0001 Main
	static
	returns int
	doc "Reads the command line and runs one of the three modes."
param args String[]
local selftest bool
local headless bool
local frames int
local shot int
	init -1
sheet body
node a01 Entry
node a02 Get String[].Length
node a03 For
	in start 0
node a04 Index
node a05 Call String.Equals
	in other "--selftest"
node a06 Branch
node a07 Set local:selftest
	in value true
node a08 Call String.Equals
	in other "--headless"
node a09 Branch
node a0a Set local:headless
	in value true
node a0b Operator +
	in b 1
node a0c Operator <
node a0d Call String.Equals
	in other "--frames"
node a0e Operator &&
node a0f Branch
node a0g Index
node a0h Call Int.TryParse
node a0i Set local:frames
node a0j Call String.Equals
	in other "--shot"
node a0k Operator &&
node a0l Branch
node a0m Set local:shot
node a0n Get local:selftest
node a0o Branch
node a0p Call Particles.SelfTest.Run
node a0q Return
node a0r Get local:headless
node a0s Branch
node a0t Get local:frames
node a0u Math
	set expr "f > 0 ? f : 300"
node a0v Call Particles.Program.Headless
node a0w Return
node a0x Get local:shot
node a0y Operator >=
	in b 0
node a0z Index
node a10 Select
	in false null
node a11 Call Particles.Program.Windowed
node a12 Return
wire a01.args a02.receiver
wire a02.value a03.count
wire a01.then a03.in
wire a01.args a04.collection
wire a03.index a04.index
wire a04.value a05.receiver
wire a05.result a06.condition
wire a03.body a06.in
