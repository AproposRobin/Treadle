wire a11.then a12.in
wire a11.result a12.value

function m0002 Headless
	static
	returns int
	doc "Steps a Sim frames times with Parallel.For and a second one from the same seed with the plain loop; projects the last frame on the named threads; prints the summary (stdout, the same on every run) and the milliseconds per frame (stderr). Exit code 0 when both Sims agree."
param frames int
local tPar int
local tSer int
local cPar int
local cSer int
local vis int
local same bool
local par Sim
local ser Sim
sheet body
node b01 Entry
node b02 Get Particles.Tuning.CountA
node b03 Get Particles.Tuning.CountB
node b04 Get Particles.Tuning.Seed
node b05 Construct Particles.Sim
	set ctor (int,int,int)
node b06 DeferDelete
node b07 Call Particles.Sim.Run
	in parallel true
node b08 Set local:tPar
node b09 Get Particles.Sim.mTime
node b0a Math
	set expr "t * 0.25f"
node b0b Make Particles.Camera
	in Pitch -0.45f
	in Distance 210.0f
node b0c Get Particles.Tuning.Width
node b0d Get Particles.Tuning.Height
node b0e Math
	set expr "w / h"
node b0f Call Particles.Camera.ViewProj
node b0g Construct Particles.Projector
	set ctor (Sim)
node b0h DeferDelete
node b0i Call Particles.Projector.ProjectAll
node b0j Set local:vis
node b0k Construct Particles.Sim
	set ctor (int,int,int)
node b0l DeferDelete
node b0m Call Particles.Sim.Run
	in parallel false
node b0n Set local:tSer
node b0p Set local:cPar
node b0r Set local:cSer
node b0s Get Particles.Sim.mStats
node b0t Get Particles.Sim.mStats
node b0u Get Particles.Stats.mSum
node b0v Get Particles.Stats.mSum
node b0w Get Particles.Stats.mMin
node b0x Get Particles.Stats.mMin
node b0y Get Particles.Stats.mMax
node b0z Get Particles.Stats.mMax
node b10 Get local:cPar
node b11 Get local:cSer
node b12 Math
	set expr "a == b && s1 == s2 && n1 == n2 && x1 == x2"
node b13 Set local:same
node b14 Cast float
node c01 Local String
	set ctor ()
node c02 Call Particles.Sim.Total
node c03 Call String.AppendF
	in format "particles {0} ({1} in float4 lanes, {2} as Vec3), frames {3}, seed {4}"
node c04 Call Console.WriteLine(String)
node c05 Local String
	set ctor ()
node c06 Call String.AppendF
	in format "checksum {0}"
node c07 Call Console.WriteLine(String)
node c08 Local String
	set ctor ()
node c09 Call Particles.Stats.Avg
node c0a Get Particles.Stats.mCount
node c0b Get Particles.Stats.mMerges
node c0c Call String.AppendF
	in format "speed min {0:F3} max {1:F3} avg {2:F3} over {3} particles from {4} chunks"
node c0d Call Console.WriteLine(String)
node c0e Local String
	set ctor ()
node c0f Get Particles.Sim.mBursts
node c0g Get Particles.Bursts.mFired
node c0h Call Particles.Bursts.OnBurst.Count
node c0i Get Particles.Sim.mReseeder
node c0j Get Particles.Reseeder.mReseeded
node c0k Call String.AppendF
	in format "bursts {0} ({1} handler), particles re-seeded {2}"
node c0l Call Console.WriteLine(String)
node c0m Local String
	set ctor ()
node c0n Call Particles.Sim.CountInside
node c0o Call Particles.Sim.AnyNaN
node c0p Get local:vis
node c0q Call String.AppendF
	in format "inside the world {0} of {1}, NaN {2}, on screen {3}"
node c0r Call Console.WriteLine(String)
node c0s Local String
	set ctor ()
node c0t Get local:same
node c0u Call String.AppendF
	in format "parallel == serial: {0}"
node c0v Call Console.WriteLine(String)
node c0w Local String
	set ctor ()
node c0x Get local:tSer
node c0y Get local:tPar
node c0z Math
	set expr "s / 1000.0 / f"
node c10 Math
	set expr "p / 1000.0 / f"
node c11 Math
	set expr "s * 1.0 / p"
node c12 Call Thread.HardwareThreads
node c13 Call String.AppendF
	in format "ms per frame: serial {0:F3}, parallel {1:F3}, speedup {2:F2}x on {3} hardware threads\n"
node c14 Call Console.Error(StringView)
node c15 Select
	in true 0
	in false 1
node c16 Return
node c17 Cast double
node c18 Cast double
node c19 Cast double
node j0 Set local:par
node j1 Lambda
	set type delegate:void()
	set alloc construct
node j2 Call ThreadPool.Run
node j3 Lambda
	set type delegate:void()
	set alloc construct
node j4 Call ThreadPool.Run
node j5 Call ThreadPool.WaitAll
node j6 Get Particles.Program.sCPar
node j7 Get Particles.Program.sCSer
node j9 Set local:ser
