function w0006 Run
	returns int
	doc "The frame loop until the window closes, Escape, or frames frames (when above 0): polls events, steps the Sim in parallel, turns the camera, projects on the named threads, clears, draws emitter A orange and emitter B blue, saves a screenshot to shot on frame shotFrame (when shot is not null), presents, and waits out the rest of 16 ms (Time.Ticks) so a frame takes at least that long. Returns the frames drawn."
param sim Sim
param proj Projector
param frames int
param shot String
param shotFrame int
local running bool
	init true
local frame int
local ev C.SDL_Event
local nA int
local t0 int
local freq int
sheet body
node r01 Entry
node r02 Get local:running
node r03 While
node r04 While
	in condition true
node r05 Get local:ev
node r06 Call C.sdl2.SDL_PollEvent
node r07 Operator ==
	in b 0
node r08 Branch
node r09 Break
node r0a Break C.SDL_Event
node r0b MakeCase C.SDL_EventType.SDL_QUIT
