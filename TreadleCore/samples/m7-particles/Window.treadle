	in b 18
	in a 255
node r12 Call C.sdl2.SDL_RenderClear
node r13 Call C.sdl2.SDL_SetRenderDrawColor
	in r 255
	in g 170
	in b 60
	in a 255
node r14 Get Particles.Projector.mPoints
node r15 Get Particles.Sim.mA
node r16 Get Particles.EmitterA.mCount
node r17 Set local:nA
node r18 Get local:nA
node r19 Call this.DrawRange
	in lo 0
node r1a Call C.sdl2.SDL_SetRenderDrawColor
	in r 90
	in g 170
	in b 255
	in a 255
node r1b Call Particles.Sim.Total
node r1c Call this.DrawRange
node r1d Get local:frame
node r1e Operator &&
node r1f Branch
