function w0005 Shot
	doc "Writes the renderer's pixels to a BMP file at path: SDL_RenderReadPixels into pixels (Width x Height ARGB8888), wrapped in a surface without a copy and saved with SDL_SaveBMP_RW."
param pixels Span<uint32>
param path String
local surface C.SDL_Surface*
sheet body
node e01 Entry
node e02 Get Particles.Tuning.Width
node e03 Get Particles.Tuning.Height
node e04 Get Span<uint32>.Ptr
node e05 Get this.mRenderer
node e06 Math
	set expr "w * 4"
node e07 Cast int32
node e08 Call C.sdl2.SDL_RenderReadPixels
	in rect null
	in format 372645892
node e09 Cast int32
node e0a Cast int32
node e0b Call C.sdl2.SDL_CreateRGBSurfaceWithFormatFrom
	in depth 32
	in format 372645892
node e0c Set local:surface
node e0d Call String.CStr()
node e0e Call C.sdl2.SDL_RWFromFile
	in mode "wb"
node e0f Get local:surface
node e0g Call C.sdl2.SDL_SaveBMP_RW
	in freedst 1
node e0h Call C.sdl2.SDL_FreeSurface
node e0i Return
