function w0004 DrawRange
	doc "Draws points lo up to (not including) hi in batches of Batch: each batch is a Span.Slice of the points, handed to SDL_RenderDrawPoints through its Ptr."
param points Span<C.SDL_Point>
param lo int
param hi int
local start int
local len int
sheet body
node d01 Entry
node d02 Get Particles.Tuning.Batch
node d03 Math
	set expr "(hi - lo + k - 1) / k"
node d04 For
	in start 0
node d05 Math
	set expr "lo + b * k"
node d06 Set local:start
node d07 Get local:start
node d08 Math
	set expr "Min(k, hi - s)"
node d09 Set local:len
node d0a Get local:len
node d0b Call Span<C.SDL_Point>.Slice
node d0c Get Span<C.SDL_Point>.Ptr
node d0d Get this.mRenderer
node d0e Cast int32
node d0f Call C.sdl2.SDL_RenderDrawPoints
node d0g Return
