# treadle 1
type Game class
	namespace Breakout
	doc "Breakout: the paddle, the ball, a wall of 60 bricks in a List<Brick>, the score and three lives. Update is one fixed step (60 per second); RunWindowed paces it with Time.Ticks, RunHeadless runs steps without SDL. Until a key is pressed the paddle follows the ball by itself (the attract mode, which is also how the headless run plays)."

field mBall Ball

field mPaddleX float

field mBricks List<Brick>
	owner owned

field mKeys Dictionary<int,bool>
	owner owned
	doc "Which keys are down, by SDL key code."

field mEffects Effects
	owner owned

field mRandom Random
	owner owned

field mScore int

field mLives int

field mServe int
	doc "Steps until the ball is launched; the ball rides on the paddle meanwhile."

field mAuto bool

field mAim float

field mOver bool

field mPaddleHits int

field OnBrickDestroyed BrickHandler
	attr Event
	doc "Invoked with each brick that breaks: AddPoints and Effects.OnBrickDestroyed are its handlers."

ctor g0001
	doc "Makes the collections, the seeded Random and the wall, subscribes the two handlers and serves."
param seed int
sheet body
node a01 Entry
node a02 Construct List<Brick>
node a03 Construct Dictionary<int,bool>
node a04 Construct Effects
node a05 Construct Random
	set ctor (int)
node a06 This
node a07 Bind Breakout.Game.AddPoints
	set alloc construct
node a08 Call this.OnBrickDestroyed.Add
node a09 Get this.mEffects
node a0a Bind Breakout.Effects.OnBrickDestroyed
	set alloc construct
node a0b Call this.OnBrickDestroyed.Add
node a0c Set this.mBricks
node a0d Set this.mKeys
node a0e Set this.mEffects
node a0f Set this.mRandom
node a0g Set this.mLives
	in value 3
node a0h Set this.mAuto
	in value true
node a0i Set this.mPaddleX
	in value 280.0f
node a0j Call this.BuildBricks
node a0k Call this.Serve
node a0l Return
wire a01.then a02.in
wire a0c.then a03.in
wire a0d.then a04.in
wire a0e.then a05.in
wire a01.seed a05.seed
wire a0j.then a07.in
wire a06.value a07.receiver
wire a07.value a08.handler
wire a07.then a08.in
wire a08.then a0a.in
wire a09.value a0a.receiver
wire a0a.value a0b.handler
wire a0a.then a0b.in
wire a02.then a0c.in
wire a02.object a0c.value
wire a03.then a0d.in
wire a03.object a0d.value
wire a04.then a0e.in
wire a04.object a0e.value
wire a05.then a0f.in
wire a05.object a0f.value
wire a0f.then a0g.in
wire a0g.then a0h.in
wire a0h.then a0i.in
wire a0i.then a0j.in
wire a0b.then a0k.in
wire a0k.then a0l.in

function g0002 BuildBricks
	doc "6 rows of 10 bricks; the top rows give more points, and one brick in four (by the seeded Random) takes two hits."
sheet body
node b01 Entry
node b02 For
	in start 0
	in count 6
node b03 For
	in start 0
	in count 10
node b04 Get this.mRandom
node b05 Call Random.Next(int)
	in maxExclusive 4
node b06 Math
	set expr "22 + c * 60"
node b07 Math
	set expr "60 + r * 22"
node b08 Operator ==
	in b 0
node b09 Select
	in true 2
	in false 1
node b0a Math
	set expr "(6 - r) * 5"
node b0b Make Breakout.Brick
	in W 56
	in H 18
node b0c Get this.mBricks
node b0d Call List<Brick>.Add
node b0e Return
wire b01.then b02.in
wire b02.body b03.in
wire b03.body b05.in
wire b04.value b05.receiver
wire b03.index b06.c
wire b02.index b07.r
wire b05.result b08.a
wire b08.result b09.condition
wire b02.index b0a.r
wire b09.result b0b.Hits
wire b0a.result b0b.Points
wire b02.index b0b.Row
wire b06.result b0b.X
wire b07.result b0b.Y
wire b05.then b0d.in
wire b0c.value b0d.receiver
wire b0b.value b0d.value
wire b02.done b0e.in

function g0003 Serve
	doc "Puts the ball on the paddle, still, for 45 steps."
sheet body
node c01 Entry
node c02 Set this.mServe
	in value 45
node c03 Get this.mBall
node c04 Make Breakout.Vec2
	in X 0.0f
	in Y 0.0f
node c05 Call Breakout.Ball.WithVel
node c06 Set this.mBall
node c07 Call this.FollowPaddle
node c08 Return
wire c01.then c02.in
wire c03.value c05.receiver
wire c04.value c05.vel
wire c02.then c06.in
wire c05.result c06.value
wire c06.then c07.in
wire c07.then c08.in

function g0004 FollowPaddle
	doc "Keeps the served ball on the middle of the paddle."
sheet body
node d01 Entry
node d02 Get this.mPaddleX
node d03 Operator +
	in b 35.0f
node d04 Make Breakout.Vec2
	in Y 428.0f
node d05 Get this.mBall
node d06 Call Breakout.Ball.At
node d07 Set this.mBall
node d08 Return
wire d02.value d03.a
wire d03.result d04.X
wire d04.value d06.pos
wire d05.value d06.receiver
wire d01.then d07.in
wire d06.result d07.value
wire d07.then d08.in

function g0005 Launch
	doc "Sends the ball up at a random slant."
sheet body
node e01 Entry
node e02 Get this.mRandom
node e03 Call Random.Range
	in min -3.0f
	in max 3.0f
node e04 Get this.mBall
node e05 Make Breakout.Vec2
	in Y -4.5f
node e06 Call Breakout.Ball.WithVel
node e07 Set this.mBall
node e08 Return
wire e01.then e03.in
wire e02.value e03.receiver
wire e03.result e05.X
wire e04.value e06.receiver
wire e05.value e06.vel
wire e03.then e07.in
wire e06.result e07.value
wire e07.then e08.in

function g0006 AddPoints
	doc "The first handler of OnBrickDestroyed: the brick's points go to the score."
param brick Brick
sheet body
node f01 Entry
node f02 Get Breakout.Brick.Points
node f03 Set this.mScore
	set op +=
node f04 Return
wire f01.brick f02.receiver
wire f01.then f03.in
wire f02.value f03.value
wire f03.then f04.in

function g0007 HandleKey
	doc "Records a key going down or up; the first key pressed ends the attract mode."
param code int
param down bool
sheet body
node g01 Entry
node g02 Get this.mKeys
node g03 Call Dictionary<int,bool>.SetItem
node g04 Branch
node g05 Return
node g06 Set this.mAuto
	in value false
wire g01.then g03.in
wire g01.code g03.key
wire g02.value g03.receiver
wire g01.down g03.value
wire g01.down g04.condition
wire g03.then g04.in
wire g04.false g05.in
wire g06.then g05.in
wire g04.true g06.in

function g0008 IsDown
	returns bool
	doc "Whether the key is down (a key never pressed is up)."
param code int
sheet body
node h01 Entry
node h02 Get this.mKeys
node h03 Call Dictionary<int,bool>.TryGet
node h04 Operator &&
node h05 Return
wire h01.then h03.in
wire h01.code h03.key
wire h02.value h03.receiver
wire h03.result h04.a
wire h03.item h04.b
wire h03.then h05.in
wire h04.result h05.value

function g0009 MovePaddle
	doc "Moves the paddle at most 6 pixels a step: toward the ball (plus a random aim) in the attract mode, else by the arrow keys or A / D."
local delta float
sheet body
node i01 Entry
node i02 Get this.mAuto
node i03 Branch
node i04 Get this.mBall
node i05 Get Breakout.Ball.Pos
node i06 Break Breakout.Vec2
