node i09 Get this.mAim
node i0a Get this.mPaddleX
node i0b Math
	set expr "b + a - p - 35"
node i0c Call Math.Clamp
	in min -6.0f
	in max 6.0f
node i0d Set local:delta
node i0e MakeCase C.SDL_KeyCode.SDLK_LEFT
node i0f Cast int
node i0g Call this.IsDown
node i0h MakeCase C.SDL_KeyCode.SDLK_a
node i0i Cast int
