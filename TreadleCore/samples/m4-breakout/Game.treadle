function g000h RunHeadless
	doc "Runs `frames` fixed steps without SDL (the same steps a window would show in attract mode)."
param frames int
sheet body
node q01 Entry
node q02 For
	in start 0
node q03 Call this.Update
node q04 Return
wire q01.frames q02.count
wire q01.then q02.in
wire q02.body q03.in
wire q02.done q04.in

function g000i RunWindowed
	returns int
	doc "The window loop: polls SDL events into the key Dictionary, runs as many fixed steps as Time.Ticks says have passed (at most five per frame), draws, and sleeps until the next step is due (vertical sync may not hold the loop). Ends on Escape, on closing the window, or after maxFrames frames (when above 0). Returns the frames drawn."
param renderer C.SDL_Renderer*
param maxFrames int
local running bool
	init true
local frame int
local step int
local last int
local acc int
local freq int
local ev C.SDL_Event
sheet body
node r01 Entry
node r02 Call Time.Frequency
node r03 Set local:freq
node r04 Get local:freq
node r05 Operator /
	in b 60
node r06 Set local:step
node r07 Call Time.Ticks
node r08 Set local:last
node r09 Get local:running
node r0a While
node r0b While
	in condition true
node r0c Get local:ev
node r0d Call C.sdl2.SDL_PollEvent
node r0e Operator ==
	in b 0
node r0f Branch
node r0g Break
node r0h Break C.SDL_Event
node r0i MakeCase C.SDL_EventType.SDL_QUIT
node r0j Cast uint32
node r0k Operator ==
node r0l Branch
node r0m Set local:running
	in value false
node r0n MakeCase C.SDL_EventType.SDL_KEYDOWN
node r0o Cast uint32
node r0p Operator ==
node r0q MakeCase C.SDL_EventType.SDL_KEYUP
node r0r Cast uint32
node r0s Operator ==
node r0t Operator ||
node r0u Branch
node r0v Break C.SDL_KeyboardEvent
node r0w Break C.SDL_Keysym
node r0x Call this.HandleKey
node r0y MakeCase C.SDL_KeyCode.SDLK_ESCAPE
node r0z Cast int
node r10 Operator ==
node r11 Branch
node r12 Set local:running
	in value false
node r13 Call Time.Ticks
node r14 Get local:last
node r15 Operator -
node r16 Set local:acc
	set op +=
node r17 Set local:last
node r18 Get local:acc
node r19 Get local:step
node r1a Operator *
	in b 5
node r1b Operator >
node r1c Branch
node r1d Get local:step
node r1e Operator *
	in b 5
node r1f Set local:acc
node r1g Get local:acc
node r1h Get local:step
node r1i Operator >=
node r1j While
node r1k Call this.Update
node r1l Get local:step
node r1m Set local:acc
	set op -=
node r1n Call this.Render
node r1o Get local:step
node r1p Get local:acc
node r1q Get local:freq
node r1r Math
	set expr "(s - a) * 1000 / f"
node r1s Cast uint32
node r1t Call C.sdl2.SDL_Delay
node r1u Set local:frame
	set op +=
	in value 1
node r1v Operator >
	in b 0
node r1w Get local:frame
node r1x Operator >=
node r1y Operator &&
node r1z Branch
node r20 Set local:running
	in value false
node r21 Get local:frame
node r22 Return
