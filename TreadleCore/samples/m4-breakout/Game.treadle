node i0k MakeCase C.SDL_KeyCode.SDLK_RIGHT
node i0l Cast int
node i0m Call this.IsDown
node i0n MakeCase C.SDL_KeyCode.SDLK_d
node i0o Cast int
node i0p Call this.IsDown
node i0q Operator ||
node i0r Select
	in true 6.0f
	in false 0.0f
node i0s Operator ||
node i0t Select
	in true 6.0f
	in false 0.0f
node i0u Operator -
node i0v Set local:delta
node i0w Get this.mPaddleX
node i0x Get local:delta
node i0y Operator +
node i0z Call Math.Clamp
	in min 0.0f
	in max 560.0f
node i10 Set this.mPaddleX
node i11 Return
