function g000e HitBricks
	doc "Finds a brick the ball overlaps with List.FindIndex and a Lambda filter (it captures the ball's place), bounces off the face it hit more squarely and hits the brick."
local bx float
local by float
local idx int
local brick Brick
sheet body
node n01 Entry
node n02 Get this.mBall
node n03 Get Breakout.Ball.Pos
node n04 Break Breakout.Vec2
node n05 Get Breakout.Ball.Vel
node n06 Break Breakout.Vec2
node n07 Set local:bx
node n08 Set local:by
node n09 Lambda
	set type delegate:bool(Breakout.Brick)
	set alloc local
	set inputs b
node n0a Get this.mBricks
node n0b Call List<Brick>.FindIndex
node n0c Set local:idx
node n0d Get local:idx
node n0e Operator >=
	in b 0
node n0f Branch
node n0g Get this.mBricks
node n0h Get local:idx
node n0i Index
node n0j Set local:brick
node n0k Get local:brick
node n0l Break Breakout.Brick
node n0m Get local:bx
node n0n Math
	set expr "(x + 5 - l - w / 2) / w"
node n0o Call Math.Abs(double)
node n0p Get local:by
node n0q Math
	set expr "(y + 5 - t - h / 2) / h"
node n0r Call Math.Abs(double)
node n0s Operator >
node n0t Branch
node n0u Get local:idx
node n0v Call this.HitBrick
node n0w Return
node n0x Call Breakout.Ball.BouncedX
node n0y Set this.mBall
node n0z Call Breakout.Ball.BouncedY
node n10 Set this.mBall
