# treadle 1
type SdlContext struct
	namespace Breakout
	doc "The SDL window and renderer as a struct with a destructor: a Local of it opens them in its constructor and closes whatever was made when its region ends, also after a failure. Status gives the outcome as a Result."

field Window C.SDL_Window*

field Renderer C.SDL_Renderer*

field Started bool

field Failed StringView
	doc "The step that failed; empty when all went well."

ctor s0001
	doc "Starts SDL video, opens a 640x480 window and a renderer synchronised with the display; on a failure it stops and keeps the name of the step in Failed (SDL_GetError says why)."
sheet body
node a01 Entry
node a02 Call C.sdl2.SDL_SetMainReady
node a03 Get C.sdl2.SDL_INIT_VIDEO
