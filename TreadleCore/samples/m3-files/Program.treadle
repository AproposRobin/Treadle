	in format "{0} {1}\n"
node d6 Call File.WriteAllText
	in path "m3-files-out/counts.txt"
node d7 Local List<String>
node d8 Call File.ReadLines
	in path "m3-files-out/counts.txt"
node d9 Local String
node e1 Get List<StringView>.Count
node e2 Get List<StringView>.Count
node e3 Get List<String>.Count
node e4 Call String.AppendF
	in format "{0} words, {1} different, {2} lines read back"
node e5 Call Console.WriteLine(String)
node e6 ForEach
node e7 Call Console.Write(StringView)
	in text "  "
node e8 Call Console.WriteLine(String)
node e9 Local List<String>
node f1 Call Directory.GetFiles
	in path "m3-files-out"
node f2 ForEach
node f3 Local String
node f4 Call String.AppendF
