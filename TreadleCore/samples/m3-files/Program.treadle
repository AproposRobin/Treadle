node f5 Call Console.WriteLine(String)
node f6 Call File.Delete
	in path "m3-files-out/counts.txt"
node f7 Call Directory.Delete
	in path "m3-files-out"
node f8 Local String
node f9 Call String.AppendF
	in format "removed: {0} {1}"
node g1 Call Console.WriteLine(String)
node g2 Call List<String>.DeleteAll
node g3 Call List<String>.DeleteAll
node g4 Return
	in value 0
