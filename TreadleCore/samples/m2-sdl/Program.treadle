# treadle 1
type Program class
	namespace Sdl
	static
	doc "An SDL2 window through the C import (docs/C-Import.md): 640x480, a renderer filled with a colour that a Flip Flop changes every 30 frames, events polled into an SDL_Event (a C union; Break reads its type) until SDL_QUIT, or until --frames <n> frames have been drawn."

function m0001 Main
	static
	returns int
param args String[]
local maxFrames int
local frame int
local running bool
	init true
local window C.SDL_Window*
local renderer C.SDL_Renderer*
local ev C.SDL_Event
local red bool
sheet body
node a1 Entry
node a2 Get String[].Length
node a3 Operator -
	in b 1
node a4 For
	in start 0
node a5 Index
node a6 Call String.CStr()
node a7 Call C.sdl2.SDL_strcmp
	in str2 "--frames"
node a8 Operator ==
	in b 0
node a9 Branch
node b1 Operator +
	in b 1
node b2 Index
node b3 Call String.CStr()
node b4 Call C.sdl2.SDL_atoi
node b5 Set local:maxFrames
node b6 Call C.sdl2.SDL_SetMainReady
node b7 Call C.sdl2.SDL_Init
node b8 Get C.sdl2.SDL_INIT_VIDEO
node b9 Operator !=
	in b 0
node c1 Branch
node c2 Call C.libc.printf
	in format "SDL_Init failed: %s\n"
node c3 Call C.sdl2.SDL_GetError
node c4 Return
	in value 1
node c5 Get C.sdl2.SDL_WINDOWPOS_CENTERED_MASK
node c6 Cast int32
node c7 MakeCase C.SDL_WindowFlags.SDL_WINDOW_SHOWN
node c8 Cast uint32
node c9 Call C.sdl2.SDL_CreateWindow
	in title "Treadle SDL"
	in w 640
	in h 480
node d1 Set local:window
node d2 Call C.sdl2.SDL_CreateRenderer
	in index -1
	in flags 0
node d3 Get local:window
node d4 Set local:renderer
node d5 While
node d6 Get local:running
node d7 While
	in condition true
node d8 Call C.sdl2.SDL_PollEvent
node d9 Get local:ev
node e1 Operator ==
	in b 0
node e2 Branch
node e3 Break
node e4 Break C.SDL_Event
node e5 MakeCase C.SDL_EventType.SDL_QUIT
node e6 Cast uint32
node e7 Operator ==
node e8 Branch
node e9 Set local:running
	in value false
node f1 Get local:frame
node f2 Operator %
	in b 30
node f3 Operator ==
	in b 0
node f4 Branch
node f5 FlipFlop
node f6 Set local:red
	in value true
node f7 Set local:red
	in value false
node f8 Call C.libc.printf
	in format "frame %lld: red\n"
node f9 Call C.libc.printf
	in format "frame %lld: blue\n"
node g1 Call C.sdl2.SDL_SetRenderDrawColor
	in g 40
	in a 255
node g2 Get local:renderer
node g3 Get local:red
node g4 Select
	in true 200
	in false 30
node g5 Cast uint8
node g6 Select
	in true 30
	in false 200
node g7 Cast uint8
node g8 Call C.sdl2.SDL_RenderClear
node g9 Call C.sdl2.SDL_RenderPresent
node h1 Call C.sdl2.SDL_Delay
	in ms 16
node h2 Set local:frame
	set op +=
	in value 1
node h3 Get local:maxFrames
node h4 Operator >
	in b 0
node h5 Get local:frame
node h6 Operator >=
node h7 Operator &&
node h8 Branch
node h9 Set local:running
	in value false
node i1 Call C.libc.printf
	in format "frames %lld\n"
node i2 Get local:frame
node i3 Call C.sdl2.SDL_DestroyRenderer
node i4 Call C.sdl2.SDL_DestroyWindow
node i5 Call C.sdl2.SDL_Quit
node i6 Return
	in value 0
wire a1.args a2.receiver
wire a2.value a3.a
wire a3.result a4.count
