# treadle 1
type Value enum
	namespace Mini
	doc "A value of the scripting language. A Str refers to a String that someone else owns: the Chunk for texts in the script, the Vm for texts made while running; copying a Value never copies the text."

case Nil
	doc "No value: what a function returns without return, and print."

case Int
	payload value int
	doc "A 64-bit whole number."

case Float
	payload value double
	doc "A double."

case Bool
	payload value bool
	doc "true or false."

case Str
	payload text String
	doc "A text (not owned)."

case Func
	payload index int
	doc "A function of the script, by its index in the Chunk."

function m0001 Append
	static
	doc "Appends the value as print shows it: nil, 42, 2.5, true, the text itself, <fn 3>."
param value Mini.Value
param into String
sheet body
node x00000 Entry
node x00001 Switch
	case Nil
	case Int
	case Float
	case Bool
	case Str
	case Func
node x00002 Call String.Append(StringView)
	in text "nil"
node x00003 Call String.Append(int)
node x00004 Call String.Append(double)
node x00005 Call String.Append(bool)
node x00006 Call String.Append(StringView)
node x00007 Call String.AppendF
	in format "<fn {0}>"
node x00008 Return
wire x00000.then x00001.in
wire x00000.value x00001.value
wire x00001.case:Nil x00002.in
wire x00000.into x00002.receiver
wire x00001.case:Int x00003.in
wire x00000.into x00003.receiver
wire x00001.case:Int.value x00003.value
wire x00001.case:Float x00004.in
wire x00000.into x00004.receiver
wire x00001.case:Float.value x00004.value
wire x00001.case:Bool x00005.in
wire x00000.into x00005.receiver
wire x00001.case:Bool.value x00005.value
wire x00001.case:Str x00006.in
wire x00000.into x00006.receiver
wire x00001.case:Str.text x00006.text
wire x00001.case:Func.index x00007.arg0
wire x00001.case:Func x00007.in
wire x00000.into x00007.receiver
wire x00001.done x00008.in

function m0002 Truthy
	static
	pure
	returns bool
	doc "false for nil, false and 0; true for everything else."
param value Mini.Value
sheet body
node x01000 Entry
node x01001 Switch
	case Nil
	case Bool
	case Int
node x01002 Return
	in value false
node x01003 Return
node x01004 Operator !=
	in b 0
node x01005 Return
node x01006 Return
	in value true
wire x01000.then x01001.in
wire x01000.value x01001.value
wire x01001.case:Nil x01002.in
wire x01001.case:Bool x01003.in
wire x01001.case:Bool.value x01003.value
wire x01001.case:Int.value x01004.a
wire x01001.case:Int x01005.in
wire x01004.result x01005.value
wire x01001.done x01006.in

function m0003 IsNumber
	static
	pure
	returns bool
	doc "True for Int and Float."
param value Mini.Value
sheet body
node x02000 Entry
node x02001 IsCase Mini.Value.Int
node x02002 IsCase Mini.Value.Float
node x02003 Operator ||
node x02004 Return
wire x02000.value x02001.value
wire x02000.value x02002.value
wire x02001.result x02003.a
wire x02002.result x02003.b
wire x02000.then x02004.in
wire x02003.result x02004.value

function m0004 IsText
	static
	pure
	returns bool
	doc "True for Str."
param value Mini.Value
sheet body
node x03000 Entry
node x03001 IsCase Mini.Value.Str
node x03002 Return
wire x03000.value x03001.value
wire x03000.then x03002.in
wire x03001.result x03002.value

function m0005 ToFloat
	static
	pure
	returns double
	doc "An Int or a Float as a double; 0 for the other cases."
param value Mini.Value
sheet body
node x04000 Entry
node x04001 Switch
	case Int
	case Float
node x04002 Cast double
node x04003 Return
node x04004 Return
node x04005 Return
	in value 0.0
wire x04000.then x04001.in
wire x04000.value x04001.value
wire x04001.case:Int.value x04002.value
wire x04001.case:Int x04003.in
wire x04002.result x04003.value
wire x04001.case:Float x04004.in
wire x04001.case:Float.value x04004.value
wire x04001.done x04005.in

function m0006 Equal
	static
	pure
	returns bool
	doc "== of the language: numbers by value (an Int equals the same Float), texts by their bytes, functions by index, nil equals nil, other mixes are not equal."
param a Mini.Value
param b Mini.Value
sheet body
node x05000 Entry
node x05001 Call Mini.Value.IsNumber
node x05002 Call Mini.Value.IsNumber
node x05003 Operator &&
node x05004 Branch
node x05005 Call Mini.Value.ToFloat
node x05006 Call Mini.Value.ToFloat
node x05007 Operator ==
node x05008 Return
node x05009 Switch
	case Nil
	case Bool
	case Str
	case Func
node x0500a IsCase Mini.Value.Nil
node x0500b Return
node x0500c IsCase Mini.Value.Bool
node x0500d Operator ==
node x0500e Operator &&
node x0500f Return
node x0500g IsCase Mini.Value.Str
node x0500h Call String.Equals
node x0500i Operator &&
node x0500j Return
node x0500k IsCase Mini.Value.Func
node x0500l Operator ==
node x0500m Operator &&
node x0500n Return
node x0500o Return
	in value false
wire x05000.a x05001.value
wire x05000.b x05002.value
wire x05001.result x05003.a
wire x05002.result x05003.b
wire x05003.result x05004.condition
wire x05000.then x05004.in
wire x05000.a x05005.value
wire x05000.b x05006.value
wire x05005.result x05007.a
wire x05006.result x05007.b
wire x05004.true x05008.in
wire x05007.result x05008.value
wire x05004.false x05009.in
wire x05000.a x05009.value
wire x05000.b x0500a.value
wire x05009.case:Nil x0500b.in
wire x0500a.result x0500b.value
wire x05000.b x0500c.value
wire x0500c.value x0500d.a
wire x05009.case:Bool.value x0500d.b
wire x0500c.result x0500e.a
wire x0500d.result x0500e.b
wire x05009.case:Bool x0500f.in
wire x0500e.result x0500f.value
wire x05000.b x0500g.value
wire x0500g.text x0500h.other
wire x05009.case:Str.text x0500h.receiver
wire x0500g.result x0500i.a
wire x0500h.result x0500i.b
wire x05009.case:Str x0500j.in
wire x0500i.result x0500j.value
wire x05000.b x0500k.value
wire x0500k.index x0500l.a
wire x05009.case:Func.index x0500l.b
wire x0500k.result x0500m.a
wire x0500l.result x0500m.b
wire x05009.case:Func x0500n.in
wire x0500m.result x0500n.value
wire x05009.done x0500o.in

