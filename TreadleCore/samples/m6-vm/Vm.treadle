# treadle 1
type Vm class
	namespace Mini
	doc "Runs a Chunk on a stack of Values. Calls push a frame (return address, stack base, function) on a Stack; locals live in the value stack above the base. Globals are a Dictionary by name; native functions are delegates in a Dictionary by name (print, len, str). With mTrace on, OnTrace is invoked before each instruction with its index and opcode. Texts made while running (joins, str) are kept in mHeap and deleted with the Vm."

field OnTrace delegate:void(int,int)
	attr Event
	doc "Invoked before each instruction when mTrace is on: (instruction index, opcode as an int)."

field mTrace bool
	doc "Invoke OnTrace for each instruction."

field mChunk Mini.Chunk
	doc "The code being run (not owned)."

field mStack Mini.Value[]
	owner owned
	doc "The value stack."

field mFrames Stack<(int,int,int)>
	owner owned
	doc "Call frames: (return index, caller stack base, function index)."

field mGlobals Dictionary<String,Mini.Value>
	owner owned
	doc "Global variables; the keys are Strings of the chunk."

field mNatives Dictionary<String,delegate:Mini.Value(List<Mini.Value>)>
	owner owned
	doc "Native functions by name; keys and delegates are deleted with the Vm."

field mArgs List<Mini.Value>
	owner owned
	doc "The arguments of the native call being made."

field mHeap List<String>
	owner owned
	doc "Texts made while running, deleted with the Vm."

field mOut String
	doc "Where print writes (not owned)."

field mNativeError StringView
	doc "Set by a native function that fails; the Vm turns it into a runtime error."

field mSteps int
	doc "Instructions run by the last Run."

field mMaxDepth int
	init 10000
	doc "The deepest call nesting allowed."

