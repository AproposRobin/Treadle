# treadle 1
type Compiler class
	namespace Mini
	doc "Compiles a syntax tree into a Chunk. Top-level lets are globals (a Dictionary in the Vm); inside a function, parameters and lets are local slots. Functions are declared at the top level and may be used before their declaration; a name that is a function compiles to its constant, a name of a native function (print, len, str) in call position to CallNative. Jumps are emitted with a placeholder target and patched once the target is known."

field mChunk Mini.Chunk
	doc "Where the code goes (not owned)."

field mNatives Dictionary<String,delegate:Mini.Value(List<Mini.Value>)>
	doc "The native functions of the Vm, by name (not owned)."

field mLocals List<StringView>
	owner owned
	doc "The slot names of the function being compiled."

field mInFunction bool
	doc "True while compiling a function body."

ctor m0001
	doc "A compiler writing into `chunk` that knows the natives of a Vm."
param chunk Mini.Chunk
param natives Dictionary<String,delegate:Mini.Value(List<Mini.Value>)>
sheet body
node x00000 Entry
node x00001 Set this.mChunk
node x00002 Set this.mNatives
node x00003 Construct List<StringView>
node x00004 Set this.mLocals
node x00005 Return
wire x00000.then x00001.in
wire x00000.chunk x00001.value
wire x00001.then x00002.in
wire x00000.natives x00002.value
wire x00002.then x00003.in
wire x00003.then x00004.in
wire x00003.object x00004.value
wire x00004.then x00005.in

