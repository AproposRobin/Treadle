# treadle 1
type Chunk class
	namespace Mini
	doc "A compiled script: the code, the constant pool (the texts of the script, names included, are Strings the chunk owns), and the function table (name, entry, parameter count, local slot count). The chunk must live while a Vm runs it."

field Code List<Mini.Instr>
	owner owned
	doc "The instructions; the script starts at 0."

field Constants List<Mini.Value>
	owner owned
	doc "The constant pool."

field Strings List<String>
	owner owned
	doc "The texts of Str constants (owned; deleted with the chunk)."

field Names Dictionary<String,int>
	owner owned
	doc "Text to constant index, so each name or text is in the pool once (keys are the Strings above)."

field FuncNames List<StringView>
	owner owned
	doc "Function names (views of the script)."

field FuncEntry List<int>
	owner owned
	doc "Where each function starts."

field FuncArity List<int>
	owner owned
	doc "How many parameters each function takes."

field FuncSlots List<int>
	owner owned
	doc "How many local slots each function needs (its parameters first)."

ctor m0001
	doc "An empty chunk."
