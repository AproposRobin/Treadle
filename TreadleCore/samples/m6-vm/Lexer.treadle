node x02007 Get this.mPos
node x02008 Operator +
	in b 1
node x02009 Index
node x0200a Cast int
node x0200b Select
	in false -1
node x0200c Return
wire x02001.value x02002.a
wire x02003.value x02004.receiver
wire x02002.result x02005.a
wire x02004.value x02005.b
wire x02007.value x02008.a
wire x02006.value x02009.collection
wire x02008.result x02009.index
wire x02009.value x0200a.value
wire x02005.result x0200b.condition
wire x0200a.result x0200b.true
wire x02000.then x0200c.in
wire x0200b.result x0200c.value

