# treadle 1
type Lexer class
	namespace Mini
	doc "Turns a script into tokens. The lexer reads a StringView it does not own; the tokens it gives are views of the same text, so the text must live while they are used. White space and comments (# to the end of the line) are skipped; lines are counted for the positions."

field mText StringView
	doc "The script."

field mPos int
	doc "The byte position of the next character."

field mLine int
	init 1
	doc "The line of mPos (1-based)."

field mLineStart int
	doc "The byte position where the current line starts."

ctor m0001
	doc "A lexer at the start of `text`."
param text StringView
sheet body
node x00000 Entry
node x00001 Set this.mText
node x00002 Return
wire x00000.then x00001.in
wire x00000.text x00001.value
wire x00001.then x00002.in

function m0002 Peek
	pure
	access private
	returns int
	doc "The byte at the current position (0-255), or -1 at the end."
sheet body
node x01000 Entry
node x01001 Get this.mPos
node x01002 Get this.mText
node x01003 Get StringView.Length
node x01004 Operator <
node x01005 Get this.mText
node x01006 Get this.mPos
node x01007 Index
node x01008 Cast int
node x01009 Select
	in false -1
node x0100a Return
wire x01002.value x01003.receiver
wire x01001.value x01004.a
wire x01003.value x01004.b
wire x01005.value x01007.collection
wire x01006.value x01007.index
wire x01007.value x01008.value
wire x01004.result x01009.condition
wire x01008.result x01009.true
wire x01000.then x0100a.in
wire x01009.result x0100a.value

