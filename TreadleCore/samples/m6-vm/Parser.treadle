function m0008 Fail
	pure
	access private
	returns Result<Mini.Ast,Mini.ScriptError>
	doc "An Err result at the current token."
param message StringView
sheet body
node x07000 Entry
node x07001 Call this.CurPos
node x07002 Call Mini.ScriptError.At
	in detail ""
node x07003 MakeCase Result<Mini.Ast,Mini.ScriptError>.Err
node x07004 Return
wire x07000.message x07002.message
wire x07001.result x07002.pos
wire x07002.result x07003.error
wire x07000.then x07004.in
wire x07003.value x07004.value

function m0009 Expect
	access private
	returns Result<Mini.Ast,Mini.ScriptError>
	doc "Steps over the symbol `code`, or fails with `message`. The Ok value is the symbol's position as an Int node, which callers ignore: it returns the same Result type as the parse functions so that they can Try it."
param code int
param message StringView
local pos int
sheet body
node x08000 Entry
node x08001 Call this.Is
node x08002 Branch
node x08003 Call this.CurPos
node x08004 Set local:pos
node x08005 Call this.Advance
node x08006 Get local:pos
node x08007 MakeCase Mini.Ast.Int
node x08008 MakeCase Result<Mini.Ast,Mini.ScriptError>.Ok
node x08009 Return
node x0800a Call this.Fail
node x0800b Return
wire x08000.code x08001.code
wire x08001.result x08002.condition
wire x08000.then x08002.in
wire x08002.true x08004.in
wire x08003.result x08004.value
wire x08004.then x08005.in
wire x08006.value x08007.value
wire x08007.value x08008.value
wire x08005.then x08009.in
wire x08008.value x08009.value
wire x08000.message x0800a.message
wire x08002.false x0800b.in
wire x0800a.result x0800b.value

function m0010 ExpectName
	access private
	returns Result<Mini.Ast,Mini.ScriptError>
	doc "Reads a name into mName and mNamePos, or fails with `message`. The Ok value is unused (see Expect)."
param message StringView
sheet body
node x09000 Entry
node x09001 Call this.Cur
node x09002 Get Mini.Token.Kind
node x09003 Switch
	case Name
node x09004 Set this.mName
node x09005 Call this.CurPos
node x09006 Set this.mNamePos
node x09007 Call this.Advance
node x09008 MakeCase Mini.Ast.Bool
	in value true
node x09009 MakeCase Result<Mini.Ast,Mini.ScriptError>.Ok
node x0900a Return
node x0900b Call this.Fail
node x0900c Return
wire x09001.result x09002.receiver
wire x09000.then x09003.in
wire x09002.value x09003.value
wire x09003.case:Name x09004.in
wire x09003.case:Name.text x09004.value
wire x09004.then x09006.in
wire x09005.result x09006.value
wire x09006.then x09007.in
wire x09008.value x09009.value
wire x09007.then x0900a.in
wire x09009.value x0900a.value
wire x09000.message x0900b.message
wire x09003.done x0900c.in
wire x0900b.result x0900c.value

