# treadle 1
type Parser class
	namespace Mini
	doc "Builds the syntax tree from the tokens: statements by recursive descent, expressions by precedence climbing (|| 1, && 2, == != 3, < <= > >= 4, + - 5, * / % 6, all left-associative; unary - and ! bind tighter, calls tightest). Every List it makes is also kept in mMade until the parse ends: on success the tree owns them (mMade is emptied); on an error they are all deleted, so Try can pass an error up from any depth without leaking what was built."

field mTokens List<Mini.Token>
	doc "The tokens (not owned), ending with End."

field mPos int
	doc "The index of the current token."

field mMade List<List<Mini.Ast>>
	owner owned
	doc "Every kids List made during this parse."

field mParams List<List<StringView>>
	owner owned
	doc "Every parameter List made during this parse."

field mName StringView
	doc "The name ExpectName read last."

field mNamePos int
	doc "Where that name is."

ctor m0001
	doc "A parser over `tokens`, which must end with an End token."
param tokens List<Mini.Token>
sheet body
node x00000 Entry
node x00001 Set this.mTokens
node x00002 Construct List<List<Mini.Ast>>
node x00003 Set this.mMade
node x00004 Construct List<List<StringView>>
node x00005 Set this.mParams
node x00006 Return
wire x00000.then x00001.in
wire x00000.tokens x00001.value
wire x00001.then x00002.in
wire x00002.then x00003.in
wire x00002.object x00003.value
wire x00003.then x00004.in
wire x00004.then x00005.in
wire x00004.object x00005.value
wire x00005.then x00006.in

function m0002 Cur
	pure
	access private
	returns Mini.Token
	doc "The current token."
sheet body
node x01000 Entry
node x01001 Get this.mTokens
node x01002 Get this.mPos
node x01003 Index
node x01004 Return
wire x01001.value x01003.collection
wire x01002.value x01003.index
wire x01000.then x01004.in
wire x01003.value x01004.value

function m0003 CurPos
	pure
	access private
	returns int
	doc "Where the current token starts."
sheet body
node x02000 Entry
node x02001 Call this.Cur
node x02002 Get Mini.Token.Pos
node x02003 Return
wire x02001.result x02002.receiver
wire x02000.then x02003.in
wire x02002.value x02003.value

function m0004 Is
	pure
	access private
	returns bool
	doc "True when the current token is the symbol or keyword `code`."
param code int
sheet body
node x03000 Entry
node x03001 Call this.Cur
node x03002 Call Mini.Token.IsSym
node x03003 Return
wire x03000.code x03002.code
wire x03001.result x03002.receiver
wire x03000.then x03003.in
wire x03002.result x03003.value

function m0005 IsEnd
	pure
	access private
	returns bool
	doc "True at the End token."
sheet body
node x04000 Entry
node x04001 Call this.Cur
node x04002 Get Mini.Token.Kind
node x04003 IsCase Mini.TokenKind.End
node x04004 Return
wire x04001.result x04002.receiver
wire x04002.value x04003.value
wire x04000.then x04004.in
wire x04003.result x04004.value

function m0006 Advance
	access private
	doc "Moves to the next token; stays on End."
sheet body
node x05000 Entry
node x05001 Get this.mPos
node x05002 Get this.mTokens
node x05003 Get List<Mini.Token>.Count
node x05004 Operator -
	in b 1
node x05005 Operator <
node x05006 Branch
node x05007 Set this.mPos
	set op +=
	in value 1
node x05008 Return
wire x05002.value x05003.receiver
wire x05003.value x05004.a
wire x05001.value x05005.a
wire x05004.result x05005.b
wire x05005.result x05006.condition
wire x05000.then x05006.in
wire x05006.true x05007.in
wire x05006.false x05008.in
wire x05007.then x05008.in

