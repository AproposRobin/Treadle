# treadle 1
type Program class
	namespace Mini
	static
	doc "A small stack-based bytecode virtual machine for a tiny scripting language: lexer, parser, compiler, VM and disassembler. With no arguments it runs a built-in demo script; with a file name it runs that script; --disasm [file] prints the bytecode; --bench times fib(27) and a 10,000,000-iteration loop; --selftest runs the built-in test scripts and prints selftest ok or the first failure."

field sTraceCount int
	static
	doc "How many times the trace subscriber was called."

field sSteps int
	static
	doc "Instructions the last run executed."

field sCodeSize int
	static
	doc "Instructions the last compile made."

function m0001 CountStep
	static
	doc "The trace subscriber: counts the instructions it is told about."
param index int
param opcode int
sheet body
node x00000 Entry
node x00001 Set this.sTraceCount
	set op +=
	in value 1
node x00002 Return
wire x00000.then x00001.in
wire x00001.then x00002.in

function m0002 Run
	static
	returns int
	doc "Lexes, parses and compiles `source`, then runs it (or, with `disasm`, appends the bytecode listing instead of running). What the script prints goes to `output`, and so does an error, as `error: line L, column C: message`. Gives 0 when it ran, 1 for an error before running, 2 for a runtime error. With `trace`, a subscriber on the Vm's OnTrace event counts the instructions (sTraceCount)."
param source StringView
param output String
param trace bool
param disasm bool
local root Mini.Ast
sheet body
node x01000 Entry
node x01001 Local List<Mini.Token>
node x01002 Local Mini.Lexer
node x01003 Call Mini.Lexer.Tokenize
node x01004 ResultMatch
node x01005 Call String.Append(StringView)
	in text "error: "
node x01006 Call Mini.ScriptError.Describe
node x01007 Call String.Append(char8)
	in value 10
node x01008 Return
	in value 1
node x01009 Local Mini.Parser
node x0100a Call Mini.Parser.ParseProgram
node x0100b ResultMatch
node x0100c Set local:root
node x0100d Call String.Append(StringView)
	in text "error: "
node x0100e Call Mini.ScriptError.Describe
node x0100f Call String.Append(char8)
	in value 10
node x0100g Return
	in value 1
node x0100h Defer
node x0100i Get local:root
node x0100j Call Mini.Ast.Free
node x0100k Local Mini.Chunk
node x0100l Local Mini.Vm
node x0100m Get Mini.Vm.mNatives
node x0100n Local Mini.Compiler
node x0100o Get local:root
node x0100p Call Mini.Compiler.CompileProgram
node x0100q ResultMatch
node x0100r Set this.sCodeSize
node x0100s Call String.Append(StringView)
	in text "error: "
node x0100t Call Mini.ScriptError.Describe
node x0100u Call String.Append(char8)
	in value 10
node x0100v Return
	in value 1
node x0100w Branch
node x0100x Call Mini.Disassembler.Disassemble
node x0100y Return
	in value 0
node x0100z Branch
node x01010 Set this.sTraceCount
	in value 0
node x01011 Bind Mini.Program.CountStep
	set alloc construct
node x01012 Call Mini.Vm.OnTrace.Add
node x01013 Set Mini.Vm.mTrace
	in value true
node x01014 Call Mini.Vm.Run
node x01015 Get Mini.Vm.mSteps
node x01016 Set this.sSteps
node x01017 ResultMatch
node x01018 Call String.Append(StringView)
	in text "error: "
node x01019 Call Mini.ScriptError.Describe
node x0101a Call String.Append(char8)
	in value 10
node x0101b Return
	in value 2
node x0101c Return
	in value 0
