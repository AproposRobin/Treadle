function m0011 Bench
	static
	returns int
	doc "Times fib(27), recursive, and a loop of 10,000,000 iterations in the VM."
sheet body
node x0a000 Entry
node x0a001 Call this.Time
	in name "fib(27)"
	in source "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }\nprint(fib(27));\n"
node x0a002 Call this.Time
	in name "loop 10M"
	in source "fn count(n) {\n  let i = 0;\n  let sum = 0;\n  while i < n { sum = sum + i; i = i + 1; }\n  return sum;\n}\nprint(count(10000000));\n"
node x0a003 Return
	in value 0
wire x0a000.then x0a001.in
wire x0a001.then x0a002.in
wire x0a002.then x0a003.in

