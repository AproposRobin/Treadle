function m0009 SelfTest
	static
	returns int
	doc "Runs the 13 test scripts; prints selftest ok and gives 0, or prints the first failure and gives 1."
sheet body
node x08000 Entry
node x08001 Call this.Check
	in name "arithmetic"
	in source "print(1 + 2 * 3, 10 - 4 - 3, 7 / 2, 7 % 3, -5 + 2, 7.0 / 2.0, 2 * (3 + 4));\n"
	in expected "7 3 3 1 -3 3.5 14\n"
node x08002 Operator !
node x08003 Branch
node x08004 Return
	in value 1
node x08005 Call this.Check
	in name "precedence"
	in source "print(1 + 2 == 3, 2 < 1 || 3 >= 3 && !false, 1 < 2 == true, !(1 == 1), -2 * -3);\n"
	in expected "true true true false 6\n"
node x08006 Operator !
node x08007 Branch
node x08008 Return
	in value 1
node x08009 Call this.Check
	in name "strings"
	in source "let s = \"ab\" + \"cd\";\nprint(s, len(s), str(42) + \"!\", \"n=\" + 5, s == \"abcd\", s != \"ab\");\n"
	in expected "abcd 4 42! n=5 true true\n"
node x0800a Operator !
node x0800b Branch
node x0800c Return
	in value 1
node x0800d Call this.Check
	in name "locals and globals"
	in source "let g = 10;\nfn f(x) { let g = x * 2; return g + 1; }\nprint(f(5), g);\ng = g + 1;\nprint(g);\n"
	in expected "11 10\n11\n"
node x0800e Operator !
node x0800f Branch
node x0800g Return
	in value 1
node x0800h Call this.Check
	in name "if and while"
	in source "let i = 0;\nlet s = 0;\nwhile i < 10 {\n  i = i + 1;\n  if i % 2 == 0 { s = s + i; } else if i == 5 { s = s + 100; } else { s = s - 1; }\n}\nprint(i, s);\n"
	in expected "10 126\n"
node x0800i Operator !
node x0800j Branch
node x0800k Return
	in value 1
node x0800l Call this.Check
	in name "functions and recursion"
	in source "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }\nfn fact(n) { if n <= 1 { return 1; } return n * fact(n - 1); }\nfn nothing() { }\nprint(fib(15), fact(10), nothing());\n"
	in expected "610 3628800 nil\n"
node x0800m Operator !
node x0800n Branch
node x0800o Return
	in value 1
node x0800p Call this.Check
	in name "functions as values"
	in source "fn twice(f, x) { return f(f(x)); }\nfn inc(x) { return x + 1; }\nfn sq(x) { return x * x; }\nlet h = sq;\nprint(twice(inc, 5), twice(sq, 3), h(7), twice);\n"
	in expected "7 81 49 <fn 0>\n"
