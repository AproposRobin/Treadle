function m0003 Demo
	static
	pure
	returns StringView
	doc "The built-in demo script."
sheet body
node x02000 Entry
node x02001 Return
	in value "# The demo script: run with no arguments, or disassembled by --disasm.\nfn fib(n) {\n  if n < 2 { return n; }\n  return fib(n - 1) + fib(n - 2);\n}\nfn apply(f, x) { return f(x); }\nfn square(x) { return x * x; }\nlet i = 0;\nwhile i < 10 {\n  print(\"fib(\" + str(i) + \") =\", fib(i), \"square:\", apply(square, i));\n  i = i + 1;\n}\nprint(\"done after\", i, \"rounds;\", 7 / 2, 7.0 / 2, 7 % 3 == 1 && !false);\n"
wire x02000.then x02001.in

