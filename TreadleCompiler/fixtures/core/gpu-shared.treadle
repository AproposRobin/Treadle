# treadle 1
type GpuSharedMain class
	namespace Cx
	static
	doc "GPU compute (docs/GPU-Compute.md): Kernel.Shared, Kernel.Barrier and the block indices. A block reduction (each of 65,536 threads sums its share, then a tree in shared memory; one partial sum per block) and a tiled 16x16 matrix multiply, each on the GPU, with Kernel.RunCpu (whole blocks on fibers) and against a CPU version (a double loop; a float8 matrix multiply). The results must agree; the timings go to stderr. 1,048,576 floats and 128x128, or 16,777,216 floats and 1024x1024 with an argument (the Release run)."

function g01 BlockSum
	static
	attr Kernel
	doc "partial[block] = the sum of x over the block's threads, each thread summing x[i + j * stride] for j below per."
param x Span<float>
param partial Span<float>
param stride int
param per int
local s float
sheet body
node r1 Entry
node r2 Call Kernel.Index
node r3 Call Kernel.ThreadInBlock
node r4 Call Kernel.BlockIndex
node r5 Call Kernel.Shared
	set type float
	in count 256
node r6 For
	in start 0
node r7 Math
	set expr "i + j * stride"
node r8 Call Span<float>.At
node r9 Set local:s
	set op +=
node s1 Call Span<float>.SetAt
node s2 Get local:s
node s3 For
	in start 0
	in count 8
node s4 Call Kernel.Barrier
node s5 Math
	set expr "t < (128 >> k)"
node s6 Branch
node s7 Math
	set expr "t + (128 >> k)"
node s8 Call Span<float>.At
node s9 Call Span<float>.At
node t1 Math
	set expr "p + q"
node t2 Call Span<float>.SetAt
node t3 Call Kernel.Barrier
node t4 Math
	set expr "t == 0"
node t5 Branch
node t6 Call Span<float>.At
	in index 0
node t7 Call Span<float>.SetAt
node t8 Return
node t9 Return
wire r1.then r5.in
wire r1.per r6.count
wire r5.then r6.in
wire r2.result r7.i
wire r6.index r7.j
wire r1.stride r7.stride
wire r6.body r8.in
wire r7.result r8.index
wire r1.x r8.receiver
wire r8.then r9.in
wire r8.result r9.value
wire r6.done s1.in
wire r3.result s1.index
wire r5.result s1.receiver
wire s2.value s1.value
wire s1.then s3.in
wire s3.body s4.in
wire s3.index s5.k
wire r3.result s5.t
wire s5.result s6.condition
wire s4.then s6.in
wire s3.index s7.k
wire r3.result s7.t
wire s6.true s8.in
wire r3.result s8.index
wire r5.result s8.receiver
wire s8.then s9.in
wire s7.result s9.index
wire r5.result s9.receiver
wire s8.result t1.p
wire s9.result t1.q
wire s9.then t2.in
wire r3.result t2.index
wire r5.result t2.receiver
wire t1.result t2.value
wire s3.done t3.in
wire r3.result t4.t
wire t4.result t5.condition
wire t3.then t5.in
wire t5.true t6.in
wire r5.result t6.receiver
wire t6.then t7.in
wire r4.result t7.index
wire r1.partial t7.receiver
wire t6.result t7.value
wire t7.then t8.in
wire t5.false t9.in

function g02 MatMulTiled
	static
	attr Kernel
	doc "c = a * b for n x n matrices (n a multiple of 16), one 16x16 tile of c per block of 256: the tiles of a and b go through shared memory."
param a Span<float>
param b Span<float>
param c Span<float>
param n int
local acc float
sheet body
node m1 Entry
node m2 Call Kernel.ThreadInBlock
node m3 Call Kernel.BlockIndex
node m4 Math
	set expr "(bi / (n / 16)) * 16 + t / 16"
node m5 Math
	set expr "(bi % (n / 16)) * 16 + t % 16"
node m6 Call Kernel.Shared
	set type float
	in count 256
node m7 Call Kernel.Shared
	set type float
	in count 256
node m8 For
	in start 0
node m9 Math
	set expr "n / 16"
node n1 Math
	set expr "row * n + tt * 16 + t % 16"
node n2 Call Span<float>.At
node n3 Call Span<float>.SetAt
node n4 Math
	set expr "(tt * 16 + t / 16) * n + col"
node n5 Call Span<float>.At
node n6 Call Span<float>.SetAt
node n7 Call Kernel.Barrier
node n8 For
	in start 0
	in count 16
node n9 Math
	set expr "(t / 16) * 16 + kk"
node o1 Call Span<float>.At
node o2 Math
	set expr "kk * 16 + t % 16"
node o3 Call Span<float>.At
node o4 Math
	set expr "p * q"
node o5 Set local:acc
	set op +=
node o6 Call Kernel.Barrier
node o7 Math
	set expr "row * n + col"
node o8 Get local:acc
node o9 Call Span<float>.SetAt
node p1 Return
wire m3.result m4.bi
wire m1.n m4.n
wire m2.result m4.t
wire m3.result m5.bi
wire m1.n m5.n
wire m2.result m5.t
wire m1.then m6.in
wire m6.then m7.in
wire m9.result m8.count
wire m7.then m8.in
wire m1.n m9.n
wire m1.n n1.n
wire m4.result n1.row
wire m2.result n1.t
wire m8.index n1.tt
wire m8.body n2.in
wire n1.result n2.index
wire m1.a n2.receiver
wire n2.then n3.in
wire m2.result n3.index
wire m6.result n3.receiver
wire n2.result n3.value
wire m5.result n4.col
wire m1.n n4.n
wire m2.result n4.t
wire m8.index n4.tt
wire n3.then n5.in
wire n4.result n5.index
wire m1.b n5.receiver
wire n5.then n6.in
wire m2.result n6.index
wire m7.result n6.receiver
wire n5.result n6.value
wire n6.then n7.in
wire n7.then n8.in
wire n8.index n9.kk
wire m2.result n9.t
wire n8.body o1.in
wire n9.result o1.index
wire m6.result o1.receiver
wire n8.index o2.kk
wire m2.result o2.t
wire o1.then o3.in
wire o2.result o3.index
wire m7.result o3.receiver
wire o1.result o4.p
wire o3.result o4.q
wire o3.then o5.in
wire o4.result o5.value
wire n8.done o6.in
wire m5.result o7.col
wire m1.n o7.n
wire m4.result o7.row
wire m8.done o9.in
wire o7.result o9.index
wire m1.c o9.receiver
wire o8.value o9.value
wire o9.then p1.in

function g03 MatMulSimd
	static
	doc "c += a * b for n x n matrices on the CPU, row by row over float8 vectors (n a multiple of 8); the same order of additions as the tiled kernel."
param a Span<float>
param b Span<float>
param c Span<float>
param n int
sheet body
node q1 Entry
node q2 For
	in start 0
node q3 For
	in start 0
node q4 Math
	set expr "i * n + k"
node q5 Call Span<float>.At
node q6 For
	in start 0
node q7 Math
	set expr "n / 8"
node q8 Math
	set expr "i * n + j * 8"
node q9 Math
	set expr "k * n + j * 8"
node u1 Call Core.Vector.Load<float8>
node u2 Call Core.Vector.Load<float8>
node u3 Math
	set expr "cv + float8(av) * bv"
node u4 Call Core.Vector.Store
node u5 Return
wire q1.n q2.count
wire q1.then q2.in
wire q1.n q3.count
wire q2.body q3.in
wire q2.index q4.i
wire q3.index q4.k
wire q1.n q4.n
wire q3.body q5.in
wire q4.result q5.index
wire q1.a q5.receiver
wire q7.result q6.count
wire q5.then q6.in
wire q1.n q7.n
wire q2.index q8.i
wire q6.index q8.j
wire q1.n q8.n
wire q6.index q9.j
wire q3.index q9.k
wire q1.n q9.n
wire q8.result u1.index
wire q1.c u1.span
wire q9.result u2.index
wire q1.b u2.span
wire q5.result u3.av
wire u2.result u3.bv
wire u1.result u3.cv
wire q6.body u4.in
wire q8.result u4.index
wire q1.c u4.span
wire u3.result u4.v
wire q2.done u5.in

function g04 FillX
	static
	doc "x[i] = (i % 1000) / 1000."
param x Span<float>
sheet body
node v1 Entry
node v2 For
	in start 0
node v3 Break Span<float>
node v4 Math
	set expr "i % 1000"
node v5 Cast float
node v6 Call Span<float>.SetAt
node v7 Return
node v8 Math
	set expr "v * 0.001"
wire v3.Length v2.count
wire v1.then v2.in
wire v1.x v3.value
wire v2.index v4.i
wire v4.result v5.value
wire v2.body v6.in
wire v2.index v6.index
wire v1.x v6.receiver
wire v8.result v6.value
wire v2.done v7.in
wire v5.result v8.v

function g05 FillAB
	static
	doc "a[i] = (i % 7) / 4, b[i] = (i % 5) / 2: sums of their products are exact in float."
param a Span<float>
param b Span<float>
sheet body
node w1 Entry
node w2 For
	in start 0
node w3 Break Span<float>
node w4 Math
	set expr "i % 7"
node w5 Math
	set expr "i % 5"
node w6 Cast float
node w7 Cast float
node w8 Call Span<float>.SetAt
node w9 Call Span<float>.SetAt
node x1 Return
node x2 Math
	set expr "v * 0.25"
node x3 Math
	set expr "v * 0.5"
wire w3.Length w2.count
wire w1.then w2.in
wire w1.a w3.value
wire w2.index w4.i
wire w2.index w5.i
wire w4.result w6.value
wire w5.result w7.value
wire w2.body w8.in
wire w2.index w8.index
wire w1.a w8.receiver
wire x2.result w8.value
wire w8.then w9.in
wire w2.index w9.index
wire w1.b w9.receiver
wire x3.result w9.value
wire w2.done x1.in
wire w6.result x2.v
wire w7.result x3.v

function g06 SumD
	static
	returns double
	doc "The sum of the span's elements, in double."
param s Span<float>
local sum double
sheet body
node y1 Entry
node y2 For
	in start 0
node y3 Break Span<float>
node y4 Call Span<float>.At
node y5 Cast double
node y6 Set local:sum
	set op +=
node y7 Get local:sum
node y8 Return
wire y3.Length y2.count
wire y1.then y2.in
wire y1.s y3.value
wire y2.body y4.in
wire y2.index y4.index
wire y1.s y4.receiver
wire y4.result y5.value
wire y4.then y6.in
wire y5.result y6.value
wire y2.done y8.in
wire y7.value y8.value

function g07 Mismatches
	static
	returns int
	doc "How many elements of got differ from want by more than one part in a million."
param want Span<float>
param got Span<float>
local bad int
sheet body
node ma1 Entry
node ma2 For
	in start 0
node ma3 Break Span<float>
node ma4 Call Span<float>.At
node ma5 Call Span<float>.At
node ma6 Math
	set expr "Math.Abs(w - g) > Math.Abs(w) * 0.000001 + 0.000001 ? 1 : 0"
node ma7 Set local:bad
	set op +=
node ma8 Get local:bad
node ma9 Return
wire ma3.Length ma2.count
wire ma1.then ma2.in
wire ma1.want ma3.value
wire ma2.body ma4.in
wire ma2.index ma4.index
wire ma1.want ma4.receiver
wire ma4.then ma5.in
wire ma2.index ma5.index
wire ma1.got ma5.receiver
wire ma5.result ma6.g
wire ma4.result ma6.w
wire ma5.then ma7.in
wire ma6.result ma7.value
wire ma2.done ma9.in
wire ma8.value ma9.value

