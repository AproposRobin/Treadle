	set kernel Cx.GpuSharedMain.BlockSum
	set block 256
	in count 65536
	in stride 65536
node zh5 Call Stopwatch.ElapsedMicroseconds
node zh6 Set local:tSumKern
node zh7 Call GpuSharedMain.SumD
node zh8 Set local:ksum
node zh9 Call Stopwatch.Restart
node zi1 Call GpuSharedMain.MatMulSimd
node zi2 Call Stopwatch.ElapsedMicroseconds
node zi3 Set local:tMmCpu
