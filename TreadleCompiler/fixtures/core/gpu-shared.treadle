node zf8 Set local:bp
node zf9 Get local:bx
node zg1 Get local:bp
node zg2 Call Stopwatch.Restart
node zg3 Call Gpu.Dispatch
	set kernel Cx.GpuSharedMain.BlockSum
	set block 256
	in count 65536
	in stride 65536
node zg4 Math
	set expr "nn / 65536"
node zg5 Set local:onGpu
node zg6 Call Gpu.Sync
node zg7 Call Stopwatch.ElapsedMicroseconds
node zg8 Set local:tSumGpu
node zg9 Call GpuBuffer<float>.Download
node zh1 Call GpuSharedMain.SumD
node zh2 Set local:gsum
node zh3 Call Stopwatch.Restart
