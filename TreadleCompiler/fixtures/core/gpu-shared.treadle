node zj2 Get local:bb
node zj3 Get local:bc
node zj4 Call Stopwatch.Restart
node zj5 Call Gpu.Dispatch
	set kernel Cx.GpuSharedMain.MatMulTiled
	set block 256
node zj6 Call Gpu.Sync
node zj7 Call Stopwatch.ElapsedMicroseconds
node zj8 Set local:tMmGpu
node zj9 Call GpuBuffer<float>.Download
node zk1 Call Stopwatch.Restart
node zk2 Call Kernel.RunCpu
	set kernel Cx.GpuSharedMain.MatMulTiled
	set block 256
node zk3 Call Stopwatch.ElapsedMicroseconds
node zk4 Set local:tMmKern
node zk5 Get local:ref
node zk6 Get local:gsum
node zk7 Get local:ksum
node zk8 Math
	set expr "(Math.Abs(r - g) > Math.Abs(r) * 0.0001 ? 1 : 0) + (Math.Abs(r - k) > Math.Abs(r) * 0.0001 ? 1 : 0)"
node zk9 Call Console.Write
	in text "reduce mismatches "
node zl1 Call Console.WriteLine(int)
node zl2 Call GpuSharedMain.Mismatches
node zl3 Call GpuSharedMain.Mismatches
node zl4 Math
	set expr "g + k"
node zl5 Call Console.Write
	in text "matmul mismatches "
node zl6 Call Console.WriteLine(int)
node zl7 Local String
node zl8 Call String.AppendF
	in format "block reduction of {0} floats: GPU {1} us (ran on the GPU: {2}), Kernel.RunCpu (blocks on fibers) {3} us, CPU loop {4} us; "
node zl9 Call String.AppendF
	in format "tiled matmul {0}x{0}: GPU {1} us, Kernel.RunCpu (blocks on fibers) {2} us, CPU float8 {3} us"
node zm1 Get local:tSumGpu
node zm2 Get local:onGpu
node zm3 Get local:tSumKern
node zm4 Get local:tSumCpu
node zm5 Get local:tMmGpu
node zm6 Get local:tMmKern
node zm7 Get local:tMmCpu
node zm8 Call Console.ErrorLine
node zm9 Delete
