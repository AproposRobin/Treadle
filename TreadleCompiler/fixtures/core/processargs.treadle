# treadle 1
type ProcessArgsMain class
	namespace Cx
	static
	doc "Process.Start with an argument list (no shell, Core-Library.md): this program as its own child gets eight arguments (a space, quotes, backslashes, shell syntax, a variable, an empty one, non-ASCII text) and prints each in brackets: every one arrives exactly as it was given."

function m1 Main
	static
	returns int
