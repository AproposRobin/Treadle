# treadle 1
type ThreadsParallelForMain class
	namespace Cx
	static
	doc "Parallel over 10 million indices, each mixed by Mix (8 rounds of a 64-bit LCG step): the plain loop, Parallel.ForRange (a Local Lambda sums its chunk, one Atomic.Add per chunk), and Parallel.For over 64 blocks (each block's sum in its own array slot); the three sums agree. Parallel.ForEach adds the elements of a span of 1000 ints. The timings and the speedup go to stderr (not compared)."

field sTotal int
	static

field sEach int
	static

function m1 Mix
	static
	returns int
	doc "8 rounds of x = (x * 6364136223846793005 + 1442695040888963407) ^ (x >> 29), then 10 bits of it."
param x int
local v int
sheet body
node xa1 Entry
node xa2 Set local:v
node xa3 For
	in start 0
	in count 8
node xa4 Get local:v
node xa5 Math
	set expr "(v * 6364136223846793005 + 1442695040888963407) ^ (v >> 29)"
node xa6 Set local:v
node xa7 Get local:v
node xa8 Math
	set expr "(v >> 40) & 1023"
node xa9 Return
wire xa1.then xa2.in
wire xa1.x xa2.value
wire xa2.then xa3.in
wire xa4.value xa5.v
wire xa3.body xa6.in
wire xa5.result xa6.value
wire xa7.value xa8.v
wire xa3.done xa9.in
wire xa8.result xa9.value

function m2 SumRange
	static
	returns int
	doc "Mix(i) summed over lo up to (not including) hi."
param lo int
param hi int
local s int
sheet body
node sa1 Entry
node sa2 Operator -
node sa3 For
node sa4 Call ThreadsParallelForMain.Mix
node sa5 Set local:s
	set op +=
node sa6 Get local:s
node sa7 Return
wire sa1.hi sa2.a
wire sa1.lo sa2.b
wire sa2.result sa3.count
wire sa1.then sa3.in
wire sa1.lo sa3.start
wire sa3.body sa4.in
wire sa3.index sa4.x
wire sa4.then sa5.in
wire sa4.result sa5.value
wire sa3.done sa7.in
wire sa6.value sa7.value

function m3 Main
	static
	returns int
local serial int
local blocks int[]
local blockSum int
local items int[]
local tSerial int
local tRange int
local tFor int
sheet body
node a1 Entry
node a2 Local Stopwatch
	set ctor (bool)
	in startNow true
node a3 Call ThreadsParallelForMain.SumRange
	in lo 0
	in hi 10000000
node a4 Set local:serial
node a5 Call Stopwatch.ElapsedMicroseconds
node a6 Set local:tSerial
node a7 Call Stopwatch.Restart
node a8 Lambda
	set type delegate:void(int,int)
	set alloc local
	set inputs lo hi
node a9 Call Parallel.ForRange
	in from 0
	in to 10000000
node b1 Call Stopwatch.ElapsedMicroseconds
node b2 Set local:tRange
node b3 Construct int[]
	in count 64
node b4 Set local:blocks
node b5 Call Stopwatch.Restart
node b6 Lambda
	set type delegate:void(int)
	set alloc local
	set inputs b
node b7 Call Parallel.For
	in from 0
	in to 64
node b8 Call Stopwatch.ElapsedMicroseconds
node b9 Set local:tFor
node c1 Get local:blocks
node c2 ForEach
node c3 Set local:blockSum
	set op +=
node c4 Get local:serial
node c5 Call Console.WriteLine(int)
node c6 Get ThreadsParallelForMain.sTotal
node c7 Call Console.WriteLine(int)
node c8 Get local:blockSum
node c9 Call Console.WriteLine(int)
node d1 Construct int[]
	in count 1000
node d2 Set local:items
node d3 For
	in start 0
	in count 1000
node d4 Get local:items
node d5 Call Arrays.Set
node d6 Get local:items
node d7 Lambda
	set type delegate:void(int)
	set alloc local
	set inputs e
node d8 Call Parallel.ForEach
node d9 Get ThreadsParallelForMain.sEach
node e1 Call Console.WriteLine(int)
node e2 Local String
node e3 Get local:tSerial
node e4 Get local:tRange
node e5 Get local:tFor
node e6 Cast double
node e7 Cast double
node e8 Operator /
node e9 Call String.AppendF
	in format "serial {0} us, ForRange {1} us, For over 64 blocks {2} us, speedup {3:F2} on {4} threads"
node f1 Call Thread.HardwareThreads
node f2 Call Console.Error(StringView)
node f3 Get local:blocks
node f4 Delete
node f5 Get local:items
node f6 Delete
node f7 Return
	in value 0
