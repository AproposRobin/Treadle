function m6 Show
	static
	doc "Writes the elements on one line, each followed by a space."
param items Span<int>
sheet body
node w1 Entry
node w2 ForEach
node w3 Call Console.Write(int)
node w4 Call Console.Write(StringView)
	in text " "
node w5 Call Console.WriteLine(StringView)
	in text ""
node w6 Return
wire w1.items w2.collection
wire w1.then w2.in
wire w2.body w3.in
wire w2.element w3.value
