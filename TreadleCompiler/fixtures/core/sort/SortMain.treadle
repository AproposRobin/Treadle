# treadle 1
type SortMain class
	namespace Cx
	static
	doc "Core sort: List.Sort with a Lambda comparer and List.Sort() by operator < on random, sorted, reverse, all-equal and few-distinct lists of 0, 1, 2, 3, 17, 1,000, 100,000 and 1,000,000 elements (each line: the size, then whether each sort left the list ascending with the same sum); a List of a struct with a destructor sorted by a comparer that reads a field (keys ascending, tags kept, each value destroyed once); Arrays.Sort on an array (by operator <, then descending by a comparer) and Span.Sort on a Slice of a List."

field sDestroyed int
	static

function m1 Main
	static
	returns int
sheet body
node a1 Entry
node b01 Call this.Case
	in n 0
	in a 0
	in b 0
	in c 1
	in e 0
	in d 0
node b02 Call this.Case
	in n 1
	in a 0
	in b 0
