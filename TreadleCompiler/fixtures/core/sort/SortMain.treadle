	in n 1000
	in a 1
	in b 0
	in c 0
	in e 0
	in d 0
node b11 Call this.Case
	in n 1000
	in a 0
	in b 1
	in c 0
	in e 0
	in d 0
node b12 Call this.Case
	in n 1000
