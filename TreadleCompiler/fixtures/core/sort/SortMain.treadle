wire g29.then g30.in
wire g31.value g30.value
wire g30.then g32.in
sheet lambda:g12
node q1 Entry
node q2 Get Keyed.Key
node q3 Get Keyed.Key
node q4 Operator -
node q5 Return
wire q1.x q2.receiver
wire q1.y q3.receiver
wire q2.value q4.a
wire q3.value q4.b
wire q1.then q5.in
wire q4.result q5.value

function m5 ArraysCase
	static
	doc "Arrays.Sort on an int[] (5 3 9 1 7 3) by operator <, then descending with a comparer; then Span.Sort on the middle five elements of a List of 9 down to 0."
sheet body
node r01 Entry
node r02 Construct int
	set count
	in count 6
node r03 Call Arrays.Set
	in index 0
	in value 5
node r04 Call Arrays.Set
	in index 1
	in value 3
node r05 Call Arrays.Set
	in index 2
	in value 9
node r06 Call Arrays.Set
	in index 3
	in value 1
node r07 Call Arrays.Set
	in index 4
	in value 7
node r08 Call Arrays.Set
	in index 5
	in value 3
node r09 Call Arrays.Sort
node r10 Call this.Show
node r11 Lambda
	set type delegate:int(int,int)
	set alloc local
	set inputs x y
node r12 Call Arrays.Sort
node r13 Call this.Show
node r14 Construct List<int>
node r15 For
	in start 0
	in count 10
node r16 Call List<int>.Add
node r17 Math
	set expr "9 - i"
node r18 Call List<int>.Slice
	in start 2
	in length 5
node r19 Call Span<int>.Sort
node r20 Call this.Show
node r21 Call List<int>.Slice
	in start 0
	in length 10
node r22 Delete
node r23 Delete
node r24 Return
