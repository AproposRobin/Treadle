wire a9.then b2.in
wire b1.result b2.value
wire b2.then b3.in
wire b3.then b4.in
wire b3.value b4.mapper
wire a2.result b4.receiver
wire b4.result b5.receiver
wire b4.then b6.in
wire b5.result b6.value
wire b6.then b7.in
wire b3.value b7.mapper
wire a7.result b7.receiver
wire b7.result b8.receiver
wire b7.then b9.in
wire b8.result b9.value
