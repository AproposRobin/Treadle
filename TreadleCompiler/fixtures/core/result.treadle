wire c6.value c9.receiver
wire c8.then d1.in
wire c9.result d1.value
wire d1.then d2.in
sheet lambda:b3
node l1 Entry
node l2 Operator *
	in b 100
node l3 Return
wire l1.x l2.a
wire l1.then l3.in
wire l2.result l3.value

function m2 Half
	static
	returns Result<int,int>
	doc "n / 2 for an even n, the remainder as an error for an odd one."
param n int
sheet body
node h1 Entry
node h2 Operator %
	in b 2
node h3 Operator ==
	in b 0
node h4 Branch
node h5 Operator /
	in b 2
node h6 MakeCase Result<int,int>.Ok
node h7 Return
node h8 MakeCase Result<int,int>.Err
node h9 Return
wire h1.n h2.a
wire h2.result h3.a
wire h3.result h4.condition
wire h1.then h4.in
wire h1.n h5.a
wire h5.result h6.value
wire h4.true h7.in
wire h6.value h7.value
wire h2.result h8.error
wire h4.false h9.in
wire h8.value h9.value
