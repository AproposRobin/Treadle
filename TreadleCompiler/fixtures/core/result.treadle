# treadle 1
type ResultMain class
	namespace Cx
	static
	doc "Core Result and Option helpers: IsOk, IsErr, Unwrap, UnwrapOr, Map with a Lambda; IsSome, IsNone, Unwrap, UnwrapOr."

function m1 Main
	static
	returns int
sheet body
node a1 Entry
node a2 Call this.Half
	in n 10
node a3 Call Result<int,int>.IsOk
node a4 Call Console.WriteLine(bool)
node a5 Call Result<int,int>.Unwrap
node a6 Call Console.WriteLine(int)
node a7 Call this.Half
	in n 7
node a8 Call Result<int,int>.IsErr
node a9 Call Console.WriteLine(bool)
node b1 Call Result<int,int>.UnwrapOr
	in fallback -1
node b2 Call Console.WriteLine(int)
node b3 Lambda
	set type delegate:int(int)
	set alloc local
	set inputs x
node b4 Call Result<int,int>.Map
node b5 Call Result<int,int>.UnwrapOr
	in fallback 0
node b6 Call Console.WriteLine(int)
node b7 Call Result<int,int>.Map
node b8 Call Result<int,int>.IsErr
node b9 Call Console.WriteLine(bool)
node c1 MakeCase Option<int>.Some
	in value 9
node c2 Call Option<int>.IsSome
node c3 Call Console.WriteLine(bool)
node c4 Call Option<int>.Unwrap
node c5 Call Console.WriteLine(int)
node c6 MakeCase Option<int>.None
node c7 Call Option<int>.IsNone
node c8 Call Console.WriteLine(bool)
node c9 Call Option<int>.UnwrapOr
	in fallback 3
node d1 Call Console.WriteLine(int)
node d2 Return
	in value 0
wire a1.then a2.in
wire a2.result a3.receiver
wire a2.then a4.in
wire a3.result a4.value
wire a4.then a5.in
wire a2.result a5.receiver
