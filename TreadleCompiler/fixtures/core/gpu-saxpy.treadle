# treadle 1
type GpuSaxpyMain class
	namespace Cx
	static
	doc "GPU compute spike (docs/GPU-Compute.md): y = a * x + y over 1,000,000 floats three ways: the [Kernel] function Saxpy on the CPU (Kernel.RunCpu, every Debug check), the same kernel on the GPU (Gpu.Upload, Gpu.Dispatch, Gpu.Download; the CPU again when there is no GPU or TREADLE_GPU=cpu), and a float8 loop on the CPU. The three results must agree (1e-6); the GPU line and the timings go to stderr (not compared)."

field sN int
	static
	const
	init 1000000

function g01 Saxpy
	static
	attr Kernel
	doc "y[i] = a * x[i] + y[i] for the dispatch's index i."
param x Span<float>
param y Span<float>
param a float
sheet body
node ka1 Entry
node ka2 Call Kernel.Index
node ka3 Call Span<float>.At
node ka4 Call Span<float>.At
node ka5 Math
	set expr "a * xv + yv"
node ka6 Call Span<float>.SetAt
node ka7 Return
wire ka1.then ka3.in
wire ka2.result ka3.index
wire ka1.x ka3.receiver
wire ka3.then ka4.in
wire ka2.result ka4.index
wire ka1.y ka4.receiver
wire ka1.a ka5.a
wire ka3.result ka5.xv
wire ka4.result ka5.yv
wire ka4.then ka6.in
wire ka2.result ka6.index
wire ka1.y ka6.receiver
wire ka5.result ka6.value
wire ka6.then ka7.in

function g02 SaxpySimd
	static
	doc "The same over float8 vectors on the CPU (n a multiple of 8)."
param x Span<float>
param y Span<float>
param a float
param n int
sheet body
node sa1 Entry
node sa2 For
	in start 0
node sa3 Operator /
	in b 8
node sa4 Operator *
	in b 8
node sa5 Call Core.Vector.Load<float8>
node sa6 Call Core.Vector.Load<float8>
node sa7 Math
	set expr "float8(a) * xv + yv"
node sa8 Call Core.Vector.Store
node sa9 Return
wire sa3.result sa2.count
wire sa1.then sa2.in
wire sa1.n sa3.a
wire sa2.index sa4.a
wire sa4.result sa5.index
wire sa1.x sa5.span
wire sa4.result sa6.index
wire sa1.y sa6.span
wire sa1.a sa7.a
wire sa5.result sa7.xv
wire sa6.result sa7.yv
wire sa2.body sa8.in
wire sa4.result sa8.index
wire sa1.y sa8.span
wire sa7.result sa8.v
wire sa2.done sa9.in

function g03 Main
	static
	returns int
local x float[]
local yCpu float[]
local yGpu float[]
local ySimd float[]
local bx GpuBuffer<float>
local by GpuBuffer<float>
local tCpu int
local tSimd int
local tUp int
local tKernel int
local tDown int
local onGpu bool
local badGpu int
local badSimd int
sheet body
node a1 Entry
node a2 Construct float[]
	in count Cx.GpuSaxpyMain.sN
node a3 Set local:x
node a4 Construct float[]
	in count Cx.GpuSaxpyMain.sN
node a5 Set local:yCpu
node a6 Construct float[]
	in count Cx.GpuSaxpyMain.sN
node a7 Set local:yGpu
node a8 Construct float[]
	in count Cx.GpuSaxpyMain.sN
node a9 Set local:ySimd
node b1 For
	in start 0
	in count Cx.GpuSaxpyMain.sN
node b2 Call Arrays.Set
node b3 Get local:x
node b4 Cast float
node b5 Math
	set expr "i % 1000"
node b6 Call Arrays.Set
node b7 Get local:yCpu
node b8 Cast float
node b9 Math
	set expr "i % 7"
node c1 Call Arrays.Set
node c2 Get local:yGpu
node c3 Call Arrays.Set
node c4 Get local:ySimd
node c5 Local Stopwatch
	set ctor (bool)
	in startNow true
node c6 Call Kernel.RunCpu
	set kernel Cx.GpuSaxpyMain.Saxpy
	in count Cx.GpuSaxpyMain.sN
	in a 2.5
node c7 Get local:x
node c8 Get local:yCpu
node c9 Call Stopwatch.ElapsedMicroseconds
node d1 Set local:tCpu
node d2 Call Stopwatch.Restart
node d3 Call GpuSaxpyMain.SaxpySimd
	in a 2.5
	in n Cx.GpuSaxpyMain.sN
node d4 Get local:x
node d5 Get local:ySimd
node d6 Call Stopwatch.ElapsedMicroseconds
node d7 Set local:tSimd
node d8 Call Gpu.PrintInfo
node d9 Call Stopwatch.Restart
node e1 Call Gpu.Upload
node e2 Get local:x
node e3 Cast Span<float>
node e4 Set local:bx
node e5 Call Gpu.Upload
node e6 Cast Span<float>
node e7 Get local:yGpu
node e8 Set local:by
node e9 Call Stopwatch.ElapsedMicroseconds
node f1 Set local:tUp
node f2 Call Stopwatch.Restart
node f3 Call Gpu.Dispatch
	set kernel Cx.GpuSaxpyMain.Saxpy
	in count Cx.GpuSaxpyMain.sN
	in a 2.5
node f4 Get local:bx
node f5 Get local:by
node f6 Set local:onGpu
node f7 Call Gpu.Sync
node f8 Call Stopwatch.ElapsedMicroseconds
node f9 Set local:tKernel
node g1 Call Stopwatch.Restart
node g2 Call Gpu.Download
node g3 Get local:by
node g4 Cast Span<float>
node g5 Get local:yGpu
node g6 Call Stopwatch.ElapsedMicroseconds
node g7 Set local:tDown
node g8 Get local:bx
node g9 Delete
node h1 Delete
node h2 Get local:by
node h3 For
	in start 0
	in count Cx.GpuSaxpyMain.sN
node h4 Set local:badGpu
	set op +=
node h5 Set local:badSimd
	set op +=
node h6 Index
node h7 Get local:yCpu
node h8 Index
node h9 Get local:yGpu
node i1 Index
node i2 Get local:ySimd
node i3 Math
	set expr "Math.Abs(c - g) > 0.000001 ? 1 : 0"
node i4 Math
	set expr "Math.Abs(c - s) > 0.000001 ? 1 : 0"
node j1 Index
	in index 0
node j2 Call Console.WriteLine(float)
node j3 Index
	in index 999999
node j4 Call Console.WriteLine(float)
node j5 Call Console.Write
	in text "GPU mismatches "
node j6 Get local:badGpu
node j7 Call Console.WriteLine(int)
node j8 Call Console.Write
	in text "SIMD mismatches "
node j9 Get local:badSimd
node k1 Call Console.WriteLine(int)
node k2 Local String
node k3 Call String.AppendF
	in format "saxpy over {0} floats: GPU {1} us kernel, {2} us upload, {3} us download (ran on the GPU: {4}); "
node k4 Get local:tKernel
node k5 Get local:tUp
node k6 Get local:tDown
node k7 Get local:onGpu
node k8 Call String.AppendF
	in format "CPU (Kernel.RunCpu) {0} us; SIMD CPU (float8) {1} us"
node k9 Get local:tCpu
node l1 Get local:tSimd
node l2 Call Console.ErrorLine
node l3 Get local:x
node l4 Delete
node l5 Get local:yCpu
node l6 Delete
node l7 Get local:yGpu
node l8 Delete
node l9 Get local:ySimd
node m1 Delete
node m2 Return
	in value 0
node m3 Get local:yCpu
node m4 Get Cx.GpuSaxpyMain.sN
