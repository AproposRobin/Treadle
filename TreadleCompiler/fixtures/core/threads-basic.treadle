# treadle 1
type ThreadsBasicMain class
	namespace Cx
	doc "Threads: four named Threads each square their number into a slot of an array (a Lambda made with Allocation construct, capturing the array and the number by value); Main joins them in order and prints the results and the names. The body names its own thread (CurrentName) and Current is the Thread object."

function m1 Main
	static
	returns int
local results int[]
local threads List<Thread>
local names List<String>
local lock Mutex
local n int
