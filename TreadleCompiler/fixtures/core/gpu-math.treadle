# treadle 1
type GpuMathMain class
	namespace Cx
	static
	doc "GPU compute (docs/GPU-Compute.md): the transcendental Math functions in kernels (treadle_gpu_math.c on the GPU, the C library on the CPU). Four kernels compute Sin, Cos, Tan, Exp, Log, Pow, Atan2, Asin, Acos and Atan of 262,144 arguments each, in float and in double, once with Gpu.Dispatch and once with Kernel.RunCpu; the results must agree (|cpu - gpu| / max(|cpu|, 1) below 1e-5 in float, 1e-12 in double); the largest difference goes to stderr."

function g01 KernelF1
	static
	attr Kernel
	doc "The float functions of the arguments x = (i % 4001 - 2000) / 100, y = (i % 1000 + 1) / 100, u = (i % 2001 - 1000) / 1000 of index i."
param s Span<float>
param c Span<float>
param tn Span<float>
param e Span<float>
param l Span<float>
param p Span<float>
sheet body
node n0 Entry
node n1 Call Kernel.Index
node n2 Math
	set expr "i % 4001 - 2000"
node n3 Cast float
node n4 Math
	set expr "v * 0.01"
node n5 Math
	set expr "i % 1000 + 1"
node n6 Cast float
node n7 Math
	set expr "v * 0.01"
node n8 Math
	set expr "i % 2001 - 1000"
node n9 Cast float
node na Math
	set expr "v * 0.001"
node nb Math
	set expr "Math.Sin(x)"
node nc Call Span<float>.SetAt
node nd Math
	set expr "Math.Cos(x)"
node ne Call Span<float>.SetAt
node nf Math
	set expr "Math.Tan(x)"
node ng Call Span<float>.SetAt
node nh Math
	set expr "Math.Exp(x * 0.5)"
node ni Call Span<float>.SetAt
node nj Math
	set expr "Math.Log(y)"
node nk Call Span<float>.SetAt
node nl Math
	set expr "Math.Pow(y, x * 0.25)"
node nm Call Span<float>.SetAt
node nn Return
wire n1.result n2.i
wire n2.result n3.value
wire n3.result n4.v
wire n1.result n5.i
wire n5.result n6.value
wire n6.result n7.v
wire n1.result n8.i
wire n8.result n9.value
wire n9.result na.v
wire n4.result nb.x
wire n0.then nc.in
wire n1.result nc.index
wire n0.s nc.receiver
wire nb.result nc.value
wire n4.result nd.x
wire nc.then ne.in
wire n1.result ne.index
wire n0.c ne.receiver
wire nd.result ne.value
wire n4.result nf.x
wire ne.then ng.in
wire n1.result ng.index
wire n0.tn ng.receiver
wire nf.result ng.value
wire n4.result nh.x
wire ng.then ni.in
wire n1.result ni.index
wire n0.e ni.receiver
wire nh.result ni.value
wire n7.result nj.y
wire ni.then nk.in
wire n1.result nk.index
wire n0.l nk.receiver
wire nj.result nk.value
wire n4.result nl.x
wire n7.result nl.y
wire nk.then nm.in
wire n1.result nm.index
wire n0.p nm.receiver
wire nl.result nm.value
wire nm.then nn.in

