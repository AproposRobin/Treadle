function g05 WorstF
	static
	returns double
	doc "The largest |w - g| / max(|w|, 1) over the elements."
param want Span<float>
param got Span<float>
local worst double
sheet body
node n2g Entry
node n2h For
	in start 0
node n2i Break Span<float>
node n2j Call Span<float>.At
node n2k Call Span<float>.At
node n2l Cast double
node n2m Cast double
node n2n Get local:worst
node n2o Math
	set expr "Math.Max(o, Math.Abs(w - g) / Math.Max(Math.Abs(w), 1.0))"
node n2p Set local:worst
node n2q Return
wire n2i.Length n2h.count
wire n2g.then n2h.in
wire n2g.want n2i.value
wire n2h.body n2j.in
wire n2h.index n2j.index
wire n2g.want n2j.receiver
wire n2j.then n2k.in
wire n2h.index n2k.index
wire n2g.got n2k.receiver
wire n2j.result n2l.value
wire n2k.result n2m.value
wire n2m.result n2o.g
wire n2n.value n2o.o
wire n2l.result n2o.w
wire n2k.then n2p.in
wire n2o.result n2p.value
wire n2h.done n2q.in
wire n2n.value n2q.value

