function g011 Main
	static
	returns int
sheet body
node naa Entry
node nab Call Gpu.PrintInfo
node nac Call GpuMathMain.RunF1
	in n 262144
node nad Call GpuMathMain.RunF2
	in n 262144
node nae Call GpuMathMain.RunD1
	in n 262144
node naf Call GpuMathMain.RunD2
	in n 262144
node nag Math
	set expr "Math.Max(a, b) > 0.00001 ? 1 : 0"
node nah Call Console.Write
	in text "float mismatches "
node nai Call Console.WriteLine(int)
node naj Math
	set expr "Math.Max(a, b) > 0.000000000001 ? 1 : 0"
node nak Call Console.Write
	in text "double mismatches "
node nal Call Console.WriteLine(int)
node nam Local String
node nan Call String.AppendF
	in format "GPU math, worst |cpu - gpu| / max(|cpu|, 1): float {0} (Sin Cos Tan Exp Log Pow), {1} (Atan2 Asin Acos Atan); double {2}, {3}"
node nao Call Console.ErrorLine
node nap Return
	in value 0
wire naa.then nab.in
wire nab.then nac.in
wire nac.then nad.in
wire nad.then nae.in
wire nae.then naf.in
wire nac.result nag.a
wire nad.result nag.b
wire naf.then nah.in
wire nah.then nai.in
wire nag.result nai.value
wire nae.result naj.a
wire naf.result naj.b
wire nai.then nak.in
wire nak.then nal.in
wire naj.result nal.value
wire nal.then nam.in
wire nac.result nan.arg0
wire nad.result nan.arg1
wire nae.result nan.arg2
wire naf.result nan.arg3
wire nam.then nan.in
wire nam.object nan.receiver
wire nan.then nao.in
wire nam.object nao.text
wire nao.then nap.in
