function m2 ShowInt
	static
	doc "Parses the text with Int.Parse and prints [text] -> the value or the error."
param text StringView
sheet body
node b01 Entry
node b02 Call Console.Write(StringView)
	in text "["
node b03 Call Console.Write(StringView)
node b04 Call Console.Write(StringView)
	in text "] -> "
node b05 Call Int.Parse
node b06 ResultMatch
node b07 Call Console.WriteLine(int)
node b08 Switch
	case NoValue
	case Overflow
	case InvalidChar
node b09 Call Console.WriteLine(StringView)
	in text "NoValue"
node b10 Call Console.WriteLine(StringView)
	in text "Overflow"
node b11 Call Console.Write(StringView)
	in text "InvalidChar at "
node b12 Call Console.WriteLine(int)
wire b01.then b02.in
wire b02.then b03.in
wire b01.text b03.text
wire b03.then b04.in
wire b04.then b05.in
wire b01.text b05.text
wire b05.then b06.in
wire b05.result b06.result
wire b06.ok b07.in
wire b06.value b07.value
wire b06.err b08.in
wire b06.error b08.value
wire b08.case:NoValue b09.in
wire b08.case:Overflow b10.in
wire b08.case:InvalidChar b11.in
wire b11.then b12.in
wire b08.case:InvalidChar.position b12.value

