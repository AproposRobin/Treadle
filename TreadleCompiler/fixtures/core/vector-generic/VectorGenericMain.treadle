node d6 Call Console.WriteLine(StringView)
node e1 Operator <
	in b 2.5f
node e2 Call String.Clear
node e3 Call String.AppendF
	in format "m = {0}, v = {1}"
node e4 Call Console.WriteLine(StringView)
node e5 Return
