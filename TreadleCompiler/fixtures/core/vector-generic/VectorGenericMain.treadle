# treadle 1
type VectorGenericMain class
	namespace Cx
	static
	doc "Generic functions over vector types (`T : vector`, `T : vector float`) called with float4 and int32x4, and the text of vectors: String.Append of a vector (VectorFormat), with and without the signature in the Call, and AppendF with a lane mask and a vector as arguments."

function m000 Main
	static
	returns int
sheet body
node a1 Entry
node a2 Local String
	set ctor ()
node a3 Make float4
	in x 1
	in y 2
	in z 3
	in w 4
node a4 Call VecOps<float4>.Scaled
	in k 2.0f
node a5 Call String.Append
node a6 Call Console.WriteLine(StringView)
