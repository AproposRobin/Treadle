# treadle 1
type NumFormatMain class
	namespace Cx
	static
	doc "Core number formats: AppendF placeholders {index,width:spec} (right and left alignment, F, E, G, N, D, X, B), five and six arguments, braces and broken placeholders as text, String.AppendNumber, Int / Double / Float.ToString."

function m1 Main
	static
	returns int
