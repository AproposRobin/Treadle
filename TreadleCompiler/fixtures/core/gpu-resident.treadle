# treadle 1
type GpuResidentMain class
	namespace Cx
	static
	doc "GPU compute (docs/GPU-Compute.md): device-resident data. 100 saxpy dispatches (y = 0.5 * x + y) over buffers that stay on the GPU, with one download; the same 100 steps with Kernel.RunCpu and with a float8 loop; then again on a GpuStream (async upload from a PinnedBuffer, 100 DispatchAsync, async download into it). Construct GpuBuffer with a count and GpuBuffer.Upload (a buffer refilled from pinned memory) make y. The four results must agree; the timings go to stderr. 262,144 floats, 16,777,216 with an argument (the Release run)."

function g01 Saxpy
	static
	attr Kernel
	doc "y[i] = a * x[i] + y[i] for the dispatch's index i."
param x Span<float>
param y Span<float>
param a float
sheet body
node ka1 Entry
node ka2 Call Kernel.Index
node ka3 Call Span<float>.At
node ka4 Call Span<float>.At
node ka5 Math
	set expr "a * xv + yv"
node ka6 Call Span<float>.SetAt
node ka7 Return
wire ka1.then ka3.in
wire ka2.result ka3.index
wire ka1.x ka3.receiver
wire ka3.then ka4.in
wire ka2.result ka4.index
wire ka1.y ka4.receiver
wire ka1.a ka5.a
wire ka3.result ka5.xv
wire ka4.result ka5.yv
wire ka4.then ka6.in
wire ka2.result ka6.index
wire ka1.y ka6.receiver
wire ka5.result ka6.value
wire ka6.then ka7.in

function g02 SaxpySimd
	static
	doc "The same over float8 vectors on the CPU (n a multiple of 8)."
param x Span<float>
param y Span<float>
param a float
param n int
sheet body
node sa1 Entry
node sa2 For
	in start 0
node sa3 Operator /
	in b 8
node sa4 Operator *
	in b 8
node sa5 Call Core.Vector.Load<float8>
node sa6 Call Core.Vector.Load<float8>
node sa7 Math
	set expr "float8(a) * xv + yv"
node sa8 Call Core.Vector.Store
node sa9 Return
wire sa3.result sa2.count
wire sa1.then sa2.in
wire sa1.n sa3.a
wire sa2.index sa4.a
wire sa4.result sa5.index
wire sa1.x sa5.span
wire sa4.result sa6.index
wire sa1.y sa6.span
wire sa1.a sa7.a
wire sa5.result sa7.xv
wire sa6.result sa7.yv
wire sa2.body sa8.in
wire sa4.result sa8.index
wire sa1.y sa8.span
wire sa7.result sa8.v
wire sa2.done sa9.in

function g03 Fill
	static
	doc "x[i] = i % 1000 and y[i] = i % 7 for every y."
param x Span<float>
param y1 Span<float>
param y2 Span<float>
param y3 Span<float>
sheet body
node fa1 Entry
node fa2 For
	in start 0
node fa3 Break Span<float>
node fa4 Math
	set expr "i % 1000"
node fa5 Math
	set expr "i % 7"
node fa6 Cast float
node fa7 Cast float
node fa8 Call Span<float>.SetAt
node fa9 Call Span<float>.SetAt
node fb1 Call Span<float>.SetAt
node fb2 Call Span<float>.SetAt
node fb3 Return
wire fa3.Length fa2.count
wire fa1.then fa2.in
wire fa1.x fa3.value
wire fa2.index fa4.i
wire fa2.index fa5.i
wire fa4.result fa6.value
wire fa5.result fa7.value
wire fa2.body fa8.in
wire fa2.index fa8.index
wire fa1.x fa8.receiver
wire fa6.result fa8.value
wire fa8.then fa9.in
wire fa2.index fa9.index
wire fa1.y1 fa9.receiver
wire fa7.result fa9.value
wire fa9.then fb1.in
wire fa2.index fb1.index
wire fa1.y2 fb1.receiver
wire fa7.result fb1.value
wire fb1.then fb2.in
wire fa2.index fb2.index
wire fa1.y3 fb2.receiver
wire fa7.result fb2.value
wire fa2.done fb3.in

function g04 Mismatches
	static
	returns int
	doc "How many elements of got differ from want by more than one part in a million."
param want Span<float>
param got Span<float>
local bad int
sheet body
node ma1 Entry
node ma2 For
	in start 0
node ma3 Break Span<float>
node ma4 Call Span<float>.At
node ma5 Call Span<float>.At
node ma6 Math
	set expr "Math.Abs(w - g) > Math.Abs(w) * 0.000001 + 0.000001 ? 1 : 0"
node ma7 Set local:bad
	set op +=
node ma8 Get local:bad
node ma9 Return
wire ma3.Length ma2.count
wire ma1.then ma2.in
wire ma1.want ma3.value
wire ma2.body ma4.in
wire ma2.index ma4.index
wire ma1.want ma4.receiver
wire ma4.then ma5.in
wire ma2.index ma5.index
wire ma1.got ma5.receiver
wire ma5.result ma6.g
wire ma4.result ma6.w
wire ma5.then ma7.in
wire ma6.result ma7.value
wire ma2.done ma9.in
wire ma8.value ma9.value

function g05 Main
	static
	returns int
local n int
local x float[]
local yCpu float[]
local ySimd float[]
local yGpu float[]
local pin PinnedBuffer<float>
local bx GpuBuffer<float>
local by GpuBuffer<float>
local stream GpuStream
local tCpu int
local tSimd int
local tUp int
local tGpu int
local tDown int
local tStream int
local onGpu bool
sheet body
node a1 Entry
node a2 Call Environment.ArgCount
node a3 Math
	set expr "c > 0 ? 16777216 : 262144"
node a4 Set local:n
node a5 Get local:n
node a6 Construct float[]
node a7 Set local:x
node a8 Construct float[]
node a9 Set local:yCpu
node b1 Construct float[]
node b2 Set local:ySimd
node b3 Construct float[]
node b4 Set local:yGpu
node b5 Construct PinnedBuffer<float>
node b6 Set local:pin
node b7 Get local:x
node b8 Cast Span<float>
node b9 Get local:yCpu
node c1 Cast Span<float>
node c2 Get local:ySimd
node c3 Cast Span<float>
node c4 Get local:yGpu
node c5 Cast Span<float>
node c6 Get local:pin
node c7 Call PinnedBuffer<float>.AsSpan
node c8 Call GpuResidentMain.Fill
node c9 Local Stopwatch
	set ctor (bool)
	in startNow true
node d1 For
	in start 0
	in count 100
node d2 Call Kernel.RunCpu
	set kernel Cx.GpuResidentMain.Saxpy
	in a 0.5
node d3 Call Stopwatch.ElapsedMicroseconds
node d4 Set local:tCpu
node d5 Call Stopwatch.Restart
node d6 For
	in start 0
	in count 100
node d7 Call GpuResidentMain.SaxpySimd
	in a 0.5
node d8 Call Stopwatch.ElapsedMicroseconds
node d9 Set local:tSimd
node e1 Call Gpu.PrintInfo
node e2 Call Stopwatch.Restart
node e3 Call Gpu.Upload
node e4 Set local:bx
node e5 Construct GpuBuffer<float>
	set ctor (int)
node e6 Set local:by
node e7 Get local:by
node e8 Call GpuBuffer<float>.Upload
node e9 Call Gpu.Sync
node f1 Call Stopwatch.ElapsedMicroseconds
node f2 Set local:tUp
node f3 Call Stopwatch.Restart
node f4 For
	in start 0
	in count 100
node f5 Get local:bx
node f6 Call Gpu.Dispatch
	set kernel Cx.GpuResidentMain.Saxpy
	in a 0.5
node f7 Set local:onGpu
node f8 Call Gpu.Sync
node f9 Call Stopwatch.ElapsedMicroseconds
node g1 Set local:tGpu
node g2 Call Stopwatch.Restart
node g3 Call GpuBuffer<float>.Download
node g4 Call Stopwatch.ElapsedMicroseconds
node g5 Set local:tDown
node g6 Call Stopwatch.Restart
node g7 Construct GpuStream
node g8 Set local:stream
node g9 Get local:stream
node h1 Call GpuBuffer<float>.UploadAsync
node h2 For
	in start 0
	in count 100
node h3 Call Gpu.DispatchAsync
	set kernel Cx.GpuResidentMain.Saxpy
	in a 0.5
node h4 Call GpuBuffer<float>.DownloadAsync
node h5 Call GpuStream.Sync
node h6 Call Stopwatch.ElapsedMicroseconds
node h7 Set local:tStream
node h8 Call GpuResidentMain.Mismatches
node h9 Call Console.Write
	in text "GPU mismatches "
node i1 Call Console.WriteLine(int)
node i2 Call GpuResidentMain.Mismatches
node i3 Call Console.Write
	in text "SIMD mismatches "
node i4 Call Console.WriteLine(int)
node i5 Call GpuResidentMain.Mismatches
node i6 Call Console.Write
	in text "stream mismatches "
node i7 Call Console.WriteLine(int)
node i8 Local String
node i9 Call String.AppendF
	in format "resident saxpy x100 over {0} floats: GPU {1} us (ran on the GPU: {2}; upload {3} us, one download {4} us); "
node j1 Get local:tGpu
node j2 Get local:onGpu
node j3 Get local:tUp
node j4 Get local:tDown
node j5 Call String.AppendF
	in format "stream (async upload, 100 dispatches, async download) {0} us; CPU (Kernel.RunCpu) {1} us; SIMD CPU (float8) {2} us"
node j6 Get local:tStream
node j7 Get local:tCpu
node j8 Get local:tSimd
node j9 Call Console.ErrorLine
node k1 Delete
node k2 Delete
node k3 Delete
node k4 Get local:x
node k5 Delete
node k6 Get local:yCpu
node k7 Delete
node k8 Get local:ySimd
node k9 Delete
node l1 Get local:yGpu
node l2 Delete
node l3 Return
	in value 0
node l4 Delete
