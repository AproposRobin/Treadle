# treadle 1
type TextMain class
	namespace Cx
	static
	doc "Core String.AppendF with int, float (a 1.25f literal), double, bool and char8 arguments; String Trim, Replace, ToUpper, ToLower, Join; Path GetFileName, GetDirectory, GetExtension (both separators), Combine, ChangeExtension; Console.ErrorLine."

function m1 Main
	static
	returns int
sheet body
node a1 Entry
node a2 Local String
node a3 Call String.AppendF
	in format "n={0} f={1} d={2} b={3}"
	in arg0 -7
	in arg1 1.25f
	in arg2 0.1
	in arg3 true
node a4 Call Console.WriteLine(String)
node a5 Call String.Clear
node a6 Call String.AppendF
	in format "{0}:{1}"
	in arg0 'k'
	in arg1 "v"
node a7 Call Console.WriteLine(String)
node b1 Local String
	set ctor (StringView)
	in text "  the cat sat on the mat  "
node b2 Call String.Trim
node b3 Call String.Replace
	in from "at"
	in to "og"
node b4 Call String.ToUpper
node b5 Call Console.WriteLine(String)
node b6 Call String.ToLower
node b7 Call String.Replace
	in from "og"
	in to ""
node b8 Call Console.WriteLine(String)
node c1 Local List<String>
node c2 Construct String
	set ctor (StringView)
	in text "a"
node c3 Call List<String>.Add
node c4 Construct String
	set ctor (StringView)
	in text "b"
node c5 Call List<String>.Add
node c6 Call String.Join
	in separator " + "
node c7 Call Console.WriteLine(String)
node c8 Delete
node c9 Call List<String>.DeleteAll
node d1 Call Path.GetFileName
	in path "dir/sub\\file.tar.gz"
node d2 Call Path.GetDirectory
	in path "dir/sub\\file.tar.gz"
node d3 Call Path.GetExtension
	in path "dir/sub\\file.tar.gz"
node d4 Local String
node d5 Call String.AppendF
	in format "{0}|{1}|{2}"
node d6 Call Console.WriteLine(String)
node d7 Local String
node d8 Call Path.Combine
	in a "base"
	in b "name.txt"
node d9 Local String
node e1 Call Path.ChangeExtension
	in extension "md"
node e2 Local String
node e3 Call Path.Combine
	in a "base/"
	in b "x"
node e4 Local String
node e5 Call String.AppendF
	in format "{0} {1} {2}"
node e6 Call Console.WriteLine(String)
node f1 Call Console.ErrorLine
	in text "to stderr"
node f2 Return
	in value 0
