# treadle 1
type MathMain class
	namespace Cx
	static
	doc "Core Math: Min, Max, Clamp on ints and doubles, Abs, Sqrt, Pow, Floor, Ceil, Round, Truncate, Sin, Cos, Exp, Log, PI and E; the float overloads (Abs, Sqrt, Floor, Sign, Pow, Clamp) and an int to Sqrt (the double overload)."

function m1 Main
	static
	returns int
sheet body
node a1 Entry
node a2 Call Math.Min
	in a 7
	in b -3
node a3 Call Console.WriteLine(int)
node a4 Call Math.Max
	in a 2.5
	in b 1.5
node a5 Call Console.WriteLine(double)
node a6 Call Math.Clamp
