# treadle 1
type Node class
	namespace Mem
	doc "Says when it is made and when it is freed."

field mId int

ctor c1
param id int
sheet body
node a1 Entry
node a2 Set this.mId
node a3 Call C.libc.puts
	in s "made"
node a4 Return
wire a1.then a2.in
wire a1.id a2.value
wire a2.then a3.in
wire a3.then a4.in

dtor d1
sheet body
node b1 Entry
node b2 Call C.libc.puts
	in s "freed"
node b3 Return
wire b1.then b2.in
wire b2.then b3.in
