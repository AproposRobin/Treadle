# tir 1
program m2-switchmerge console
entry Fx.SwitchMergeMain.Main()

unit Fx.SwitchMergeMain "SwitchMergeMain.treadle"

type Fx.SwitchMergeMain class

func Fx.SwitchMergeMain.Main() int static sheet "m1" display "Fx.SwitchMergeMain.Main"
	node a1 Entry
	node a2 Call M2.SwitchMerge.Run
	node a3 Return
	block b0
		br b1
	block b1
		call void M2.SwitchMerge.Run() @a2
		br b2
	block b2
		%_0 = const int 0 @a3.value
		region.exit r0 @a3
		ret %_0 @a3

unit M2.SwitchMerge "SwitchMerge.treadle"

type M2.SwitchMerge class

func M2.SwitchMerge.Show(int) void static sheet "m0001" display "M2.SwitchMerge.Show"
	param x int
	region r1
	region r2
	region r3
	region r4
	region r5
	slot s0 int outtemp "a2.value" pin node a2.value
	node a1 Entry
	node a2 Switch
	node a3 Call Console.WriteLine(StringView)
	node a4 Call Console.WriteLine(StringView)
	node a5 Call Console.WriteLine(StringView)
	node a6 Return
	block b0
		br b1
	block b1
		store.slot s0 %x @a2.value
		switch %x b5 1 b2 2 b3 3 b4 @a2
	block b2
		region.enter r4 @a2.case:1
		region.exit r4 @a2
		region.enter r5 @a2.case:1
		br b6
	block b3
		region.enter r3 @a2.case:2
		region.exit r3 @a2
		region.enter r5 @a2.case:2
		br b6
	block b4
		region.enter r2 @a2.case:3
		region.exit r2 @a2
		region.enter r5 @a2.case:3
		br b6
	block b5
		region.enter r1 @a2.default
		br b7
	block b6
		%_0 = const StringView "merged" @a3.text
		intrinsic void console.writeline %_0 @a3
		region.exit r5 @a3
		br b8
	block b7
		%_1 = const StringView "single" @a4.text
		intrinsic void console.writeline %_1 @a4
		region.exit r1 @a4
		br b8
	block b8
		%_2 = const StringView "done" @a5.text
		intrinsic void console.writeline %_2 @a5
		br b9
	block b9
		region.exit r0 @a6
		ret @a6

func M2.SwitchMerge.Run() void static sheet "m0002" display "M2.SwitchMerge.Run"
	node b1 Entry
	node b2 Call M2.SwitchMerge.Show
	node b3 Call M2.SwitchMerge.Show
	node b4 Call M2.SwitchMerge.Show
	node b5 Return
	block b0
		br b1
	block b1
		%_0 = const int 1 @b2.x
		call void M2.SwitchMerge.Show(int) %_0 @b2
		br b2
	block b2
		%_1 = const int 3 @b3.x
		call void M2.SwitchMerge.Show(int) %_1 @b3
		br b3
	block b3
		%_2 = const int 9 @b4.x
		call void M2.SwitchMerge.Show(int) %_2 @b4
		br b4
	block b4
		region.exit r0 @b5
		ret @b5
