function m0020 Sign
	static
	pure
	returns int
	doc "-1 for a negative number, 0 for zero (and NaN), 1 for a positive one."
param x float
sheet body
node f1 Entry
node f2 Operator >
	in b 0.0f
node f3 Operator <
	in b 0.0f
node f4 Select
	in true -1
	in false 0
node f5 Select
	in true 1
node f6 Return
wire f1.x f2.a
wire f1.x f3.a
wire f3.result f4.condition
wire f2.result f5.condition
wire f4.result f5.false
wire f1.then f6.in
wire f5.result f6.value

function m0021 IsNaN
	static
	pure
	returns bool
	doc "True when the number is NaN (not a number: 0.0f / 0.0f, the square root of a negative number)."
param x float
sheet body
node g1 Entry
node g2 Operator !=
node g3 Return
wire g1.x g2.a
wire g1.x g2.b
wire g1.then g3.in
wire g2.result g3.value
